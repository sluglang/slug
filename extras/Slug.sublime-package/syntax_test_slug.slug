// SYNTAX TEST "Slug.sublime-syntax"

@export
//^^^^^^ entity.name.tag.slug
var x = 1
//^^^ storage.type.slug
//    ^ variable.other.slug
//        ^ constant.numeric.integer.slug

@tag(1, "ok")
//^^^ entity.name.tag.slug

val hex = 0x_1a2b
//^^^ storage.type.slug
//         ^^^^^^ constant.numeric.hex.slug
val bytes = 0x"414243"
//         ^^^^^^^^^^ constant.numeric.byte-array.hex.slug
val num = 10_000.5e-2
//        ^^^^^^^^^^^ constant.numeric.float.slug

var s = "hi {{name}}"
//      ^^^^^^^^^^^^^^ string.quoted.double.slug
//         ^^ punctuation.section.braces.begin.slug
//           ^^^^ variable.other.slug
//               ^^ punctuation.section.braces.end.slug

var m = """multi {{x}} line"""
//      ^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double.multi.slug
//              ^^ punctuation.section.braces.begin.slug
//                ^ variable.other.slug
//                 ^^ punctuation.section.braces.end.slug

var raw = 'raw {{not_interp}}'
//        ^^^^^^^^^^^^^^^^^^^^ string.quoted.single.raw.slug

var esc = "a\\n\"b\"\{c\123"
//        ^^^^^^^^^^^^^^^^^^^^^ string.quoted.double.slug

struct { @str name = "x" }
//^^^^^^ keyword.control.slug

val annot = fn(@sym s, @chan c) { s }
//             ^^^^ storage.type.annotation.slug
//                     ^^^^^ storage.type.annotation.slug

var answer:num = 42
//^^^ storage.type.slug
//          ^ punctuation.separator.type.annotation.slug
//           ^^^ storage.type.annotation.slug

val pair:[str, str] = ["a", "b"]
//        ^ punctuation.separator.type.annotation.slug
//         ^ punctuation.section.brackets.begin.slug
//          ^^^ storage.type.annotation.slug
//               ^ punctuation.separator.comma.slug
//                 ^^^ storage.type.annotation.slug
//                   ^ punctuation.section.brackets.end.slug

val build = fn(input:list<str|nil>):chan<any|nil> { input }
//             ^ punctuation.separator.parameter.slug
//              ^^^^ variable.parameter.slug
//                    ^^^^ storage.type.annotation.slug
//                        ^ punctuation.definition.type.generic.begin.slug
//                         ^^^ storage.type.annotation.slug
//                            ^ keyword.operator.logical.slug
//                             ^^^ storage.type.annotation.slug
//                                 ^ punctuation.definition.type.generic.end.slug
//                                  ^ punctuation.separator.return-type.slug
//                                   ^^^ storage.type.annotation.slug
//                                       ^ punctuation.definition.type.generic.begin.slug
//                                        ^^^ storage.type.annotation.slug
//                                           ^ keyword.operator.logical.slug
//                                            ^^^ storage.type.annotation.slug
//                                                ^ punctuation.definition.type.generic.end.slug

val identity = fn<T>(x:T):T { x }
//              ^^ keyword.control.slug
//                ^ punctuation.definition.type.generic.begin.slug
//                 ^ entity.name.type.parameter.slug
//                  ^ punctuation.definition.type.generic.end.slug
//                    ^ variable.parameter.slug
//                      ^ support.type.slug
//                       ^ punctuation.separator.parameter.slug
//                         ^ punctuation.separator.return-type.slug
//                          ^ support.type.slug

var applied = identity<num>(1)
//            ^^^^^^^^^ variable.function.slug
//                    ^ punctuation.definition.type.generic.begin.slug
//                     ^^^ support.type.slug
//                        ^ punctuation.definition.type.generic.end.slug

var person = Person{ name: "a" }
//^^^ storage.type.slug
//                ^ punctuation.section.braces.begin.slug
//                          ^ punctuation.section.braces.end.slug

struct {
  name:str,
  tags:list<str|nil>,
}
//^^^^^^ keyword.control.slug
//      ^ punctuation.section.braces.begin.slug
//        ^^^^ entity.name.variable.field.slug
//            ^ punctuation.separator.type.annotation.slug
//             ^^^ storage.type.annotation.slug
//              ^ punctuation.separator.comma.slug
//        ^^^^ entity.name.variable.field.slug
//            ^ punctuation.separator.type.annotation.slug
//             ^^^^ storage.type.annotation.slug
//                 ^ punctuation.definition.type.generic.begin.slug
//                  ^^^ storage.type.annotation.slug
//                     ^ keyword.operator.logical.slug
//                      ^^^ storage.type.annotation.slug
//                         ^ punctuation.definition.type.generic.end.slug

var updated = person copy { name: "b" }
//                     ^^^^ keyword.control.slug

var xs = [1, ...rest]
//        ^ punctuation.section.brackets.begin.slug
//            ^^^ keyword.operator.spread.slug

match x {
//^^^^^ keyword.control.slug
  {| "a": v |} => v
//^^ punctuation.section.braces.begin.slug
//           ^^ punctuation.section.braces.end.slug
//               ^^ keyword.operator.arrow.slug
}

var f = nursery limit 10 fn(x, y = 2) {
//      ^^^^^^^ keyword.control.concurrent.slug
//              ^^^^^ keyword.control.concurrent.slug
//                        ^^ keyword.control.slug
  spawn { recur(x, y) }
//^^^^^ keyword.control.concurrent.slug
//        ^^^^^ keyword.control.flow.slug
  defer onsuccess(err) { println(err) }
//^^^^^ keyword.control.flow.defer.slug
//    ^^^^^^^^^ keyword.control.flow.defer.slug
}

var onsuccess = 1
//  ^^^^^^^^^ variable.other.slug

select {
//^^^^^ keyword.control.concurrent.slug
  recv ch
//^^^^ keyword.control.concurrent.slug
  send ch, 1
//^^^^ keyword.control.concurrent.slug
  after 10
//^^^^^ keyword.control.concurrent.slug
}
