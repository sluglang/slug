fn slug.std#equals(v1, v2) -> @bool
  desc: "deep equality for maps, recursively comparing values for all keys."
fn slug.std#equals(@list a, @list b, @num idx = 0) -> @bool
  desc: "deep equality for maps, recursively comparing values for all keys."

fn slug.std#filter(@list vs, @fn f, @list acc = []) -> @list
