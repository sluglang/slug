fn slug.list#sort(@list lst) -> @list
  desc: "sorts a list in natural ascending order."

fn slug.list#sortWithComparator(@list lst, @fn comparator) -> @list
  desc: "sorts a list using a custom comparator function."

fn slug.map#difference(@map s1, @map s2) -> @map
