  desc: "asserts that `value >= expected`. Returns `value` on success."
  errors:
    thrown: Error{type:AssertionError}

fn slug.test#assertLessThan(value, expected, msg = nil):any
  desc: "asserts that `value < expected`. Returns `value` on success."
  errors:
    thrown: Error{type:AssertionError}

