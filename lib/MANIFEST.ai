@section symbols
str slug.benchmark#UnitMs

str slug.benchmark#UnitNs

str slug.benchmark#UnitUs

fn slug.benchmark#compare(@list benches, @num warmupMs = 100, @num sampleMs = 200, @num samples = 20, @num minIters = 1, @num maxIters = 10000000, @bool subtractOverhead = true, @str unit = UnitNs) -> ?
  desc: "benchmarks a list of named functions and returns results sorted by p50."
  effects: time
fn slug.benchmark#compare(a, b) -> @num
  desc: "benchmarks a list of named functions and returns results sorted by p50."

fn slug.benchmark#micro(@str name, @fn workFn, @num warmupMs = 100, @num sampleMs = 200, @num samples = 20, @num minIters = 1, @num maxIters = 10000000, @bool subtractOverhead = true, @str unit = UnitNs) -> @map
  desc: "runs a single micro-benchmark and returns a result map with statistics."
  effects: time

fn slug.benchmark#printCompareReport(report) -> ?
  desc: "prints a formatted comparison report to stdout."

fn slug.benchmark#printResult(res) -> ?
  desc: "prints a formatted summary of a `micro` result to stdout."

fn slug.bytes#base64Decode(@str s) -> @bytes
  desc: "decodes a standard base64 string to a byte buffer."

fn slug.bytes#base64Encode(@bytes b) -> @str
  desc: "encodes a byte buffer as a standard base64 string."

fn slug.bytes#bytesToHexStr(@bytes b) -> @str
  desc: "encodes a byte buffer as a lowercase hex string."

fn slug.bytes#bytesToNumbers(@bytes b, i = 0, acc = []) -> @list
  desc: "converts a byte buffer to a list of numeric byte values (0–255)."

fn slug.bytes#bytesToStr(@bytes b) -> @str
  desc: "converts a byte buffer to a UTF-8 string."

fn slug.bytes#hexStrToBytes(@str hex) -> @bytes
  desc: "decodes a lowercase hex string to a byte buffer."

fn slug.bytes#repeat(@bytes b, @num count, @bytes acc = 0x"") -> @bytes
  desc: "repeats a byte buffer `count` times and returns the concatenated result."

fn slug.bytes#strToBytes(@str s) -> @bytes
  desc: "converts a UTF-8 string to a byte buffer."

struct slug.channel#Empty{}

struct slug.channel#Full{value}

fn slug.channel#await(@task handle, @num timeout = 0) -> ?
  desc: "waits for a spawned task to complete and returns its result."
  errors:
    thrown: @struct(Error{type:TimeoutError})

fn slug.channel#chan(@num capacity = 0) -> @chan
  desc: "creates a new channel with an optional buffer capacity."

fn slug.channel#close(@chan channel) -> nil
  desc: "closes a channel, signalling that no more values will be sent."

fn slug.channel#recv(@chan channel, @num timeout = 0) -> ?
  desc: "receives a value from a channel, blocking until one is available."
  errors:
    thrown: @struct(Error{type:TimeoutError})

fn slug.channel#send(@chan channel, payload) -> ?
  desc: "sends a value to a channel, blocking until a receiver is ready."

fn slug.channel#tryRecv(@chan channel) -> ?
  desc: "attempts to receive a value from a channel without blocking."

fn slug.channel#trySend(@chan channel, payload) -> ?
  desc: "attempts to send a value to a channel without blocking."

fn slug.cli#opt(...args) -> ?
  desc: "returns the first non-nil value from `args`, coerced to the type of the last argument."
  errors:
    thrown: @struct(Error{type:TypeError})

fn slug.crypto#hmacSha256(@bytes message, @bytes secret) -> @bytes
  desc: "returns the HMAC-SHA256 of a raw byte message using a raw byte key."
fn slug.crypto#hmacSha256(@str message, @str secret) -> @str
  desc: "returns the HMAC-SHA256 of a raw byte message using a raw byte key."

fn slug.crypto#hmacSha256Hex(@str message, @str secret) -> @str
  desc: "returns the HMAC-SHA256 of a message using a secret key, as a hex string."

fn slug.crypto#hmacSha512(@bytes message, @bytes secret) -> @bytes
  desc: "returns the HMAC-SHA512 of a raw byte message using a raw byte key."
fn slug.crypto#hmacSha512(@str message, @str secret) -> @str
  desc: "returns the HMAC-SHA512 of a raw byte message using a raw byte key."

fn slug.crypto#hmacSha512Hex(@str message, @str secret) -> @str
  desc: "returns the HMAC-SHA512 of a message using a secret key, as a hex string."

fn slug.crypto#md5(@bytes bytes) -> @bytes
  desc: "returns the MD5 hex digest of a string."
fn slug.crypto#md5(@str str) -> @str
  desc: "returns the MD5 hex digest of a string."

fn slug.crypto#sha256(@bytes bytes) -> @bytes
  desc: "returns the SHA-256 hex digest of a string."
fn slug.crypto#sha256(@str str) -> @str
  desc: "returns the SHA-256 hex digest of a string."

fn slug.crypto#sha512(@bytes bytes) -> @bytes
  desc: "returns the SHA-512 hex digest of a string."
fn slug.crypto#sha512(@str str) -> @str
  desc: "returns the SHA-512 hex digest of a string."

fn slug.csv#fromCsvString(@str csvStr, @str sep = ",", @str quote = "\"") -> @list
  desc: "parses a CSV string into a list of rows, where each row is a list of strings."

fn slug.csv#toCsv(@list rows, @str sep = ",", @str quote = "\"", @str eol = "\r\n", @str acc = "") -> @str
  desc: "converts a list of rows (each a list of strings) to a CSV string."

struct slug.db.migration#Migration{@num id, @str version, @str environment, @str filename, @str checksum, @bool success, @str appliedAt}
  desc: "represents a migration record as stored in the tracking table."

fn slug.db.migration#down(@num conn, @num step = 1, @str base = DefaultBase) -> @num
  desc: "rolls back the most recently applied migrations."

fn slug.db.migration#status(@num conn, @list env = DefaultEnv, @str base = DefaultBase) -> @num
  desc: "prints the status of all migration files against the database."
  errors:
    thrown: @struct(Error{type:MigrationError})

fn slug.db.migration#up(@num conn, @list env = DefaultEnv, @str base = DefaultBase) -> @num
  desc: "applies all pending eligible migrations in ascending version order."
  errors:
    thrown: @struct(Error{type:MigrationError})

fn slug.db.repo#into(@list data, toType, @fn columnToFieldName = fn((s)) {camelCase(s, _)}) -> @list
  desc: "maps a list of db result rows onto a struct or map target."
fn slug.db.repo#into(@map data, target, @fn columnToFieldName = fn((s)) {camelCase(s, _)}) -> ?
  desc: "maps a list of db result rows onto a struct or map target."

fn slug.db.repo#loadQueries(@str base = DefaultBase) -> @map
  desc: "scans `base` recursively for `.sql` files and returns a nested map of query functions."

fn slug.debug#ident(value) -> @str
  desc: "returns a stable string identity key for any runtime value."

fn slug.doc.manifest#manifest(@list moduleNames) -> @str
  desc: "generates a MANIFEST.ai file for the given list of module names."

fn slug.doc.markdown#pagePerModule(@list moduleNames) -> @list
  desc: "generates a multi-page markdown API reference for the given list of module names, returns [name, text]."

fn slug.doc.markdown#singlePage(@list moduleNames, @str title = "Slug API Reference") -> @str
  desc: "generates a single-page markdown API reference for the given list of module names."

fn slug.html#extractInnerText(html, tag, start = 0) -> @str
  desc: "extracts the inner content of the first matching tag in an HTML string."

fn slug.html#htmlUnescape(str) -> @str
  desc: "decodes common HTML entities in a string."

str slug.io.db#MYSQL_DRIVER
  desc: "driver string for MySQL connections."

str slug.io.db#PGSQL_DRIVER
  desc: "driver string for PostgreSQL connections."

str slug.io.db#SQLITE_DRIVER
  desc: "driver string for SQLite3 connections."

fn slug.io.db#begin(@num connection) -> @num
  desc: "begins a transaction and returns a transaction handle."

fn slug.io.db#close(@num connection) -> nil
  desc: "closes a database connection or transaction handle."

fn slug.io.db#commit(@num connection) -> @num
  desc: "commits a transaction."

fn slug.io.db#connect(@str connectionString, @str driver) -> @num
  desc: "opens a database connection and returns a connection handle."

fn slug.io.db#exec(@num connection, @str sql, ...params) -> @map
  desc: "executes a SQL statement and returns a result map."

fn slug.io.db#query(@num connection, @str sql, ...params) -> @list
  desc: "executes a SQL query and returns the result rows as a list of string-keyed maps."

fn slug.io.db#rollback(@num connection) -> @num
  desc: "rolls back a transaction."

str slug.io.fs#APPEND_MODE

str slug.io.fs#READ_MODE

str slug.io.fs#WRITE_MODE

fn slug.io.fs#appendFile(@str contents, @str path) -> @num
  desc: "appends `contents` to the end of a file, creating it if absent."

fn slug.io.fs#closeFile(@num handle) -> nil
  desc: "closes an open file handle."

fn slug.io.fs#exists(@str path) -> @bool
  desc: "returns true if `path` exists and is accessible."

fn slug.io.fs#info(@str path) -> @map
  desc: "returns metadata about a file or directory as a map."

fn slug.io.fs#isDir(@str path) -> @bool
  desc: "returns true if `path` is a directory."

fn slug.io.fs#listFilesRecursive(@list path, @fn filter = fn((s)) {true}, acc = []) -> @list
  desc: "recursively collects all files under the given path(s) matching `filter`."

fn slug.io.fs#ls(@str path) -> @list
  desc: "returns a list of filenames in a directory (non-recursive)."

fn slug.io.fs#mkDirs(...path) -> @bool
  desc: "creates all directories in the given path(s), including intermediates."

fn slug.io.fs#openFile(@str path, @str mode) -> @num
  desc: "opens a file in the specified mode and returns a file handle."

fn slug.io.fs#readFile(@str path) -> @str
  desc: "reads the entire contents of a file and returns it as a string."

fn slug.io.fs#readLine(@num handle) -> @str
  desc: "reads the next line from an open file handle."

fn slug.io.fs#readLines(@num file, lines = []) -> @list
  desc: "reads all remaining lines from an open file handle into a list."

fn slug.io.fs#rm(@str path) -> nil
  desc: "removes a file or empty directory at `path`."

fn slug.io.fs#write(@num handle, @str content) -> @num
  desc: "writes `content` to an open file handle."

fn slug.io.fs#writeFile(@str contents, @str path) -> nil
  desc: "writes `contents` to a file, creating or truncating it."

