  desc: "returns a new response with all headers from `headersMap` applied."

fn slug.web.response#withStatus(res, status:num):Response
  desc: "returns a new response with `status` replaced."

fn slug.web.response#withoutHeader(res, key:str):Response
  desc: "returns a new response with `key` removed from headers."

fn slug.web.routes#get(map:map, key):Router
  desc: "registers a `GET` route on `r` and returns the updated router."
fn slug.web.routes#get(r, pattern:str, handler:fn):Router
  desc: "registers a `GET` route on `r` and returns the updated router."

fn slug.web.routes#handle(request, r):Response
  desc: "dispatches `request` through the router's routes and returns a `Response`."

fn slug.web.routes#head(r, pattern:str, handler:fn):Router
  desc: "registers a `HEAD` route on `r` and returns the updated router."

fn slug.web.routes#isRouter(x):bool
  desc: "returns true if `x` is a `Router` struct instance."

fn slug.web.routes#mount(r, prefix:str, handler:fn):Router
  desc: "mounts `handler` at `prefix/*`, matching any method."

fn slug.web.routes#mountRouter(r, prefix:str, childRouter):Router
  desc: "mounts a child `Router` at `prefix`, handling paths relative to the prefix."

fn slug.web.routes#post(r, pattern:str, handler:fn):Router
  desc: "registers a `POST` route on `r` and returns the updated router."

fn slug.web.routes#router():Router
  desc: "creates an empty `Router`."

fn slug.web.routes#static(dir, cacheTimeSeconds = 3600):fn
  desc: "returns a handler that serves static files from `dir`."

fn slug.web.routes#subrouter(router):fn
  desc: "wraps a `Router` as a handler function for use with `mount`."

fn slug.web.routes#withHeader(handler:fn, header:str, value:str):fn
  desc: "wraps `handler` to add a fixed response header to every response."
fn slug.web.routes#withHeader(res, key:str, value:str):fn
  desc: "wraps `handler` to add a fixed response header to every response."

fn slug.web.routes#withLog(handler):fn
  desc: "wraps `handler` with request/response logging to stdout."

fn slug.web.routes#withMaxBody(h, maxBytes = 1048576):fn
  desc: "wraps `handler` to enforce a maximum request body size."

fn slug.web.routes#withRecover(h):fn
  desc: "wraps `handler` so that any thrown error returns a 500 Server Error response."

fn slug.web.routes#withRequestId(handler:fn, newRequestId:fn = fn() {randomHexString(32)}):fn
  desc: "wraps `handler` to attach a request ID to every request and response."

fn slug.web.routes#withTimeout(h, ms):fn
  desc: "wraps `handler` with a timeout of `ms` milliseconds."

fn slug.web.routes#withTraceContext(handler, newTraceId:fn = fn() {randomHexString(32)}, newSpanId:fn = fn() {randomHexString(16)}):fn
  desc: "wraps `handler` to propagate W3C `traceparent` trace context."

fn slug.web.server#serve(app:fn, addr:str = cfg(address, 0.0.0.0), port:num = cfg(port, 8080)):any
  desc: "starts an HTTP/1.1 server and blocks until it is shut down."
  errors:
    thrown: Error{type:ServerError}

fn slug.web.views#new(root:str = "views"):Views
  desc: "creates a new `Views` instance with the given template root directory."

fn slug.web.views#render(v, name, data = {}):str
  desc: "renders a page template by name and returns the HTML string."

fn slug.web.views#renderReply(vx, req, reply):Response
  desc: "renders a `Reply` into an HTML `Response`, with HTMX fragment support."

