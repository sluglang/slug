fn slug.math#floor(@num n) -> @num
  desc: "returns the greatest integer less than or equal to `n`."

fn slug.math#max(@num a, ...b) -> @num
  desc: "returns the largest of two or more numbers."
fn slug.math#max(@num a, @num b) -> @num
  desc: "returns the largest of two or more numbers."

fn slug.math#mean(xs) -> @num
  desc: "returns the arithmetic mean of a list of numbers."

fn slug.math#min(@num a, ...b) -> @num
  desc: "returns the smallest of two or more numbers."

fn slug.math#percentileSorted(xs, p) -> @num
  desc: "returns the `p`th percentile of a pre-sorted ascending list."

fn slug.math#rndRange(@num min, @num max) -> @num
