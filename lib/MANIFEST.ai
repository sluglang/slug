fn slug.io.tcp#close(@num handle) -> @num
  desc: "closes a TCP listener or connection handle."

fn slug.io.tcp#connect(@str addr, @num port) -> @num
  desc: "connects to a TCP server at `addr:port` and returns a connection handle."

fn slug.io.tcp#read(@num stream, @num maxBytes) -> @str
  desc: "reads up to `maxBytes` from a TCP stream."

fn slug.io.tcp#write(@num stream, @str data) -> @num
  desc: "sends `data` over a TCP stream."

