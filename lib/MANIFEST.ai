  desc: "encodes a Slug value as a compact JSON string."
  errors:
    thrown: @struct(Error{type:JsonError})

fn slug.json#pretty(v, @num indent = 2) -> @str
  desc: "encodes a Slug value as a pretty-printed JSON string."
  errors:
    thrown: @struct(Error{type:JsonError})

