  desc: "makes a DELETE request and returns `[status, body]`."

fn slug.io.http#get(@str url, @map headers = {}) -> [@num, @str]
  desc: "makes a GET request and returns `[status, body]`."

fn slug.io.http#patch(@str body, @str url, @map headers = {}) -> [@num, @str]
  desc: "makes a PATCH request and returns `[status, body]`."

fn slug.io.http#post(@str body, @str url, @map headers = {}) -> [@num, @str]
  desc: "makes a POST request and returns `[status, body]`."

fn slug.io.http#put(@str body, @str url, @map headers = {}) -> [@num, @str]
  desc: "makes a PUT request and returns `[status, body]`."

fn slug.io.http#request(@str method, @str url, @str body = "", @map headers = {}) -> [@num, @str]
  desc: "makes an HTTP request and returns `[status, body]`."

fn slug.io.http#urlDecode(@str str) -> ?
  desc: "decodes a URL-encoded string."

