/**
 * Slug Test — unit test runner
 *
 * Discovers and runs `@test` and `@testWith` tagged functions in the
 * given source files, reporting passes, failures, and errors.
 *
 * Usage:
 * ```bash
 * slug test [options] <test files...>
 * ```
 *
 * Test examples:
 * ```slug
 * @test
 * val simpleTest = fn() {
 *   assert(1 + 1 == 2)
 * }
 *
 * @testWith(
 *   [1, 2, 3], 3,
 *   [7, 9, 8], 9,
 *   [4, 5, 3], 5
 * )
 * val max = fn(a, ...b) { ... }
 * ```
 *
 * Options:
 * - `-h, --help`      show this screen
 * - `-v, --version`   show version
 * - `--verbose`       show passing tests as well as failures
 */

val {*} = import(
  "slug.std",
  "slug.map",
  "slug.list",
  "slug.meta",
  "slug.string",
  "slug.time",
  "slug.sys",
  "slug.term.colour",
)
val { assertEqual } = import("slug.test")
val { argsWith }    = import("slug.cli")

val TestWithTag = "@testWith"
val TestTag     = "@test"

val Fail  = BrightColour.Red
val Pass  = Colour.Green
val Reset = reset

// --- CLI spec ---

val spec = {
	name:    'test',
	version: '1.0.0',
	summary: 'Slug test runner — runs @test and @testWith tagged functions and reports results',
	strict: false,
	positional: { min: 1, name: 'files' },
}

// --- test runner ---

var timer = delta(clock)

val passed = fn(msg) {
  if (cfg("verbose", false)) {
    println("  [{{Pass}}PASS{{Reset}}] {{msg}}")
  }
}

val runTestFn = fn(f, name, stats) {
  defer onerror(err) {
    match err {
      Error{ type: 'AssertionError', msg } => {
        println("  [{{Fail}}FAIL{{Reset}}] {{name}}(): {{msg}}")
        stats /> compute(:fail, fn(k, v) { v + 1 })
      }
      { type } => {
        println("  [{{Fail}}ERROR{{Reset}}] {{name}}() threw {{err}}")
        stats /> compute(:error, fn(k, v) { v + 1 })
      }
      _ => {
        println("  [{{Fail}}ERROR{{Reset}}] {{name}}() threw UNKNOWN error type '{{err}}'")
        stats /> compute(:error, fn(k, v) { v + 1 })
      }
    } /> compute(:run, fn(k, v) { v + 1 })
  }
  f()
  passed("{{name}}()")
  stats /> compute(:run, fn(k, v) { v + 1 })
}

val runTest = fn(f, name, params, expected, stats) {
  defer onerror(err) match {
    Error{ type: 'AssertionError' } => {
      println("  [{{Fail}}FAIL{{Reset}}] {{name}}({{params}}) == '{{out}}' expected '{{expected}}'")
      stats /> compute(:fail, fn(k, v) { v + 1 }) /> compute(:run, fn(k, v) { v + 1 })
    }
    _ => {
      println("  [{{Fail}}ERROR{{Reset}}] {{name}}({{params}}) == threw '{{err}}' expected '{{expected}}'")
      stats /> compute(:error, fn(k, v) { v + 1 }) /> compute(:run, fn(k, v) { v + 1 })
    }
  }
  val out = f(...params)
  assertEqual(expected, out)
  passed("{{name}}({{params}}) == {{out}}")
  stats /> compute(:run, fn(k, v) { v + 1 })
}

val runTests = fn(f, name, args, stats) {
  match args {
    [] => stats
    [params, expected, ...t] => {
      recur(f, name, t, runTest(f, name, params, expected, stats))
    }
  }
}

val testRunner = fn(module, stats) {
  var modName = match module /> endsWith(".slug") {
    true  => module[0:-len(".slug")]
    false => module
  }
  modName = modName /> replaceAll("/", ".")
  println(modName + ":")
  val m = modName /> searchModuleTags(TestWithTag, true)
    /> union(modName /> searchModuleTags(TestTag, true))
  m /> keys /> sort /> map(fn(k) {
    val testArgs = m[k] /> getTag(TestWithTag)
    match testArgs {
      nil => runTestFn(m[k], k, { run: 0, fail: 0, error: 0 })
      _   => runTests(m[k], k, testArgs, { run: 0, fail: 0, error: 0 })
    }
  }) /> reduce(stats, fn(vs, new) {
    vs /> compute(:run,   fn(k, v) { v + new[k] })
       /> compute(:fail,  fn(k, v) { v + new[k] })
       /> compute(:error, fn(k, v) { v + new[k] })
  })
}

val renderResult = fn(stats) {
  match stats.fail > 0 || stats.error > 0 {
    true =>
"""
{{Fail}}
*******************************************************************************
**
** Results:
**
** Tests run: {{stats.run}}, Failures: {{stats.fail}}, Errors: {{stats.error}}
**
** Total time {{timer()}}ms
**
*******************************************************************************
{{Reset}}
"""
    false =>
"""
{{Pass}}
Results:

Tests run: {{stats.run}}, Failures: {{stats.fail}}, Errors: {{stats.error}}

Total time {{timer()}}ms
{{Reset}}
"""
  }
}

val run = fn(stats, ...modules) match {
  [_, [], ...] => {
    renderResult(stats) /> println
    match stats.fail > 0 || stats.error > 0 {
      true  => exit(1)
      false => exit(0)
    }
  }
  [_, [h, ...t], ...] => run(testRunner(h, stats), ...t)
  _ => "Unrecognized modules parameter!"
}

// --- entrypoint ---

@main
val main = fn(args = argm()) {
  val result = args /> argsWith(spec)

  match result {
    { action: :help }    => { println(result.text); import('slug.sys').exit(0) }
    { action: :version } => { println(result.text); import('slug.sys').exit(0) }
    { action: :error }   => {
      result.errors /> map(fn(e) { println(e.msg) })
      import('slug.sys').exit(1)
    }
    { ok: true, options, positional } => {
      run({ run: 0, fail: 0, error: 0 }, ...positional)
    }
  }
}
