/**
 * doc — Slug documentation tool
 *
 * Generates MANIFEST.ai or markdown documentation by reflecting over
 * Slug modules in a source directory.
 *
 * Usage:
 * ```bash
 * slug doc [options] [--] [manifest|markdown]
 * ```
 *
 * Commands:
 * - `manifest`   generate a MANIFEST.ai file from source modules (default)
 * - `markdown`   generate human-readable markdown documentation
 *
 * Options:
 * - `-h, --help`       show this screen
 * - `-v, --version`    show version
 * - `--dir`            source directory to scan for .slug modules (default: .)
 * - `--out`            output file path; omit to print to stdout
 * - `--title`          document title for markdown output (default: Slug API Reference)
 * - `--multiPage`      generate a file per module in the --out directory (markdown only)
 * - `--moduleToc`      generate a table of contents for each module
 */

val {*} = import(
	'slug.std',
	'slug.string',
	'slug.list',
	'slug.doc.discover',
)
val { writeFile, listFilesRecursive } = import('slug.io.fs')
val { manifest }                      = import('slug.doc.manifest')
val { singlePage, pagePerModule }     = import('slug.doc.markdown')
val { argsWith }                      = import('slug.cli')

// --- CLI spec ---

val spec = {
	name:    'doc',
	version: '1.0.0',
	summary: '''
Slug documentation tool — generates MANIFEST.ai or markdown from source modules

Commands:
- manifest   generate a MANIFEST.ai file from source modules (default)
- markdown   generate human-readable markdown documentation
''',
	types: {
		dir:       'str',
		out:       'str',
		title:     'str',
		multiPage: 'bool',
		moduleToc: 'bool',
	},
	required: ["dir"],
	strict: false,
	defaults: {
		title:     'Slug API Reference',
		multiPage: false,
		moduleToc: false,
	},
	desc: {
		dir:       'source directory to scan for .slug modules',
		out:       'output file path; omit to print to stdout',
		title:     'document title for markdown output',
		multiPage: 'generate a file per module in the --out directory (markdown only)',
		moduleToc: 'generate a table of contents for each module',
	},
	positional: { min: 0, max: 1, name: 'command' },
}

// --- output helper ---
// Writes to file if --out was given, otherwise prints to stdout.

val emit = fn(content, outPath) {
	match outPath {
		nil => println(content)
		_   => {
			writeFile(content, outPath)
			println(fmt('written to {}', outPath))
		}
	}
}

// --- commands ---

val runManifest = fn(dir, outPath) {
	val modules = discoverModules(dir)
	match modules {
		[] => {
			println(fmt('no .slug modules found in {}', dir))
			import('slug.sys').exit(1)
		}
		[...] => {
			println(fmt('generating manifest for {} modules in {}...', len(modules), dir))
			modules /> manifest /> emit(outPath)
		}
	}
}

val runMarkdown = fn(dir, outPath, title, multiPage, moduleToc) {
	val modules = discoverModules(dir)
	match modules {
		[] => {
			println(fmt('no .slug modules found in {}', dir))
			import('slug.sys').exit(1)
		}
		[...] => {
			println(fmt('generating markdown for {} modules in {}...', len(modules), dir))
			match multiPage {
				false => modules /> singlePage(title, moduleToc) /> emit(outPath)
				true  => modules /> pagePerModule(moduleToc) /> map(fn(v) { emit(v[1], outPath + '/' + v[0] + '.md') })
			}
		}
	}
}

// --- entrypoint ---

@main val main = fn(args = argm()) {

	val result = args /> argsWith(spec)

	match result {
		{ action: :help }    => { println(result.text); import('slug.sys').exit(0) }
		{ action: :version } => { println(result.text); import('slug.sys').exit(0) }
		{ action: :error }   => {
			result.errors /> map(fn(e) { println(e.msg) })
			import('slug.sys').exit(1)
		}
		{ ok: true, options, positional } => {
			val dir       = options.dir
			val outPath   = options.out
			val title     = options.title
			val multiPage = options.multiPage
			val moduleToc = options.moduleToc
			val command   = match positional {
				[]         => 'manifest'
				[cmd, ...] => cmd
			}
			match command {
				'manifest' => runManifest(dir, outPath)
				'markdown' => runMarkdown(dir, outPath, title, multiPage, moduleToc)
				_ => {
					println(fmt('unknown command: {}', command))
					println(result.text)
					import('slug.sys').exit(1)
				}
			}
		}
	}
}
