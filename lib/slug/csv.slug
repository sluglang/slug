/**
 * slug.csv — CSV parsing and serialisation
 *
 * Parses CSV strings into lists of rows and serialises lists of rows back
 * to CSV strings. Handles quoted fields, embedded newlines, escaped quotes,
 * and configurable separators.
 *
 * Rows are represented as `@list` values. Columns are accessed by index:
 * `row[0]` for the first column, `row[1]` for the second, and so on.
 *
 * ## Example
 *
 * ```slug
 * val { fromCsvString, toCsv } = import("slug.csv")
 *
 * val rows = fromCsvString("name,age\r\nAlice,30\r\nBob,25")
 * rows[0]  // => ["name", "age"]
 * rows[1]  // => ["Alice", "30"]
 *
 * toCsv([["name", "age"], ["Alice", "30"]])
 * // => "name,age\r\nAlice,30\r\n"
 * ```
 *
 * ## Quoting rules
 *
 * Fields are automatically quoted during serialisation if they contain
 * the separator, the quote character, a newline, or a carriage return.
 * Quote characters within a field are escaped by doubling: `"` → `""`.
 */

val {*} = import(
	"slug.string",
)

/**
 * converts a list of rows (each a list of strings) to a CSV string.
 *
 * Fields are quoted automatically when they contain the separator, quote
 * character, or newline characters. The default line ending is `\r\n`
 * (RFC 4180). Each row is terminated by `eol`.
 */
@testWith(
	[[["a", "b"]]], "a,b\r\n",
	[[["a", "b"],["c", "d"]]], "a,b\r\nc,d\r\n",
	[[["a\n", "qu\"ote"]]], "\"a\n\",\"qu\"\"ote\"\r\n",
)
@export
@returns('@str')
val toCsv = fn(rows:list, sep:str = ",", quote:str = "\"", eol:str = "\r\n", acc:str = "") match {
	[[], ...] => acc
	[[h, ...t], ...] => recur(t, sep, quote, eol, acc + rowToCsv(h, sep, quote, eol))
}

/**
 * parses a CSV string into a list of rows, where each row is a list of strings.
 *
 * Handles quoted fields (including embedded newlines and escaped quotes),
 * CRLF and LF line endings, and configurable separator and quote characters.
 * Access columns by index: `row[0]`, `row[1]`, etc.
 */
@testWith(
	["a,b,c"], [["a", "b", "c"]],
	["a,b,c\r\nd,\"e\n f\",g"], [["a", "b", "c"], ["d", "e\n f", "g"]],
)
@export
@returns('@list')
val fromCsvString = fn(csvStr:str, sep:str = ",", quote:str = "\"") {
	parseCsv(csvStr, sep, quote, 0, len(csvStr), [], [], false)
}

// --- internal helpers ---

val rowToCsv = fn(row:list, sep:str, quote:str, eol:str, acc:str = "") match {
	[[], ...] => acc + eol
	[[h], ...] => recur([], sep, quote, eol, acc + cellToCsv(h, sep, quote))
	[[h, ...t], ...] => recur(t, sep, quote, eol, acc + cellToCsv(h, sep, quote) + sep)
}

val cellToCsv = fn(cell:str, sep:str, quote:str) {
	val needsQuote = cell /> contains(sep)
			|| cell /> contains(quote)
			|| cell /> contains("\n")
			|| cell /> contains("\r")
	if (needsQuote) {
		quote + cell /> replaceAll(quote, quote + quote) + quote
	} else {
		cell
	}
}

val parseCsv = fn(csvStr:str, sep:str, quote:str, i:num, n:num, accRows:list, accRow:list, inQuotes:bool, accField:str = "") {
	if (i >= n) {
		val finalRow  = flushFieldToRow(accRow, accField)
		val finalRows = flushRow(accRows, finalRow)
		finalRows
	} else {
		val c = csvStr[i]
		if (inQuotes) {
			if (c == quote) {
				if (i + 1 < n && csvStr[i + 1] == quote) {
					// escaped quote — include one literal quote in field
					recur(csvStr, sep, quote, i + 2, n, accRows, accRow, true, accField + quote)
				} else {
					// closing quote
					recur(csvStr, sep, quote, i + 1, n, accRows, accRow, false, accField)
				}
			} else {
				recur(csvStr, sep, quote, i + 1, n, accRows, accRow, true, accField + c)
			}
		} else {
			match c {
				^quote => recur(csvStr, sep, quote, i + 1, n, accRows, accRow, true, accField)
				^sep => {
					recur(csvStr, sep, quote, i + 1, n, accRows, accRow :+ accField, false, "")
				}
				"\r" => {
					val nextI      = if (i + 1 < n && csvStr[i + 1] == "\n") { i + 2 } else { i + 1 }
					val finishedRow = accRow :+ accField
					recur(csvStr, sep, quote, nextI, n, accRows :+ finishedRow, [], false, "")
				}
				"\n" => {
					val finishedRow = accRow :+ accField
					recur(csvStr, sep, quote, i + 1, n, accRows :+ finishedRow, [], false, "")
				}
				_ => recur(csvStr, sep, quote, i + 1, n, accRows, accRow, false, accField + c)
			}
		}
	}
}

val flushFieldToRow = fn(row:list, field:str) {
	if (len(field) == 0 && len(row) == 0) { row } else { row :+ field }
}

val flushRow = fn(rows:list, row:list) {
	if (len(row) == 0) { rows } else { rows :+ row }
}
