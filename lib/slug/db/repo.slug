/**
 * slug.db.repo — file-based SQL query loader with named parameter extraction and schema mapping
 *
 * Scans a directory of `.sql` files and builds a nested map of ready-to-call
 * query functions that mirrors the folder structure. Named parameters in SQL
 * (`:param`) are extracted and rewritten to `?` placeholders automatically.
 *
 * ## Quick start
 *
 * ```slug
 * val { loadQueries, into } = import("slug.db.repo")
 * val { connect, SQLITE_DRIVER } = import("slug.io.db")
 *
 * val conn  = connect("file:app.db", SQLITE_DRIVER)
 * val repos = loadQueries()
 *
 * // db/queries/users/byAge.sql: SELECT * FROM users WHERE age > :age
 * val users = conn /> repos.users.byAge({ age: 25 }) /> into(User)
 * ```
 *
 * ## SQL file layout
 *
 * Files are discovered recursively under the base directory. The path
 * relative to the base becomes the nested map key:
 * ```
 * db/queries/users/byAge.sql  =>  repos.users.byAge(conn, args)
 * db/queries/posts/recent.sql =>  repos.posts.recent(conn, args)
 * ```
 *
 * ## Named parameters
 *
 * Use `:paramName` in SQL to define named parameters. They are rewritten
 * to `?` placeholders and extracted in order. Parameters inside string
 * literals and comments are safely ignored.
 *
 * Pass args as a map `{ age: 25 }`, a list `[25]`, or a struct.
 *
 * ## Query type detection
 *
 * `SELECT`/`WITH` statements call `query()` (returns `@list`).
 * All other statements call `exec()` (returns `@map`).
 *
 * @effects('fs db')
 */

val {*} = import(
	"slug.string",
	"slug.list",
	"slug.std",
	"slug.map",
	"slug.io.db",
	"slug.io.fs",
)

val lst = import("slug.list")

val DefaultBase = cfg('base-directory', 'db/queries')

// --- keyword detection ---
val QUERY_KEYWORDS = ["select", "with"]
val EXEC_KEYWORDS  = ["insert", "update", "delete", "create", "drop", "alter", "replace"]

// --- parser modes ---
val MODE_NORMAL    = :normal
val MODE_STRING    = :string
val MODE_LINE_CMT  = :line_cmt
val MODE_BLOCK_CMT = :block_cmt

/**
 * result of `extractArgs` — carries the rewritten SQL, ordered param symbols,
 * and the inferred statement type.
 *
 * Do not construct directly; use `extractArgs`.
 */
val SqlQuery = struct {
	sql:str,    // rewritten SQL with ? placeholders
	args:list,   // ordered list of param symbols matching ? positions
	type:sym,   // :query (SELECT/WITH) or :exec (all other statements)
}

/**
 * scans `base` recursively for `.sql` files and returns a nested map of query functions.
 *
 * Each leaf is a `fn(conn, args)` that executes the query against `conn`.
 * The map structure mirrors the directory structure under `base`.
 * The default base directory is `db/queries` or the `base-directory` config key.
 */
@export
@returns("@map")
val loadQueries = fn(base:str = DefaultBase) {
	val baseLen = len(base)
	listFilesRecursive([base], fn(s) { s[-4:] == '.sql' })
	/> reduce({}, fn(repos, path) {
		val f = readFile(path)
		/> trim
		/> mkQueryFunction
		val keyPath = path[baseLen:-4]
		/> replaceAll('/', ' ')
		/> trim
		/> split(' ')
		repos /> putNested(keyPath, f)
	})
}

/**
 * maps a single db result row (map) onto a struct or map target.
 *
 * Column names are normalised from `snake_case` to `camelCase` by default.
 * Pass a custom `columnToFieldName` function to override the key transform.
 * If `target` is a struct schema, constructs a new instance via bulk copy.
 * If `target` is a map or struct instance, merges into it.
 */
@export
@returns("?")
val into = fn(data:map, target, columnToFieldName:fn = fn(s) { camelCase(s, '_') }) {
	val mapped = data /> keys /> reduce({}, fn(m, k) {
		put(m, sym(columnToFieldName(k)), data[k])
	})
	match type(target) {
		^MAP_TYPE    => mapped /> keys /> reduce(target, fn(a, b) { put(a, b, mapped[b]) })
		^STRUCT_TYPE => target{} copy mapped
		_            => target copy mapped
	}
}

/**
 * maps a list of db result rows onto a struct or map target.
 *
 * Delegates each row to the `@map` variant. Column names are normalised
 * from `snake_case` to `camelCase` by default.
 */
@export
@returns("@list")
val into = fn(data:list, toType, columnToFieldName:fn = fn(s) { camelCase(s, '_') }) {
	data /> map(fn(v) { into(v, toType, columnToFieldName) })
}

// --- SQL type detection ---

val firstKeyword = fn(sql) {
	val lower = sql /> toLower /> trim
	val step  = fn(words) {
		match words {
			[]        => :unknown
			[w, ...t] => {
				val trimmed = trim(w)
				match trimmed {
					"" => recur(t)
					_  => sym(trimmed)
				}
			}
		}
	}
	lower /> split(' ') /> step
}

val sqlType = fn(sql) {
	val kw  = firstKeyword(sql)
	val lbl = label(kw)
	match true {
		true if QUERY_KEYWORDS /> lst.indexOf(lbl) >= 0 => :query
		true if EXEC_KEYWORDS  /> lst.indexOf(lbl) >= 0 => :exec
		_                                               => :exec
	}
}

// --- character helpers ---

val isAlphanumeric = fn(s:str) { isLetter(s) || isNumber(s) || s == '_' }
val isLetter       = fn(s:str) { 'abcdefghijklmnopqrstuvwxyz' /> indexOf(s /> toLower) >= 0 }
val isNumber       = fn(s:str) { '0123456789' /> indexOf(s) >= 0 }

// --- named parameter extractor ---

/**
 * rewrites `:named` params in a SQL string to `?` placeholders and returns a `SqlQuery`.
 *
 * Safe inside single-quoted string literals and `--` / `/** */` comments.
 * Repeated params (`:id` used twice) produce two `?` placeholders and two
 * entries in `args` so positional binding stays correct.
 */
@testWith(
  // basic cases
  ["select * from foo where a = :arg1"], SqlQuery{ sql: "select * from foo where a = ?", args: [:arg1], type: :query },
  ["select * from foo where a = :arg1 and b = :arg2"], SqlQuery{ sql: "select * from foo where a = ? and b = ?", args: [:arg1, :arg2], type: :query },
  // repeated param
  ["select * from foo where a = :id or b = :id"], SqlQuery{ sql: "select * from foo where a = ? or b = ?", args: [:id, :id], type: :query },
  // param inside string literal should be ignored
  ["select * from foo where a = ':not_a_param' and b = :real"], SqlQuery{ sql: "select * from foo where a = ':not_a_param' and b = ?", args: [:real], type: :query },
  // exec detection
  ["insert into foo (a, b) values (:a, :b)"], SqlQuery{ sql: "insert into foo (a, b) values (?, ?)", args: [:a, :b], type: :exec },
  // no params
  ["select * from foo"], SqlQuery{ sql: "select * from foo", args: [], type: :query },
)
val extractArgs = fn(sql) {
	val step = fn(sql, out, arg, args, inArg, mode, prev) {
		match sql {
			"" => {
				val finalArgs = match inArg {
					true => args :+ sym(arg)
					_    => args
				}
				SqlQuery{ sql: out, args: finalArgs, type: sqlType(out) }
			}
			_ => {
				val c    = sql[0]
				val rest = sql[1:]
				val next = if (len(rest) > 0) { rest[0] } else { "" }

				match mode {
					^MODE_STRING => match c {
						"'" => recur(rest, out + c, arg, args, false, MODE_NORMAL, c)
						_   => recur(rest, out + c, arg, args, false, MODE_STRING, c)
					}
					^MODE_LINE_CMT => match c {
						"\n" => recur(rest, out + c, arg, args, false, MODE_NORMAL, c)
						_    => recur(rest, out + c, arg, args, false, MODE_LINE_CMT, c)
					}
					^MODE_BLOCK_CMT => match true {
						true if prev == "*" && c == "/" =>
							recur(rest, out + c, arg, args, false, MODE_NORMAL, c)
						_ =>
							recur(rest, out + c, arg, args, false, MODE_BLOCK_CMT, c)
					}
					_ => match true {
						true if c == "'" && !inArg =>
							recur(rest, out + c, "", args, false, MODE_STRING, c)
						true if c == "-" && next == "-" && !inArg =>
							recur(rest, out + c, "", args, false, MODE_LINE_CMT, c)
						true if c == "/" && next == "*" && !inArg =>
							recur(rest, out + c, "", args, false, MODE_BLOCK_CMT, c)
						true if c == ":" && !inArg =>
							recur(rest, out + "?", "", args, true, MODE_NORMAL, c)
						true if inArg && isAlphanumeric(c) =>
							recur(rest, out, arg + c, args, true, MODE_NORMAL, c)
						true if inArg =>
							recur(rest, out + c, "", args :+ sym(arg), false, MODE_NORMAL, c)
						_ =>
							recur(rest, out + c, "", args, false, MODE_NORMAL, c)
					}
				}
			}
		}
	}
	step(sql, "", "", [], false, MODE_NORMAL, "")
}

// Builds a callable fn(conn, args) from a raw SQL string.
// Dispatches to query() or exec() based on the extracted statement type.
val mkQueryFunction = fn(rawSql) {
	val SqlQuery{ sql, args: queryParams, type: kind } = extractArgs(rawSql)
	fn(conn, args = {}) {
		val params = match type(args) {
			^LIST_TYPE => args
			_          => queryParams /> map(fn(v) { args[v] })
		}
		match kind {
			:query => conn /> query(sql, ...params)
			:exec  => conn /> exec(sql, ...params)
		}
	}
}
