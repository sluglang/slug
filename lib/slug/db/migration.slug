/**
 * slug.db.migration — SQL schema migration runner
 *
 * Applies, rolls back, and reports on versioned SQL migration scripts
 * stored as `.sql` files on the filesystem.
 *
 * ## File naming convention
 *
 * Migration files must follow the pattern:
 * ```
 * <version>__<description>.sql
 * <version>__<environment>__<description>.sql
 * ```
 *
 * Examples:
 * ```
 * db/migrations/001__create_users.sql
 * db/migrations/002__production__add_index.sql
 * ```
 *
 * Files are sorted and applied in ascending version order.
 *
 * ## Script sections
 *
 * Each `.sql` file may contain `-- @up` and `-- @down` section markers.
 * The `up` section is applied on `up`, the `down` section on `down`.
 * If no markers are present, the entire file is treated as the `up` script.
 *
 * ```sql
 * -- @up
 * CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT);
 *
 * -- @down
 * DROP TABLE users;
 * ```
 *
 * ## Tracking table
 *
 * Applied migrations are recorded in a `slug_schema_migrations` table
 * which is created automatically on first run. Each entry stores the
 * version, environment, filename, SHA-256 checksum, and success status.
 *
 * ## Configuration
 *
 * Default base directory and environment can be set via `cfg`:
 * ```
 * base-directory = db/migrations
 * environment    = production
 * ```
 *
 * @effects('fs db')
 */

val {*} = import(
	"slug.std",
	"slug.list",
	"slug.map",
	"slug.string",
	"slug.crypto",
	"slug.io.db",
	"slug.io.fs",
)

val TrackingTableSql = '''
CREATE TABLE IF NOT EXISTS slug_schema_migrations
(
	id          INTEGER PRIMARY KEY,
	version     VARCHAR(255) NOT NULL,
	environment VARCHAR(255) NULL,
	filename    VARCHAR(255) NOT NULL,
	checksum    VARCHAR(64) NOT NULL,
	success     BIT NOT NULL DEFAULT 0,
	applied_at  VARCHAR(255) DEFAULT CURRENT_TIMESTAMP
);
'''

val TrackingTableIndexSql = '''
CREATE UNIQUE INDEX idx_slug_schema_migrations_version
ON slug_schema_migrations (version);
'''

val DefaultBase = cfg('base-directory', 'db/migrations')
val DefaultEnv  = cfg('environment', [])

/**
 * represents a migration record as stored in the tracking table.
 */
@export val Migration = struct {
	id:num,
	version:str,
	environment:str,
	filename:str,
	checksum:str,
	success:bool,
	appliedAt:str,
}

/**
 * prints the status of all migration files against the database.
 *
 * Each migration is reported as APPLIED, MISSING, or INELIGIBLE (for
 * environments not in `env`). Applied migrations whose checksum no longer
 * matches the file will throw `MigrationError`.
 *
 * Returns the connection handle for chaining.
 */
@export
@returns('num')
@throws('@struct(Error{type:MigrationError})')
val status = fn(conn:num, env:list = DefaultEnv, base:str = DefaultBase) {
	checkTrackingTable(conn)
	listMigrationFiles(base, fn(m, sql) {
		defer onerror(err) println(fmtError(m, err))
		if (m.environment == nil || indexOf(env, m.environment) > -1) {
			match checkMigrationApplied(conn, m) {
				true  => println(fmtExists(m))
				false => println(fmtMissing(m))
			}
		} else {
			match checkMigrationApplied(conn, m) {
				true  => println(fmtExistsIneligible(m))
				false => println(fmtMissingIneligible(m))
			}
		}
	})
	conn
}

/**
 * applies all pending eligible migrations in ascending version order.
 *
 * Skips already-applied migrations and migrations for ineligible environments.
 * On failure, records the migration as failed and rethrows the error.
 *
 * Returns the connection handle for chaining.
 */
@export
@returns('num')
@throws('@struct(Error{type:MigrationError})')
val up = fn(conn:num, env:list = DefaultEnv, base:str = DefaultBase) {
	checkTrackingTable(conn)
	listMigrationFiles(base, fn(m, sql) {
		defer onerror(err) {
			markApplied(conn, m, false)
			println(fmtError(m, err))
			throw err
		}
		if (m.environment == nil || indexOf(env, m.environment) > -1) {
			if (!checkMigrationApplied(conn, m)) {
				conn
				/> applyMigrationSql(sliceUpScript(sql))
				/> markApplied(m, true)
				println(fmtApplied(m))
			}
		}
	})
	conn
}

/**
 * rolls back the most recently applied migrations.
 *
 * Applies the `-- @down` section of each rolled-back migration script
 * and removes its entry from the tracking table. `step` controls how
 * many migrations to roll back (default 1).
 *
 * Returns the connection handle for chaining.
 */
@export
@returns('num')
val down = fn(conn:num, step:num = 1, base:str = DefaultBase) {
	checkTrackingTable(conn)
	findLatestMigrations(conn, step)
	/> map(fn(m) {
		conn
		/> applyMigrationSql(readDownScript(base + '/' + m.filename))
		/> deleteMigration(m)
		println(fmtRollback(m))
	})
	conn
}

// --- formatting helpers ---

val fmtEnv = fn(s) match {
	nil => ''
	_   => s + ': '
}

val fmtExists            = fn(m) { fmt('{} [ APPLIED    ] {}{}', m.version, fmtEnv(m.environment), m.filename) }
val fmtApplied           = fn(m) { fmt('{} [ SUCCESS    ] {}{}', m.version, fmtEnv(m.environment), m.filename) }
val fmtMissing           = fn(m) { fmt('{} [ MISSING    ] {}{}', m.version, fmtEnv(m.environment), m.filename) }
val fmtExistsIneligible  = fn(m) { fmt('{} [ INELIGIBLE ] {}{} - WARNING this migration has been applied in an ineligible environment', m.version, fmtEnv(m.environment), m.filename) }
val fmtMissingIneligible = fn(m) { fmt('{} [ INELIGIBLE ] {}{}', m.version, fmtEnv(m.environment), m.filename) }
val fmtRollback          = fn(m) { fmt('{} [ ROLLBACK   ] {}{}', m.version, fmtEnv(m.environment), m.filename) }
val fmtError        = fn(m, err) { fmt('{} [ ERROR      ] {}{}: {}', m.version, fmtEnv(m.environment), m.filename, err.msg) }

// --- script slicing ---

val sliceUpScript = fn(sql:str) { sql /> sliceSqlScript('up') }

val readDownScript = fn(filepath:str) { readFile(filepath) /> sliceSqlScript('down') }

val sliceSqlScript = fn(sql:str, read:str) {
	sql
	/> split("\n")
	/> sliceSqlLines
	/> match {
		[up, _]   if read == 'up'   => up /> join("\n")
		[_, down] if read == 'down' => down /> join("\n")
		_ => ""
	}
}

@testWith(
	[["-- @up", "UP", "-- @down", "DOWN"]], [["-- @up", "UP"], ["-- @down", "DOWN"]],
	[["-- @down", "DOWN", "-- @up", "UP"]], [["-- @up", "UP"], ["-- @down", "DOWN"]],
	[["-- @up", "UP", "-- @down", "DOWN", "-- @up", "UP2"]], [["-- @up", "UP", "-- @up", "UP2"], ["-- @down", "DOWN"]],
)
val sliceSqlLines = fn(strs:list, readingUp = true, up:list = [], down:list = []) match {
	[[], ...]                         => [up, down]
	[[h, ...t], ...] if startUp(h)   => recur(t, true,  up :+ h, down)
	[[h, ...t], ...] if startDown(h) => recur(t, false, up, down :+ h)
	[[h, ...t], true, ...]            => recur(t, readingUp, up :+ h, down)
	[[h, ...t], false, ...]           => recur(t, readingUp, up, down :+ h)
}

val startUp   = fn(str) { startTag(str, '@up') }
val startDown = fn(str) { startTag(str, '@down') }

@testWith(
	['  -- @up  ', '@up'],   true,
	['-- @up', '@up'],       true,
	['-- @DOWN', '@down'],   true,
	['; -- @down', '@down'], false,
	['@down', '@down'],      false,
	['', '@down'],           false,
)
val startTag = fn(str, tag) {
	str /> trim /> startsWith('--') && str /> toLower /> contains(tag)
}

// --- database helpers ---

val checkTrackingTable = fn(conn) {
	match exec(conn, TrackingTableSql) {
		{rowsAffected} if rowsAffected > 0 => exec(conn, TrackingTableIndexSql)
	}
}

val applyMigrationSql = fn(conn, sql) {
	exec(conn, sql)
	conn
}

val listMigrationFiles = fn(base:str, f:fn = fn(migration, sql) { migration }) {
	val baseLen = len(base)
	listFilesRecursive([base], fn(s) { s[-4:] == '.sql' })
	/> sort
	/> map(fn(path) {
		val sql      = readFile(path)
		val filename = path[baseLen:]
		val [version, env] = filename
		/> replaceAll('/', ' ')
		/> trim
		/> split('__', 3)
		/> match {
			[a, env, _] => [replaceAll(a, ' ', '.'), trim(env)]
			[a, _]      => [replaceAll(a, ' ', '.'), nil]
			_ => throw Error{ type: 'MigrationError', msg: filename + " must be in the form `<version>__<environment>__<description>.sql`" }
		}
		val m = Migration {
			version:     version,
			environment: env,
			filename:    filename,
			checksum:    sha256(sql),
		}
		f(m, sql)
	})
}

val markApplied = fn(conn, m:Migration, success:bool) {
	conn /> exec(
		'insert into slug_schema_migrations (version, environment, filename, checksum, success) values (?, ?, ?, ?, ?)',
		m.version, m.environment, m.filename, m.checksum, success
	)
}

val deleteMigration = fn(conn, m:Migration) {
	conn /> exec('delete from slug_schema_migrations where version = ?', m.version)
}

val findLatestMigrations = fn(conn, limit:num = 1_000_000) {
	conn /> query('select * from slug_schema_migrations order by version desc limit ?', limit)
	/> map(fn(v) {
		val data = v /> keys /> reduce({}, fn(a, k) {
			put(a, sym(camelCase(k, '_')), v[k])
		})
		Migration{} copy data
	})
}

val checkMigrationApplied = fn(conn, m:Migration) {
	conn
	/> query('select * from slug_schema_migrations where version = ?', m.version)
	/> match {
		[] => false
		[v] => {
			if (v['checksum'] != m.checksum) {
				throw Error{ type: 'MigrationError', msg: "checksum mismatch", data: m }
			} else if (!v['success']) {
				throw Error{ type: 'MigrationError', msg: "script failed", data: m }
			} else {
				true
			}
		}
	}
}
