/**
 * slug.bytes — byte buffer utilities
 *
 * Conversions between `bytes`, `str`, hex strings, base64, and numeric lists.
 * All functions are pure and operate on immutable byte values.
 *
 * Byte literals use the `0x"<hex>"` syntax, e.g. `0x"ff0a"`.
 */

/**
 * converts a UTF-8 string to a byte buffer.
 */
@testWith(
    [""], 0x"",
    ["hello slug"], 0x"68656c6c6f20736c7567",
)
@export
foreign strToBytes = fn(s:str):bytes


/**
 * converts a byte buffer to a UTF-8 string.
 */
@testWith(
    [0x""], "",
    [0x"68656c6c6f20736c7567"], "hello slug",
)
@export
foreign bytesToStr = fn(b:bytes):str


/**
 * decodes a lowercase hex string to a byte buffer.
 */
@testWith(
    [""], 0x"",
    ["68656c6c6f20736c7567"], 0x"68656c6c6f20736c7567",
    ["a8ff04"], 0x"a8ff04",
)
@export
foreign hexStrToBytes = fn(hex:str):bytes


/**
 * encodes a byte buffer as a lowercase hex string.
 */
@testWith(
    [0x""], "",
    [0x"68656c6c6f20736c7567"], "68656c6c6f20736c7567",
)
@export
foreign bytesToHexStr = fn(b:bytes):str


/**
 * decodes a standard base64 string to a byte buffer.
 */
@testWith(
    [""], 0x"",
    ["aGVsbG8gc2x1Zw=="], 0x"68656c6c6f20736c7567",
)
@export
foreign base64Decode = fn(s:str):bytes


/**
 * encodes a byte buffer as a standard base64 string.
 */
@testWith(
    [0x""], "",
    [0x"68656c6c6f20736c7567"], "aGVsbG8gc2x1Zw==",
)
@export
foreign base64Encode = fn(b:bytes):str


/**
 * repeats a byte buffer `count` times and returns the concatenated result.
 */
@testWith(
    [0x"ff", 3], 0x"ffffff",
)
@export
val repeat = fn(b:bytes, count:num, acc:bytes = 0x""):bytes match {
    [_, 0, ...] => acc
    [...] => recur(b, count - 1, acc + b)
}


/**
 * converts a byte buffer to a list of numeric byte values (0–255).
 */
@testWith(
    [0x"a8ff04"], [168, 255, 4],
)
@export
val bytesToNumbers = fn(b:bytes, i = 0, acc = []):list match {
    [b, ...] if len(b) == i => acc
    [b, ...]                => recur(b, i + 1, acc :+ b[i])
}
