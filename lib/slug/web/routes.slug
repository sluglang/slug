/**
 * slug.web.routes — HTTP router and middleware
 *
 * Pattern-based HTTP routing with composable middleware wrappers.
 * Routes are registered on a `Router` and dispatched via `handle`.
 *
 * ## Quick start
 *
 * ```slug
 * val { router, get, post, handle, withLog, withRecover } = import("slug.web.routes")
 * val { html, jsonOk, notFound } = import("slug.web.response")
 *
 * val r = router()
 * /> get("/",           fn(req) { html("<h1>Hello</h1>") })
 * /> get("/users/:id",  fn(req) { jsonOk({ id: req.params["id"] }) })
 * /> post("/users",     fn(req) { jsonOk(req.body) })
 *
 * val app = r /> handle /> withLog /> withRecover
 * ```
 *
 * ## Route patterns
 *
 * - Exact match: `"/users"` matches only `/users`
 * - Named param: `"/users/:id"` captures the segment as `req.params["id"]`
 * - Wildcard mount: `"/static/*"` matches any path starting with `/static/`
 *   and captures the remainder as `req.params["*"]`
 *
 * ## Middleware
 *
 * Middleware wraps a handler function `fn(req) -> Response` and returns
 * a new handler with the same signature. Chain middleware with `/>`:
 *
 * ```slug
 * val app = fn(req) { handle(req, r) }
 * /> withLog
 * /> withRecover
 * /> withMaxBody(512_000)
 * /> withRequestId
 * ```
 *
 * ## Subrouters
 *
 * Mount a child router at a prefix with `mountRouter`. The child router
 * sees paths relative to the mount point:
 *
 * ```slug
 * val api = router()
 * /> get("/users",    usersHandler)
 * /> get("/users/:id", userHandler)
 *
 * val r = router()
 * /> mountRouter("/api", api)
 * ```
 *
 * ## Static files
 *
 * ```slug
 * val r = router()
 * /> mount("/static", static("public"))
 * ```
 */

val {*} = import(
	"slug.web.response",
	"slug.web.request",
	"slug.io.fs",
	"slug.channel",
	"slug.time",
	"slug.string",
	"slug.std",
)

val err = import('slug.io.stderr')

val Route = struct {
	method:str,
	pattern:str,
	handler:fn,
}

val Router = struct {
	routes:list,
}

// --- constructors ---

/**
 * creates an empty `Router`.
 */
@export
@returns('@struct(Router)')
val router = fn() {
	Router { routes: [] }
}

/**
 * returns true if `x` is a `Router` struct instance.
 */
@export
@returns('@bool')
val isRouter = fn(x) match {
	Router { routes } => true
	_ => false
}

// --- route registration ---

val addRoute = fn(r, method:str, pattern:str, handler:fn) {
	r copy { routes: r.routes :+ Route { method: method, pattern: pattern, handler: handler } }
}

/**
 * registers a `HEAD` route on `r` and returns the updated router.
 */
@export
@returns('@struct(Router)')
val head = fn(r, pattern:str, handler:fn) { addRoute(r, "HEAD", pattern, handler) }

/**
 * registers a `GET` route on `r` and returns the updated router.
 */
@export
@returns('@struct(Router)')
val get = fn(r, pattern:str, handler:fn) { addRoute(r, "GET", pattern, handler) }

/**
 * registers a `POST` route on `r` and returns the updated router.
 */
@export
@returns('@struct(Router)')
val post = fn(r, pattern:str, handler:fn) { addRoute(r, "POST", pattern, handler) }

/**
 * mounts `handler` at `prefix/*`, matching any method.
 *
 * The path remainder after the prefix is available as `req.params["*"]`.
 */
@export
@returns('@struct(Router)')
val mount = fn(r, prefix:str, handler:fn) {
	addRoute(r, "*", prefix + "/*", handler)
}

/**
 * mounts a child `Router` at `prefix`, handling paths relative to the prefix.
 *
 * Equivalent to `mount(r, prefix, subrouter(childRouter))`.
 */
@export
@returns('@struct(Router)')
val mountRouter = fn(r, prefix:str, childRouter) {
	mount(r, prefix, subrouter(childRouter))
}

// --- dispatch ---

/**
 * dispatches `request` through the router's routes and returns a `Response`.
 *
 * Returns a 404 Not Found response if no route matches.
 * Route handlers receive the request with `params` populated from URL pattern segments.
 */
@export
@returns('@struct(Response)')
val handle = fn(request, r) {
	match handleRequest(r.routes, request) {
		nil      => notFound()
		response => response
	}
}

// --- internals ---

val handleRequest = fn(routes:list, request) match {
	[[], ...] => nil
	[[route, ...t], ...] => {
		if (route.method == request.method || route.method == "*") {
			match matchRoutePattern(route.pattern, request.path) {
				nil    => recur(t, request)
				params => request /> withParams(params) /> route.handler
			}
		} else {
			recur(t, request)
		}
	}
}

val matchRoutePattern = fn(pattern, path) {
	if (pattern /> endsWith("/*")) {
		val base = pattern[0:-2]
		if (path == base) {
			{ "*": "" }
		} else if (path /> startsWith(base + "/")) {
			{ "*": path[len(base):] }
		} else {
			nil
		}
	} else {
		val ps = pattern /> split("/")
		val xs = path    /> split("/")
		if (len(ps) != len(xs)) {
			nil
		} else {
			ps /> zip(xs) /> reduce({}, fn(params, pair) {
				val p = pair[0]
				val x = pair[1]
				if (p == nil) {
					params
				} else if (p /> startsWith(":")) {
					params /> put(p[1:], x)
				} else if (p == x) {
					params
				} else {
					nil
				}
			})
		}
	}
}

// --- subrouters ---

/**
 * wraps a `Router` as a handler function for use with `mount`.
 *
 * Strips the mount prefix from the path and clears the `"*"` param
 * before dispatching to the inner router.
 */
@export
@returns('@fn')
val subrouter = fn(router) {
	fn(req) {
		var rest = req.params["*"]
		if (rest == nil || rest == "") { rest = "/" }
		if (rest[0:1] != "/") { rest = "/" + rest }
		req
		/> withPath(rest)
		/> withoutParam("*")
		/> handle(router)
	}
}

// --- static file handler ---

/**
 * returns a handler that serves static files from `dir`.
 *
 * Intended for use with `mount`: `mount("/static", static("public"))`.
 * Files are served with the appropriate `Content-Type` based on extension
 * and cached for `cacheTimeSeconds` seconds (default 1 hour).
 *
 * Returns 404 for missing files, path traversal attempts (`..`), and
 * non-GET/HEAD requests. `HEAD` requests return headers without a body.
 */
@export
@returns('@fn')
val static = fn(dir, cacheTimeSeconds = 3600) {
	fn(req) {
		defer onerror(err) notFound()

		if (req.method != "GET" && req.method != "HEAD") {
			nil
		} else {
			var rel = req.params["*"]
			if (rel == nil || rel == "" || rel == "/") { rel = "/index.html" }
			if (rel[0:1] == "/") { rel = rel[1:] }

			if (!isSafeRelPath(rel)) {
				notFound()
			} else {
				val full = joinPath(dir, rel)
				val body = readFile(full)
				match req.method {
					"HEAD" => html("")
					_      => html(body)
				}
				/> withContentType(rel /> ext /> contentType)
				/> cacheSeconds(cacheTimeSeconds)
			}
		}
	}
}

val ext = fn(path) {
	val i = path /> lastIndexOf(".")
	if (i < 0) { "" } else { path[i:] }
}

val contentType = fn(path) match {
	".css"  => "text/css; charset=utf-8"
	".js"   => "text/javascript; charset=utf-8"
	".html" => "text/html; charset=utf-8"
	".htm"  => "text/html; charset=utf-8"
	".txt"  => "text/plain; charset=utf-8"
	".svg"  => "image/svg+xml"
	".json" => "application/json; charset=utf-8"
	".png"  => "image/png"
	".jpg"  => "image/jpeg"
	".jpeg" => "image/jpeg"
	".gif"  => "image/gif"
	".ico"  => "image/x-icon"
	_       => "application/octet-stream"
}

val isSafeRelPath = fn(p) { !(p /> contains("..")) }

val joinPath = fn(dir, rel) {
	if (dir /> endsWith("/")) { dir + rel } else { dir + "/" + rel }
}

// --- middleware ---

/**
 * wraps `handler` with request/response logging to stdout.
 *
 * Logs timestamp, method, elapsed time (ms), status code, path, and
 * any request ID / trace ID / span ID present on the request.
 */
@export
@returns('@fn')
val withLog = fn(handler) {
	fn(req) {
		val d   = delta(clock)
		val res = handler(req)
		val ts  = fmtClock(clock(), "2006-01-02 15:04:05.000")
		var msg = []
		if (req.requestId) { msg = msg :+ req.requestId }
		if (req.traceId)   { msg = msg :+ req.traceId }
		if (req.spanId)    { msg = msg :+ req.spanId }
		msg = msg :+ req.path
		fmt("{} [ {:<4s} ] {:d}ms {:d} {:s}", ts, req.method, d(), res.status, msg /> join(" ")) /> err.println
		res
	}
}

/**
 * wraps `handler` with a timeout of `ms` milliseconds.
 *
 * If the handler does not return within the timeout, a `TimeoutError` is thrown.
 */
@export
@returns('@fn')
val withTimeout = fn(h, ms) {
	fn(req) {
		val task = spawn { h(req) }
		await(task, ms)
	}
}

/**
 * wraps `handler` so that any thrown error returns a 500 Server Error response.
 *
 * Use as the outermost middleware layer to prevent unhandled errors from
 * crashing the connection.
 */
@export
@returns('@fn')
val withRecover = fn(h) {
	fn(req) {
		defer onerror(err) { serverError() }
		h(req)
	}
}

/**
 * wraps `handler` to add a fixed response header to every response.
 */
@export
@returns('@fn')
val withHeader = fn(handler:fn, header:str, value:str) {
	fn(req) {
		req /> handler /> withHeader(header, value)
	}
}

/**
 * wraps `handler` to attach a request ID to every request and response.
 *
 * Uses the incoming `X-Request-Id` header if present, otherwise generates
 * a new random hex ID. The ID is attached to `req.requestId` and returned
 * as the `X-Request-Id` response header.
 */
@export
@returns('@fn')
val withRequestId = fn(handler:fn, newRequestId:fn = fn() { randomHexString(32) }) {
	fn(req) {
		var rid = req.headers["x-request-id"]
		if (rid == nil) { rid = newRequestId() }

		val res = req copy { requestId: rid } /> handler

		if (res != nil) {
			res /> withHeader("X-Request-Id", rid)
		} else {
			res
		}
	}
}

/**
 * wraps `handler` to propagate W3C `traceparent` trace context.
 *
 * Extracts or generates a `traceId` and creates a new `spanId` for each
 * request. Attaches both to `req.traceId` and `req.spanId`. Returns the
 * `traceparent` header on the response for downstream propagation.
 *
 * Format: `00-<traceId>-<spanId>-01`
 */
@export
@returns('@fn')
val withTraceContext = fn(
	handler,
	newTraceId:fn = fn() { randomHexString(32) },
	newSpanId:fn  = fn() { randomHexString(16) }
) {
	fn(req) {
		val tp = req.headers["traceparent"]
		var traceId  = ""
		var parentId = ""

		if (tp != nil) {
			val parts = tp /> split("-")
			if (len(parts) >= 3) {
				traceId  = parts[1]
				parentId = parts[2]
			}
		}

		if (traceId == "") { traceId = newTraceId() }

		val currentSpanId    = newSpanId()
		val newTraceParent   = "00-" + traceId + "-" + currentSpanId + "-01"
		val res              = req copy { traceId: traceId, spanId: currentSpanId } /> handler

		if (res != nil) {
			res /> withHeader("traceparent", newTraceParent)
		} else {
			res
		}
	}
}

/**
 * wraps `handler` to enforce a maximum request body size.
 *
 * Checks `Content-Length` for `POST`, `PUT`, and `PATCH` requests.
 * Returns 413 Payload Too Large if the declared size exceeds `maxBytes`.
 * Default limit is 1MB (1_048_576 bytes).
 */
@export
@returns('@fn')
val withMaxBody = fn(h, maxBytes = 1_048_576) {
	fn(req) {
		if (req.method == "POST" || req.method == "PUT" || req.method == "PATCH") {
			val cl = req.headers["content-length"]
			if (cl != nil) {
				val n = cl /> toNumber
				if (n > maxBytes) {
					return payloadTooLarge()
				}
			}
		}
		h(req)
	}
}
