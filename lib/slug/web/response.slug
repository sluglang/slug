/**
 * slug.web.response — HTTP response construction and formatting
 *
 * Provides the `Response` and `Reply` structs, constructor helpers for
 * all common HTTP status codes, header management, cookie support,
 * HTMX helpers, and HTTP wire-format serialisation.
 *
 * ## Quick start
 *
 * ```slug
 * val { ok, html, jsonOk, notFound, redirect, withHeader } = import("slug.web.response")
 *
 * // simple text response
 * ok("Hello, World!")
 *
 * // HTML response
 * html("<h1>Hello</h1>")
 *
 * // JSON response
 * jsonOk({ name: "Alice", age: 30 })
 *
 * // chaining modifiers
 * ok("done")
 * /> withHeader("x-custom", "value")
 * /> noCache
 * ```
 *
 * ## Response struct
 *
 * `Response{ status, headers, body }` — header names are always lowercase.
 * Use `withHeader`, `withHeaders`, `addHeader`, and `withoutHeader` to
 * manage headers rather than constructing the map directly.
 *
 * ## Reply struct
 *
 * `Reply` is a higher-level descriptor used with the views layer.
 * It carries a view name, optional HTMX fragment name, template data,
 * status code, and extra headers. Pass a `Reply` to `renderReply` in
 * `slug.web.views` to produce a `Response`.
 *
 * ## Cookie options
 *
 * The `cookie` function accepts an `opts` map with optional keys:
 * `path`, `domain`, `maxAge`, `expires`, `secure` (@bool), `httpOnly` (@bool),
 * `sameSite` (`"Lax"` | `"Strict"` | `"None"`).
 *
 * ## HTMX
 *
 * `hxTrigger`, `hxRedirect`, and `hxRetarget` add the corresponding
 * HTMX response headers (`HX-Trigger`, `HX-Redirect`, `HX-Retarget`).
 */

val {*} = import(
	"slug.list",
	"slug.string",
	"slug.std",
)
val json = import("slug.json")

// --- response shapes ---

/**
 * higher-level view descriptor for use with `slug.web.views#renderReply`.
 *
 * Set `fragment` to render an HTMX partial instead of the full page.
 * Extra `headers` are merged into the final response.
 */
@export val Reply = struct {
	view:str,
	fragment:str,
	data:map    = {},
	status:num  = 200,
	headers:map = {},
}

/**
 * raw HTTP response value. Construct via the helper functions, not directly.
 *
 * Header names are always normalised to lowercase.
 */
@export val Response = struct {
	status:num,
	headers:map,
	body,
}

val FormattedResponse = struct {
	head:str,
	body,
}

// --- core constructors ---

/**
 * constructs a `Response` with the given status and body.
 */
@export
val response = fn(status:num, body:str):Response {
	Response { status: status, headers: {}, body: body }
}

/**
 * 200 OK response.
 */
@export
val ok = fn(body:str):Response { response(200, body) }

/**
 * 201 Created response.
 */
@export
val created = fn(body:str):Response { response(201, body) }

/**
 * 202 Accepted response.
 */
@export
val accepted = fn(body:str):Response { response(202, body) }

/**
 * 204 No Content response.
 */
@export
val noContent = fn():Response { response(204, "") }

/**
 * 400 Bad Request response.
 */
@export
val badRequest = fn(body:str):Response { response(400, body) }

/**
 * 401 Unauthorized response.
 */
@export
val unauthorized = fn(body:str):Response { response(401, body) }

/**
 * 403 Forbidden response.
 */
@export
val forbidden = fn(body:str):Response { response(403, body) }

/**
 * 404 Not Found response.
 */
@export
val notFound = fn(body:str = "404 Not Found"):Response { response(404, body) }

/**
 * 409 Conflict response.
 */
@export
val conflict = fn(body:str):Response { response(409, body) }

/**
 * 413 Payload Too Large response. Also sets `Connection: close`.
 */
@export
val payloadTooLarge = fn(body:str = "413 Payload Too Large"):Response {
	response(413, body) /> withHeader("Connection", "close")
}

/**
 * 500 Internal Server Error response.
 */
@export
val serverError = fn(body:str = "500 Server Error"):Response { response(500, body) }

// --- basic modifiers ---

/**
 * returns a new response with `status` replaced.
 */
@export
val withStatus = fn(res, status:num):Response {
	res copy { status: status }
}

/**
 * returns a new response with `body` replaced.
 */
@export
val withBody = fn(res, body:str):Response {
	res copy { body: body }
}

/**
 * returns true if the response has a header with the given key.
 *
 * Key comparison is case-insensitive.
 */
@export
val hasHeader = fn(res, key):bool {
	res.headers[normKey(key)] != nil
}

/**
 * returns a new response with `key` set to `value`, replacing any existing value.
 *
 * Header keys are normalised to lowercase.
 */
@export
val withHeader = fn(res, key:str, value:str):Response {
	val k  = normKey(key)
	val hs = res.headers /> put(k, value)
	res copy { headers: hs }
}

/**
 * returns a new response with all headers from `headersMap` applied.
 *
 * Each key is normalised to lowercase. Existing headers with the same
 * key are replaced.
 */
@export
val withHeaders = fn(res, headersMap:map):Response {
	headersMap /> keys /> reduce(res, fn(acc, rawKey) {
		acc /> withHeader(rawKey, headersMap[rawKey])
	})
}

/**
 * returns a new response with `key` removed from headers.
 */
@export
val withoutHeader = fn(res, key:str):Response {
	res copy { headers: remove(res.headers, normKey(key)) }
}

/**
 * adds a header value without replacing existing values for the same key.
 *
 * Upgrades a single string value to a list when a second value is added.
 * This is the correct way to set multiple `Set-Cookie` headers.
 */
@export
val addHeader = fn(res, key:str, value:str):Response {
	val k    = normKey(key)
	val cur  = res.headers /> get(k)
	val next = toList(cur) :+ value
	res copy { headers: res.headers /> put(k, next) }
}

// --- content helpers ---

/**
 * sets the `content-type` header.
 */
@export
val withContentType = fn(res, ct:str):Response {
	withHeader(res, "content-type", ct)
}

/**
 * 200 OK response with `Content-Type: text/html; charset=utf-8`.
 */
@export
val html = fn(markup:str):Response {
	ok(markup) /> withContentType("text/html; charset=utf-8")
}

/**
 * 200 OK response with `Content-Type: text/plain; charset=utf-8`.
 */
@export
val text = fn(txt:str):Response {
	ok(txt) /> withContentType("text/plain; charset=utf-8")
}

/**
 * 200 OK response with JSON-encoded `value` and `Content-Type: application/json`.
 */
@export
val jsonOk = fn(value):Response {
	ok(json.encode(value)) /> withContentType("application/json; charset=utf-8")
}

// --- redirects ---

/**
 * 302 Found redirect to `location`.
 */
@export
val redirect = fn(location:str):Response {
	response(302, "") /> withHeader("location", location)
}

/**
 * 301 Moved Permanently redirect to `location`.
 */
@export
val redirectPermanent = fn(location:str):Response {
	response(301, "") /> withHeader("location", location)
}

// --- cache control ---

/**
 * sets headers to prevent all caching.
 */
@export
val noCache = fn(res):Response {
	res
	/> withHeader("cache-control", "no-store, no-cache, must-revalidate")
	/> withHeader("pragma", "no-cache")
	/> withHeader("expires", "0")
}

/**
 * sets `Cache-Control: public, max-age=<seconds>`.
 */
@export
val cacheSeconds = fn(res, seconds:num):Response {
	withHeader(res, "cache-control", "public, max-age=" + seconds)
}

// --- connection ---

/**
 * sets `Connection: close`.
 */
@export
val withConnClose = fn(res):Response {
	res /> withHeader("Connection", "close")
}

/**
 * sets `Connection: keep-alive`.
 */
@export
val withConnKeepAlive = fn(res):Response {
	res /> withHeader("Connection", "keep-alive")
}

// --- HTMX helpers ---

/**
 * sets the `HX-Trigger` response header to trigger a client-side event.
 */
@export
val hxTrigger = fn(res, eventName:str):Response {
	withHeader(res, "hx-trigger", eventName)
}

/**
 * sets the `HX-Redirect` response header for a client-side redirect.
 */
@export
val hxRedirect = fn(res, location:str):Response {
	withHeader(res, "hx-redirect", location)
}

/**
 * sets the `HX-Retarget` response header to override the HTMX swap target.
 */
@export
val hxRetarget = fn(res, selector:str):Response {
	withHeader(res, "hx-retarget", selector)
}

// --- cookies ---

/**
 * builds a `Set-Cookie` header value string.
 *
 * `opts` may contain: `path`, `domain`, `maxAge`, `expires`,
 * `secure` (@bool), `httpOnly` (@bool), `sameSite` (`"Lax"|"Strict"|"None"`).
 */
@export
val cookie = fn(name:str, value:str, opts:map):str {
	var parts = [name + "=" + value]
	if (get(opts, "path")     != nil)   { parts = parts :+ "Path="     + get(opts, "path") }
	if (get(opts, "domain")   != nil)   { parts = parts :+ "Domain="   + get(opts, "domain") }
	if (get(opts, "maxAge")   != nil)   { parts = parts :+ "Max-Age="  + get(opts, "maxAge") }
	if (get(opts, "expires")  != nil)   { parts = parts :+ "Expires="  + get(opts, "expires") }
	if (get(opts, "secure")   == true)  { parts = parts :+ "Secure" }
	if (get(opts, "httpOnly") == true)  { parts = parts :+ "HttpOnly" }
	if (get(opts, "sameSite") != nil)   { parts = parts :+ "SameSite=" + get(opts, "sameSite") }
	import("slug.string").join(parts, "; ")
}

/**
 * adds a `Set-Cookie` header to `res` using `cookie(name, value, opts)`.
 *
 * Multiple cookies can be set by calling `setCookie` repeatedly —
 * `addHeader` semantics ensure values are not clobbered.
 */
@export
val setCookie = fn(res, name:str, value:str, opts:map):Response {
	addHeader(res, "set-cookie", cookie(name, value, opts))
}

/**
 * expires a cookie immediately by setting `Max-Age=0`.
 */
@export
val clearCookie = fn(res, name:str, opts:map):Response {
	setCookie(res, name, "", put(opts, "maxAge", 0))
}

// --- introspection ---

/**
 * returns true if `x` is a `Response` struct instance.
 */
@export
val isResponse = fn(x):bool match {
	Response { status, headers, body } => true
	_ => false
}

/**
 * returns true if `x` is a `FormattedResponse` struct instance.
 */
@export
val isFormattedResponse = fn(x):bool match {
	FormattedResponse { head, body } => true
	_ => false
}

/**
 * returns the status code of a response.
 */
@export
val status = fn(res):num { res.status }

/**
 * returns the headers map of a response.
 */
@export
val headers = fn(res):map { res.headers }

/**
 * returns the body of a response.
 */
@export val body = fn(res) { res.body }

// --- HTTP wire format ---

/**
 * formats the response head (status line + headers) as an HTTP/1.1 string.
 *
 * Automatically adds `Content-Length` if not already present.
 */
@export
val formatHead = fn(res):str {
	val r          = ensureContentLength(res)
	val statusLine = "HTTP/1.1 " + r.status + " " + reasonPhrase(r.status) + "\r\n"
	val headerLines = formatAllHeaderLines(r)
	statusLine + join(headerLines, "") + "\r\n"
}

/**
 * formats a response into a `FormattedResponse{ head, body }`.
 *
 * Automatically adds `Content-Length` if not already present.
 */
@export
val formatResponse = fn(res):FormattedResponse {
	val r = ensureContentLength(res)
	FormattedResponse { head: formatHead(r), body: r.body }
}

/**
 * renders a response to a complete HTTP/1.1 wire-format string (head + body).
 */
@export
val renderResponse = fn(res):str {
	res /> formatResponse /> match {
		FormattedResponse { head, body } => head + body
	}
}

// --- internals ---

val normKey = fn(k) { k /> toLower /> trim }

val toList = fn(x) {
	match x /> type {
		^NIL_TYPE  => []
		^LIST_TYPE => x
		_          => [x]
	}
}

val reasonPhrase = fn(status) match {
	200 => "OK"
	201 => "Created"
	202 => "Accepted"
	204 => "No Content"
	301 => "Moved Permanently"
	302 => "Found"
	400 => "Bad Request"
	401 => "Unauthorized"
	403 => "Forbidden"
	404 => "Not Found"
	409 => "Conflict"
	413 => "Payload Too Large"
	500 => "Internal Server Error"
	_   => ""
}

val ensureContentLength = fn(res) {
	if (hasHeader(res, "content-length")) {
		res
	} else {
		withHeader(res, "content-length", len(res.body) /> toString)
	}
}

val formatHeaderLines = fn(key, rawVal) {
	val k = normKey(key)
	match rawVal /> type {
		^LIST_TYPE => rawVal /> map(fn(v) { k + ": " + v + "\r\n" })
		^NIL_TYPE  => []
		_          => [k + ": " + rawVal + "\r\n"]
	}
}

val formatAllHeaderLines = fn(res) {
	val ks = res.headers /> keys /> sort
	ks /> flatMap(fn(k) { formatHeaderLines(k, get(res.headers, k)) })
}
