var {*} = import (
	"slug.list",
	"slug.string",
	"slug.std",
)
var json = import("slug.json")

// -------------------------------
// Response shapes (struct-based)
// -------------------------------

@export
val Reply = struct {
	@str view,
	@str fragment,
	@map data = {},
	@num status = 200,
	@map headers = {},
}

@export
val Response = struct {
	@num status,
	@map headers,
	body,
}

val FormattedResponse = struct {
	@str head,
	body,
}

// ------------------
// Core constructors
// ------------------

@export
@returns('@struct(Response)')
var response = fn(@num status, @str body) {
	Response { status: status, headers: {}, body: body }
}

@export
@returns('@struct(Response)')
var ok = fn(@str body) { response(200, body) }

@export
@returns('@struct(Response)')
var created = fn(@str body) { response(201, body) }

@export
@returns('@struct(Response)')
var accepted = fn(@str body) { response(202, body) }

@export
@returns('@struct(Response)')
var noContent = fn() { response(204, "") }

@export
@returns('@struct(Response)')
var badRequest = fn(@str body) { response(400, body) }

@export
@returns('@struct(Response)')
var unauthorized = fn(@str body) { response(401, body) }

@export
@returns('@struct(Response)')
var forbidden = fn(@str body) { response(403, body) }

@export
@returns('@struct(Response)')
var notFound = fn(@str body = "404 Not Found") { response(404, body) }

@export
@returns('@struct(Response)')
var conflict = fn(@str body) { response(409, body) }

@export
@returns('@struct(Response)')
var payloadTooLarge = fn(@str body = "413 Payload Too Large") { response(413, body) /> withHeader("Connection", "close") }

@export
@returns('@struct(Response)')
var serverError = fn(@str body = "500 Server Error") { response(500, body) }


// ------------------
// Basic modifiers
// ------------------

@export
@returns('@struct(Response)')
var withStatus = fn(res, @num status) {
  res copy { status: status }
}

@export
@returns('@struct(Response)')
var withBody = fn(res, @str body) {
  res copy { body: body }
}

@export
@returns('@struct(Response)')
var hasHeader = fn(res, key) {
  res.headers[normKey(key)] != nil
}

// Replace a header (single-value semantics)
@export
@returns('@struct(Response)')
var withHeader = fn(res, @str key, @str value) {
  var k = normKey(key)
  var v = normVal(value)
  var hs = res.headers /> put(k, v)
  res copy { headers: hs }
}

// Replace many headers from a map
@export
@returns('@struct(Response)')
var withHeaders = fn(res, @map headersMap) {
  // fold over keys so we normalize each header name
  headersMap /> keys /> reduce(res, fn(acc, rawKey) {
	acc /> withHeader(rawKey, headersMap[rawKey])
  })
}

// Remove a header entirely
@export
@returns('@struct(Response)')
var withoutHeader = fn(res, @str key) {
  var k = normKey(key)
  var hs = remove(res.headers, k)
  res copy { headers: hs }
}


// ------------------
// Repeated headers
// ------------------

// Add a header value without clobbering existing values.
// Upgrades string -> list[string] when needed.
@export
@returns('@struct(Response)')
var addHeader = fn(res, @str key, @str value) {
  var k = normKey(key)
  var v = normVal(value)

  var cur = res.headers /> get(k)
  var next = toList(cur) :+ v

  var hs = res.headers /> put(k, next)
  res copy { headers: hs }
}

var addSetCookie = fn(res, @str cookieStr) {
  addHeader(res, "set-cookie", cookieStr)
}


// ------------------
// Content helpers
// ------------------

@export
@returns('@struct(Response)')
var withContentType = fn(res, @str ct) {
  withHeader(res, "content-type", ct)
}

@export
@returns('@struct(Response)')
var html = fn(@str markup) {
  ok(markup)
  /> withContentType("text/html; charset=utf-8")
}

@export
@returns('@struct(Response)')
var text = fn(@str txt) {
  ok(txt)
  /> withContentType("text/plain; charset=utf-8")
}

@export
@returns('@struct(Response)')
var jsonOk = fn(value) {
  ok(json.encode(value))
  /> withContentType("application/json; charset=utf-8")
}


// ------------------
// Redirects
// ------------------

@export
@returns('@struct(Response)')
var redirect = fn(@str location) {
  response(302, "")
  /> withHeader("location", location)
}

@export
@returns('@struct(Response)')
var redirectPermanent = fn(@str location) {
  response(301, "")
  /> withHeader("location", location)
}


// ------------------
// Cache control
// ------------------

@export
@returns('@struct(Response)')
var noCache = fn(res) {
  res
  /> withHeader("cache-control", "no-store, no-cache, must-revalidate")
  /> withHeader("pragma", "no-cache")
  /> withHeader("expires", "0")
}

@export
@returns('@struct(Response)')
var cacheSeconds = fn(res, @num seconds) {
  withHeader(res, "cache-control", "public, max-age=" + seconds)
}


// ------------------
// connection
// ------------------

@export
@returns('@struct(Response)')
var withConnClose = fn(res) {
  res /> withHeader("Connection", "close")
}

@export
@returns('@struct(Response)')
var withConnKeepAlive = fn(res) {
  res /> withHeader("Connection", "keep-alive")
}

// ------------------
// HTMX helpers
// ------------------

@export
@returns('@struct(Response)')
var hxTrigger = fn(res, @str eventName) {
  withHeader(res, "hx-trigger", eventName)
}

@export
@returns('@struct(Response)')
var hxRedirect = fn(res, @str location) {
  withHeader(res, "hx-redirect", location)
}

@export
@returns('@struct(Response)')
var hxRetarget = fn(res, @str selector) {
  withHeader(res, "hx-retarget", selector)
}


// ------------------
// Cookies (string builder + helpers)
// ------------------

@export
@returns('@str')
var cookie = fn(@str name, @str value, @map opts) {
  // opts (all optional):
  // {path, domain, maxAge, expires, secure, httpOnly, sameSite}
  // sameSite: "Lax" | "Strict" | "None"

  var parts = [ name + "=" + value ]

  if (get(opts, "path") != nil)      { parts = parts :+ "Path=" + get(opts, "path") }
  if (get(opts, "domain") != nil)    { parts = parts :+ "Domain=" + get(opts, "domain") }
  if (get(opts, "maxAge") != nil)    { parts = parts :+ "Max-Age=" + get(opts, "maxAge") }
  if (get(opts, "expires") != nil)   { parts = parts :+ "Expires=" + get(opts, "expires") } // format upstream
  if (get(opts, "secure") == true)   { parts = parts :+ "Secure" }
  if (get(opts, "httpOnly") == true) { parts = parts :+ "HttpOnly" }
  if (get(opts, "sameSite") != nil)  { parts = parts :+ "SameSite=" + get(opts, "sameSite") }

  string.join(parts, "; ")
}

@export
@returns('@struct(Response)')
var setCookie = fn(res, @str name, @str value, @map opts) {
  addSetCookie(res, cookie(name, value, opts))
}

@export
@returns('@struct(Response)')
var clearCookie = fn(res, @str name, @map opts) {
  // expire immediately
  setCookie(res, name, "", put(opts, "maxAge", 0))
}


// ------------------
// Introspection
// ------------------

@export
@returns('@bool')
var isResponse = fn(x) match { Response { status, headers, body } => true _ => false }

@export
@returns('@bool')
var isFormattedResponse = fn(x) match { FormattedResponse { head, body } => true _ => false }

@export
@returns('@num')
var status = fn(res) { res.status }

@export
@returns('@map')
var headers = fn(res) { res.headers }

@export
var body = fn(res) { res.body }

// -------------------------
// Public: formatHead / formatResponse
// -------------------------

@export
@returns('@str')
var formatHead = fn(res) {

  var r = ensureContentLength(res)

  var statusLine =
	"HTTP/1.1 " + r.status + " " + reasonPhrase(r.status) + "\r\n"

  var headerLines = formatAllHeaderLines(r)
  var headersText = join(headerLines, "")

  statusLine + headersText + "\r\n"
}

@export
@returns('@struct(FormattedResponse)')
var formatResponse = fn(res) {
  // keep response shaping separate from formatting (adds content-length)
  var r = ensureContentLength(res)

  FormattedResponse { head: formatHead(r), body: r.body }
}

@export
@returns('@struct(FormattedResponse)')
var renderResponse = fn(res) {
	res /> formatResponse /> match {
		FormattedResponse { head, body } => head + body
	}
}


// ----------
// Internals
// ----------


var normKey = fn(k) {
  k /> toLower /> trim
}

var normVal = fn(v) {
  // Keep strict: expect string. If you want coercion, do it explicitly.
  v
}

// Convert header value to list form for appending
var toList = fn(x) {
  match x /> type {
	^NIL_TYPE  => []
	^LIST_TYPE => x
	_          => [x]
  }
}

// Keep it small; fall back to empty/unknown if missing.
var reasonPhrase = fn(status) match {
  200 => "OK"
  201 => "Created"
  202 => "Accepted"
  204 => "No Content"

  301 => "Moved Permanently"
  302 => "Found"

  400 => "Bad Request"
  401 => "Unauthorized"
  403 => "Forbidden"
  404 => "Not Found"
  409 => "Conflict"

  500 => "Internal Server Error"
  _   => ""
}

// -------------------------
// Header formatting helpers
// -------------------------

// Ensure Content-Length exists for string bodies (unless already provided).
var ensureContentLength = fn(res) {
  if (hasHeader(res, "content-length")) {
	res
  } else {
	// If you later support bytes, compute byte length, not char length.
	var n = len(res.body) /> toString
	withHeader(res, "content-length", n)
  }
}

// Convert one header entry into one-or-many header lines (with CRLF).
var formatHeaderLines = fn(key, rawVal) {
  var k = normKey(key)

  match rawVal /> type {
	^LIST_TYPE => {
	  // each value becomes its own header line
	  rawVal /> map(fn(v) { k + ": " + v + "\r\n" })
	}
	^NIL_TYPE => {
	  []
	}
	_ => {
	  [ k + ": " + rawVal + "\r\n" ]
	}
  }
}

// Return a list of header lines, deterministically ordered by key.
var formatAllHeaderLines = fn(res) {
  var ks = res.headers /> keys /> sort

  // flatten list[list[string]] -> list[string]
  ks /> flatMap(fn(k) {
	formatHeaderLines(k, get(res.headers, k))
  })
}
