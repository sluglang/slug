/**
 * slug.json — JSON encoding and decoding
 *
 * A pure Slug implementation of JSON serialisation and deserialisation
 * conforming to RFC 8259.
 *
 * ## Type mapping
 *
 * | Slug type   | JSON type  | Notes                                      |
 * |-------------|------------|--------------------------------------------|
 * | `@str`      | string     |                                            |
 * | `@num`      | number     |                                            |
 * | `@bool`     | boolean    |                                            |
 * | `nil`       | null       |                                            |
 * | `@list`     | array      |                                            |
 * | `@map`      | object     | keys serialised as strings; sorted         |
 * | `@sym`      | string     | symbol label used as string value          |
 * | `@bytes`    | string     | encoded as `"b64:<base64>"` prefix string  |
 *
 * ## Key handling
 *
 * Object keys are always serialised as strings. Both symbol keys (`:name`)
 * and string keys (`"name"`) are supported on encode. On decode, all
 * object keys are returned as string keys — use dot access (`m.name`) or
 * string bracket access (`m["name"]`) to read decoded values.
 *
 * ## Bytes encoding
 *
 * `@bytes` values are encoded as `"b64:<base64>"` strings. On decode,
 * any string with this prefix is automatically decoded back to `@bytes`.
 */

val {*} = import(
	"slug.string",
	"slug.std",
	"slug.list",
	"slug.bytes",
)

val Token = struct {
	@str type,
	value = nil,
}

val ParseResult = struct {
	value,
	@num nextIdx,
}

// ===========================
// Public API
// ===========================

/**
 * encodes a Slug value as a compact JSON string.
 *
 * Map keys are sorted alphabetically. Symbols are encoded as their label
 * string. Bytes are encoded as `"b64:<base64>"`. Structs are not supported
 * and will throw `JsonError`.
 */
@testWith(
	["hello"], "\"hello\"",
	[42], "42",
	[true], "true",
	[false], "false",
	[nil], "null",
	[0x"ff"], "\"b64:/w==\"",
	[[1, 2, 3]], "[1,2,3]",
	[{:type: :fn, :age: 30}], "{\"age\":30,\"type\":\"fn\"}",
	[{:name: "Alice", :age: 30}], "{\"age\":30,\"name\":\"Alice\"}",
	[{"name": "Alice", "age": 30}], "{\"age\":30,\"name\":\"Alice\"}",
)
@export
@returns('@str')
@throws('@struct(Error{type:JsonError})')
val encode = fn(v) {
	match (type(v)) {
		^STRING_TYPE  => encodeString(v)
		^SYMBOL_TYPE  => encodeSymbol(v)
		^BYTES_TYPE   => encodeBytes(v)
		^NUMBER_TYPE  => encodeNumber(v)
		^BOOLEAN_TYPE => encodeBool(v)
		^NIL_TYPE     => "null"
		^LIST_TYPE    => encodeList(v)
		^MAP_TYPE     => encodeObject(v)
		_ => error("json: unsupported type for encode: " + type(v))
	}
}

/**
 * encodes a Slug value as a pretty-printed JSON string.
 *
 * The `indent` parameter controls the number of spaces per indentation
 * level. Follows the same type mapping as `encode`.
 */
@testWith(
	["hello", 2], "\"hello\"",
	[[1, 2, 3], 4], "[\n    1,\n    2,\n    3\n]",
	[0x"ff", 2], "\"b64:/w==\"",
	[{:type: :fn, :age: 30}, 2], "{\n  \"age\": 30,\n  \"type\": \"fn\"\n}",
	[{:name: "Alice", :age: 30}, 2], "{\n  \"age\": 30,\n  \"name\": \"Alice\"\n}",
	[{"name": "Alice", "age": 30}, 2], "{\n  \"age\": 30,\n  \"name\": \"Alice\"\n}",
)
@export
@returns('@str')
@throws('@struct(Error{type:JsonError})')
val pretty = fn(v, @num indent = 2) {
	prettyPrint(v, indent, 0)
}

/**
 * decodes a JSON string into a Slug value.
 *
 * Object keys are always decoded as string keys. Use dot access (`m.name`)
 * or string bracket access (`m["name"]`) to read fields — never symbol
 * bracket access (`m[:name]`).
 *
 * Strings with the `b64:` prefix are decoded to `@bytes` values.
 * Throws `JsonError` on malformed input.
 */
@testWith(
	["\"hello\""], "hello",
	["42"], 42,
	["true"], true,
	["false"], false,
	["null"], nil,
	["[1,2,3]"], [1, 2, 3],
	["\"b64:Zm9v\""], 0x"666f6f",
	["{\"name\":\"Alice\",\"age\":30}"], {"name": "Alice", "age": 30},
)
@export
@throws('@struct(Error{type:JsonError})')
val decode = fn(@str jsonStr) {
	val tokens = tokenize(jsonStr, 0, len(jsonStr), [])
	val result = parseValue(tokens, 0)

	if (result.nextIdx < len(tokens)) {
		error("json: unexpected token at position " + result.nextIdx)
	}

	result.value
}

// ===========================
// Encoding Helpers
// ===========================

val encodeString = fn(@str s) {
	val escaped = s /> replaceAll("\\", "\\\\")
		/> replaceAll("\"", "\\\"")
		/> replaceAll("\n", "\\n")
		/> replaceAll("\r", "\\r")
		/> replaceAll("\t", "\\t")
		/> replaceAll("\b", "\\b")
		/> replaceAll("\f", "\\f")
	"\"" + escaped + "\""
}

val encodeSymbol = fn(s) {
	encodeString(label(s))
}

val encodeBytes = fn(@bytes b) {
	encodeString("b64:" + base64Encode(b))
}

val encodeNumber = fn(@num n) {
	toString(n)
}

val encodeBool = fn(@bool b) match {
	true => "true"
	_ => "false"
}

val encodeList = fn(@list lst) {
	"[" + encodeListItems(lst, "") + "]"
}

val encodeListItems = fn(@list lst, @str acc) match {
	[[], ...] => acc
	[[h], ...] => acc + encode(h)
	[[h, ...t], ...] => recur(t, acc + encode(h) + ",")
}

val encodeObject = fn(@map m) {
	val pairs = sortedObjectPairs(m)
	"{" + encodeObjectPairs(pairs, m, "") + "}"
}

val encodeObjectPairs = fn(@list pairs, @map m, @str acc) match {
	[[], ...] => acc
	[[p], ...] => {
		val keyStr = p[0]
		val key = p[1]
		acc + encodeString(keyStr) + ":" + encode(m[key])
	}
	[[p, ...rest], ...] => {
		val keyStr = p[0]
		val key = p[1]
		recur(rest, m, acc + encodeString(keyStr) + ":" + encode(m[key]) + ",")
	}
}

// ===========================
// Pretty Printing
// ===========================

val prettyPrint = fn(v, @num indent, @num depth) {
	match (type(v)) {
		^STRING_TYPE  => encodeString(v)
		^SYMBOL_TYPE  => encodeSymbol(v)
		^BYTES_TYPE   => encodeBytes(v)
		^NUMBER_TYPE  => encodeNumber(v)
		^BOOLEAN_TYPE => encodeBool(v)
		^NIL_TYPE     => "null"
		^LIST_TYPE    => prettyList(v, indent, depth)
		^MAP_TYPE     => prettyObject(v, indent, depth)
		_ => error("json: unsupported type for pretty: " + type(v))
	}
}

val prettyList = fn(@list lst, @num indent, @num depth) {
	if (len(lst) == 0) {
		"[]"
	} else {
		val innerIndent = makeIndent(indent, depth + 1)
		val outerIndent = makeIndent(indent, depth)
		"[\n" + prettyListItems(lst, indent, depth + 1, innerIndent, "") + "\n" + outerIndent + "]"
	}
}

val prettyListItems = fn(@list lst, @num indent, @num depth, @str indentStr, @str acc) match {
	[[], ...] => acc
	[[h], ...] => acc + indentStr + prettyPrint(h, indent, depth)
	[[h, ...t], ...] => recur(t, indent, depth, indentStr, acc + indentStr + prettyPrint(h, indent, depth) + ",\n")
}

val prettyObject = fn(@map m, @num indent, @num depth) {
	val pairs = sortedObjectPairs(m)
	if (len(pairs) == 0) {
		"{}"
	} else {
		val innerIndent = makeIndent(indent, depth + 1)
		val outerIndent = makeIndent(indent, depth)
		"{\n" + prettyObjectPairs(pairs, m, indent, depth + 1, innerIndent, "") + "\n" + outerIndent + "}"
	}
}

val prettyObjectPairs = fn(@list pairs, @map m, @num indent, @num depth, @str indentStr, @str acc) {
	match pairs {
		[] => acc
		[p] => {
			val keyStr = p[0]
			val key = p[1]
			acc + indentStr + encodeString(keyStr) + ": " + prettyPrint(m[key], indent, depth)
		}
		[p, ...rest] => {
			val keyStr = p[0]
			val key = p[1]
			recur(rest, m, indent, depth, indentStr,
				acc + indentStr + encodeString(keyStr) + ": " + prettyPrint(m[key], indent, depth) + ",\n")
		}
	}
}

val makeIndent = fn(@num spaces, @num depth) {
	" " * spaces * depth
}

val decodeStringValue = fn(@str value) {
	if (value /> startsWith("b64:")) {
		base64Decode(value[4:])
	} else {
		value
	}
}

val keyToString = fn(k) {
	match (type(k)) {
		^STRING_TYPE => k
		^SYMBOL_TYPE => label(k)
		_ => error("json: map keys must be strings or symbols, got: " + type(k))
	}
}

val sortedObjectPairs = fn(@map m) {
	val pairs = m /> keys /> map(fn(k) { [keyToString(k), k] })
	sortWithComparator(pairs, fn(a, b) { compare(a[0], b[0]) })
}

// ===========================
// Tokenizer
// ===========================

val tokenize = fn(@str s, @num i, @num n, @list tokens) {
	if (i >= n) {
		tokens
	} else {
		val c = s[i]
		if (isWhitespace(c)) {
			recur(s, i + 1, n, tokens)
		} else if (c == "{") {
			recur(s, i + 1, n, tokens :+ Token { type: "lbrace" })
		} else if (c == "}") {
			recur(s, i + 1, n, tokens :+ Token { type: "rbrace" })
		} else if (c == "[") {
			recur(s, i + 1, n, tokens :+ Token { type: "lbracket" })
		} else if (c == "]") {
			recur(s, i + 1, n, tokens :+ Token { type: "rbracket" })
		} else if (c == ":") {
			recur(s, i + 1, n, tokens :+ Token { type: "colon" })
		} else if (c == ",") {
			recur(s, i + 1, n, tokens :+ Token { type: "comma" })
		} else if (c == "\"") {
			val result = parseStringToken(s, i + 1, n, "")
			recur(s, result.nextIdx, n, tokens :+ Token { type: "string", value: result.value })
		} else if (c == "t") {
			if (i + 4 <= n && s[i:i+4] == "true") {
				recur(s, i + 4, n, tokens :+ Token { type: "true" })
			} else {
				error("json: invalid token at position " + i)
			}
		} else if (c == "f") {
			if (i + 5 <= n && s[i:i+5] == "false") {
				recur(s, i + 5, n, tokens :+ Token { type: "false" })
			} else {
				error("json: invalid token at position " + i)
			}
		} else if (c == "n") {
			if (i + 4 <= n && s[i:i+4] == "null") {
				recur(s, i + 4, n, tokens :+ Token { type: "null" })
			} else {
				error("json: invalid token at position " + i)
			}
		} else if (isDigit(c) || c == "-") {
			val result = parseNumberToken(s, i, n)
			recur(s, result.nextIdx, n, tokens :+ Token { type: "number", value: result.value })
		} else {
			error("json: unexpected character '" + c + "' at position " + i)
		}
	}
}

val error = fn(@str msg) {
	throw Error { type: "JsonError", msg: msg }
}

val isWhitespace = fn(@str c) {
	c == " " || c == "\n" || c == "\r" || c == "\t"
}

val isDigit = fn(@str c) {
	c >= "0" && c <= "9"
}

val parseStringToken = fn(@str s, @num i, @num n, @str acc) {
	if (i >= n) {
		error("json: unterminated string")
	} else {
		val c = s[i]
		if (c == "\"") {
			ParseResult { value: acc, nextIdx: i + 1 }
		} else if (c == "\\") {
			if (i + 1 >= n) {
				error("json: unterminated escape sequence")
			} else {
				val nextChar = s[i + 1]
				val unescaped = match nextChar {
					"\"" => "\""
					"\\" => "\\"
					"/" => "/"
					"b" => "\b"
					"f" => "\f"
					"n" => "\n"
					"r" => "\r"
					"t" => "\t"
					"u" => {
						val unicodeResult = parseUnicodeEscape(s, i + 2, n)
						return recur(s, unicodeResult.nextIdx, n, acc + unicodeResult.value)
					}
					_ => error("json: invalid escape sequence \\" + nextChar)
				}
				recur(s, i + 2, n, acc + unescaped)
			}
		} else if (isControlChar(c)) {
			error("json: unescaped control character in string")
		} else {
			recur(s, i + 1, n, acc + c)
		}
	}
}

val parseUnicodeEscape = fn(@str s, @num i, @num n) {
	if (i + 4 > n) {
		error("json: invalid unicode escape, expected 4 hex digits")
	}

	val hi   = parseHexToNumber(s, i, i + 4, 0)
	val next = i + 4

	if (isHighSurrogate(hi)) {
		if (next + 6 > n || s[next] != "\\" || s[next + 1] != "u") {
			error("json: invalid unicode escape, lone high surrogate")
		}
		val lo = parseHexToNumber(s, next + 2, next + 6, 0)
		if (!isLowSurrogate(lo)) {
			error("json: invalid unicode escape, expected low surrogate after high surrogate")
		}
		val codePoint = 65536 + ((hi - 55296) * 1024) + (lo - 56320)
		ParseResult { value: fromCodePoint(codePoint), nextIdx: next + 6 }
	} else if (isLowSurrogate(hi)) {
		error("json: invalid unicode escape, lone low surrogate")
	} else {
		ParseResult { value: fromCodePoint(hi), nextIdx: next }
	}
}

val parseHexToNumber = fn(@str s, @num i, @num end, @num acc) {
	if (i >= end) {
		acc
	} else {
		val c = s[i]
		if (!isHexDigit(c)) {
			error("json: invalid unicode escape, expected hex digit but got '" + c + "'")
		}
		recur(s, i + 1, end, acc * 16 + hexDigitToNumber(c))
	}
}

val isHexDigit = fn(@str c) {
	("0123456789ABCDEF" /> indexOf(c /> toUpper())) >= 0
}

val hexDigitToNumber = fn(@str c) {
	"0123456789ABCDEF" /> indexOf(c /> toUpper())
}

val isHighSurrogate = fn(@num n) { n >= 55296 && n <= 56319 }
val isLowSurrogate  = fn(@num n) { n >= 56320 && n <= 57343 }
val isControlChar   = fn(@str c) { c < " " }

val parseNumberToken = fn(@str s, @num i, @num n) {
	val afterSign = if (i < n && s[i] == "-") { i + 1 } else { i }

	if (afterSign >= n || !isDigit(s[afterSign])) {
		error("json: invalid number at position " + i)
	} else {
		val afterInt = if (s[afterSign] == "0") {
			val j = afterSign + 1
			if (j < n && isDigit(s[j])) {
				error("json: invalid number, leading zeros not allowed at position " + i)
			}
			j
		} else {
			skipDigits(s, afterSign, n)
		}

		val afterDecimal = if (afterInt < n && s[afterInt] == ".") {
			val j = afterInt + 1
			if (j >= n || !isDigit(s[j])) {
				error("json: invalid number, expected digit after decimal point")
			}
			skipDigits(s, j, n)
		} else {
			afterInt
		}

		val afterExp = if (afterDecimal < n && (s[afterDecimal] == "e" || s[afterDecimal] == "E")) {
			val j = afterDecimal + 1
			val j2 = if (j < n && (s[j] == "+" || s[j] == "-")) { j + 1 } else { j }
			if (j2 >= n || !isDigit(s[j2])) {
				error("json: invalid number, expected digit in exponent")
			}
			skipDigits(s, j2, n)
		} else {
			afterDecimal
		}

		ParseResult { value: toNumber(s[i:afterExp]), nextIdx: afterExp }
	}
}

val skipDigits = fn(@str s, @num i, @num n) {
	if (i >= n || !isDigit(s[i])) { i } else { recur(s, i + 1, n) }
}

// ===========================
// Parser
// ===========================

val parseValue = fn(@list tokens, @num idx) {
	if (idx >= len(tokens)) {
		error("json: unexpected end of input")
	} else {
		val token = tokens[idx]
		match token.type {
			"string"   => ParseResult { value: decodeStringValue(token.value), nextIdx: idx + 1 }
			"number"   => ParseResult { value: token.value, nextIdx: idx + 1 }
			"true"     => ParseResult { value: true, nextIdx: idx + 1 }
			"false"    => ParseResult { value: false, nextIdx: idx + 1 }
			"null"     => ParseResult { value: nil, nextIdx: idx + 1 }
			"lbracket" => parseArray(tokens, idx + 1, [], false)
			"lbrace"   => parseObject(tokens, idx + 1, {}, false)
			_          => error("json: unexpected token " + token.type + " at position " + idx)
		}
	}
}

val parseArray = fn(@list tokens, @num idx, @list acc, @bool afterComma) {
	if (idx >= len(tokens)) {
		error("json: unexpected end of array")
	} else {
		val token = tokens[idx]
		if (token.type == "rbracket") {
			if (afterComma) {
				error("json: trailing comma not allowed in array")
			} else {
				ParseResult { value: acc, nextIdx: idx + 1 }
			}
		} else {
			val result   = parseValue(tokens, idx)
			val newAcc   = acc :+ result.value
			val nextIdx  = result.nextIdx
			if (nextIdx >= len(tokens)) {
				error("json: unexpected end of array")
			} else {
				val nextToken = tokens[nextIdx]
				if (nextToken.type == "comma") {
					recur(tokens, nextIdx + 1, newAcc, true)
				} else if (nextToken.type == "rbracket") {
					ParseResult { value: newAcc, nextIdx: nextIdx + 1 }
				} else {
					error("json: expected comma or ] in array")
				}
			}
		}
	}
}

val parseObject = fn(@list tokens, @num idx, @map acc, @bool afterComma) {
	if (idx >= len(tokens)) {
		error("json: unexpected end of object")
	} else {
		val token = tokens[idx]
		if (token.type == "rbrace") {
			if (afterComma) {
				error("json: trailing comma not allowed in object")
			} else {
				ParseResult { value: acc, nextIdx: idx + 1 }
			}
		} else if (token.type == "string") {
			val key     = token.value
			val nextIdx = idx + 1
			if (nextIdx >= len(tokens) || tokens[nextIdx].type != "colon") {
				error("json: expected colon after object key")
			} else {
				val result       = parseValue(tokens, nextIdx + 1)
				val newAcc       = acc /> put(key, result.value)
				val afterValueIdx = result.nextIdx
				if (afterValueIdx >= len(tokens)) {
					error("json: unexpected end of object")
				} else {
					val nextToken = tokens[afterValueIdx]
					if (nextToken.type == "comma") {
						recur(tokens, afterValueIdx + 1, newAcc, true)
					} else if (nextToken.type == "rbrace") {
						ParseResult { value: newAcc, nextIdx: afterValueIdx + 1 }
					} else {
						error("json: expected comma or } in object")
					}
				}
			}
		} else {
			error("json: expected string key or } in object")
		}
	}
}
