var {*} = import(
	"slug.string",
	"slug.std",
	"slug.list",
	"slug.bytes",
)

val Token = struct {
	@str type,
	value = nil,
}

val ParseResult = struct {
	value,
	@num nextIdx,
}

// ===========================
// Public API
// ===========================

@testWith(
	["hello"], "\"hello\"",
	[42], "42",
	[true], "true",
	[false], "false",
	[nil], "null",
	[0x"ff"], "\"b64:/w==\"",
	[[1, 2, 3]], "[1,2,3]",
	[{:type: :fn, :age: 30}], "{\"age\":30,\"type\":\"fn\"}",
	[{:name: "Alice", :age: 30}], "{\"age\":30,\"name\":\"Alice\"}",
	[{"name": "Alice", "age": 30}], "{\"age\":30,\"name\":\"Alice\"}",
)
@export
@returns('@str')
var encode = fn(v) {
	match (type(v)) {
		^STRING_TYPE  => encodeString(v)
		^SYMBOL_TYPE  => encodeSymbol(v)
		^BYTES_TYPE   => encodeBytes(v)
		^NUMBER_TYPE  => encodeNumber(v)
		^BOOLEAN_TYPE => encodeBool(v)
		^NIL_TYPE     => "null"
		^LIST_TYPE    => encodeList(v)
		^MAP_TYPE     => encodeObject(v)
		_ => error("json: unsupported type for encode: " + type(v))
	}
}

@testWith(
	["hello", 2], "\"hello\"",
	[[1, 2, 3], 4], "[\n    1,\n    2,\n    3\n]",
	[0x"ff", 2], "\"b64:/w==\"",
	[{:type: :fn, :age: 30}, 2], "{\n  \"age\": 30,\n  \"type\": \"fn\"\n}",
	[{:name: "Alice", :age: 30}, 2], "{\n  \"age\": 30,\n  \"name\": \"Alice\"\n}",
	[{"name": "Alice", "age": 30}, 2], "{\n  \"age\": 30,\n  \"name\": \"Alice\"\n}",
)
@export
@returns('@str')
var pretty = fn(v, @num indent = 2) {
	prettyPrint(v, indent, 0)
}

/**
 * decodes a JSON string; object keys are decoded as string keys, not symbols; use map['key'] not map[:key] for
 * JSON-decoded maps.
 */
@testWith(
	["\"hello\""], "hello",
	["42"], 42,
	["true"], true,
	["false"], false,
	["null"], nil,
	["[1,2,3]"], [1, 2, 3],
	["\"b64:Zm9v\""], 0x"666f6f",
	["{\"name\":\"Alice\",\"age\":30}"], {"name": "Alice", "age": 30},
)
@export
var decode = fn(@str jsonStr) {
	var tokens = tokenize(jsonStr, 0, len(jsonStr), [])
	var result = parseValue(tokens, 0)

	if (result.nextIdx < len(tokens)) {
		error("json: unexpected token at position " + result.nextIdx)
	}

	result.value
}

// ===========================
// Encoding Helpers
// ===========================

var encodeString = fn(@str s) {
	var escaped = s /> replaceAll("\\", "\\\\")
		/> replaceAll("\"", "\\\"")
		/> replaceAll("\n", "\\n")
		/> replaceAll("\r", "\\r")
		/> replaceAll("\t", "\\t")
		/> replaceAll("\b", "\\b")
		/> replaceAll("\f", "\\f")
	"\"" + escaped + "\""
}

var encodeSymbol = fn(s) {
	encodeString(label(s))
}

var encodeBytes = fn(@bytes b) {
	encodeString("b64:" + base64Encode(b))
}

var encodeNumber = fn(@num n) {
	toString(n)
}

var encodeBool = fn(@bool b) match {
	true => "true"
	_ => "false"
}

var encodeList = fn(@list lst) {
	"[" + encodeListItems(lst, "") + "]"
}

var encodeListItems = fn(@list lst, @str acc) match {
	[[], ...] => acc
	[[h], ...] => acc + encode(h)
	[[h, ...t], ...] => recur(t, acc + encode(h) + ",")
}

var encodeObject = fn(@map m) {
	var pairs = sortedObjectPairs(m)
	"{" + encodeObjectPairs(pairs, m, "") + "}"
}

var encodeObjectPairs = fn(@list pairs, @map m, @str acc) match {
	[[], ...] => acc
	[[p], ...] => {
		var keyStr = p[0]
		var key = p[1]
		acc + encodeString(keyStr) + ":" + encode(m[key])
	}
	[[p, ...rest], ...] => {
		var keyStr = p[0]
		var key = p[1]
		recur(rest, m, acc + encodeString(keyStr) + ":" + encode(m[key]) + ",")
	}
}

// ===========================
// Pretty Printing
// ===========================

var prettyPrint = fn(v, @num indent, @num depth) {
	match (type(v)) {
		^STRING_TYPE  => encodeString(v)
		^SYMBOL_TYPE  => encodeSymbol(v)
		^BYTES_TYPE   => encodeBytes(v)
		^NUMBER_TYPE  => encodeNumber(v)
		^BOOLEAN_TYPE => encodeBool(v)
		^NIL_TYPE     => "null"
		^LIST_TYPE    => prettyList(v, indent, depth)
		^MAP_TYPE     => prettyObject(v, indent, depth)
		_ => error("json: unsupported type for pretty: " + type(v))
	}
}

var prettyList = fn(@list lst, @num indent, @num depth) {
	if (len(lst) == 0) {
		"[]"
	} else {
		var innerIndent = makeIndent(indent, depth + 1)
		var outerIndent = makeIndent(indent, depth)
		"[\n" + prettyListItems(lst, indent, depth + 1, innerIndent, "") + "\n" + outerIndent + "]"
	}
}

var prettyListItems = fn(@list lst, @num indent, @num depth, @str indentStr, @str acc) match {
	[[], ...] => acc
	[[h], ...] => acc + indentStr + prettyPrint(h, indent, depth)
	[[h, ...t], ...] => recur(t, indent, depth, indentStr, acc + indentStr + prettyPrint(h, indent, depth) + ",\n")
}

var prettyObject = fn(@map m, @num indent, @num depth) {
	var pairs = sortedObjectPairs(m)
	if (len(pairs) == 0) {
		"{}"
	} else {
		var innerIndent = makeIndent(indent, depth + 1)
		var outerIndent = makeIndent(indent, depth)
		"{\n" + prettyObjectPairs(pairs, m, indent, depth + 1, innerIndent, "") + "\n" + outerIndent + "}"
	}
}

var prettyObjectPairs = fn(@list pairs, @map m, @num indent, @num depth, @str indentStr, @str acc) {
	match pairs {
		[] => acc
		[p] => {
			var keyStr = p[0]
			var key = p[1]
			acc + indentStr + encodeString(keyStr) + ": " + prettyPrint(m[key], indent, depth)
		}
		[p, ...rest] => {
			var keyStr = p[0]
			var key = p[1]
			recur(rest, m, indent, depth, indentStr,
				acc + indentStr + encodeString(keyStr) + ": " + prettyPrint(m[key], indent, depth) + ",\n")
		}
	}
}

var makeIndent = fn(@num spaces, @num depth) {
	" " * spaces * depth
}

var decodeStringValue = fn(@str value) {
	if (value /> startsWith("b64:")) {
		base64Decode(value[4:])
	} else {
		value
	}
}

var keyToString = fn(k) {
	match (type(k)) {
		^STRING_TYPE => k
		^SYMBOL_TYPE => label(k)
		_ => error("json: map keys must be strings or symbols, got: " + type(k))
	}
}

var sortedObjectPairs = fn(@map m) {
	var pairs = m /> keys /> map(fn(k) {
		[keyToString(k), k]
	})
	sortWithComparator(pairs, fn(a, b) {
		compare(a[0], b[0])
	})
}

// ===========================
// Tokenizer
// ===========================

var tokenize = fn(@str s, @num i, @num n, @list tokens) {
	if (i >= n) {
		tokens
	} else {
		var c = s[i]

		if (isWhitespace(c)) {
			recur(s, i + 1, n, tokens)
		} else if (c == "{") {
			recur(s, i + 1, n, tokens :+ Token { type: "lbrace" })
		} else if (c == "}") {
			recur(s, i + 1, n, tokens :+ Token { type: "rbrace" })
		} else if (c == "[") {
			recur(s, i + 1, n, tokens :+ Token { type: "lbracket" })
		} else if (c == "]") {
			recur(s, i + 1, n, tokens :+ Token { type: "rbracket" })
		} else if (c == ":") {
			recur(s, i + 1, n, tokens :+ Token { type: "colon" })
		} else if (c == ",") {
			recur(s, i + 1, n, tokens :+ Token { type: "comma" })
		} else if (c == "\"") {
			var result = parseStringToken(s, i + 1, n, "")
			recur(s, result.nextIdx, n, tokens :+ Token { type: "string", value: result.value })
		} else if (c == "t") {
			if (i + 4 <= n && s[i:i+4] == "true") {
				recur(s, i + 4, n, tokens :+ Token { type: "true" })
			} else {
				error("json: invalid token at position " + i)
			}
		} else if (c == "f") {
			if (i + 5 <= n && s[i:i+5] == "false") {
				recur(s, i + 5, n, tokens :+ Token { type: "false" })
			} else {
				error("json: invalid token at position " + i)
			}
		} else if (c == "n") {
			if (i + 4 <= n && s[i:i+4] == "null") {
				recur(s, i + 4, n, tokens :+ Token { type: "null" })
			} else {
				error("json: invalid token at position " + i)
			}
		} else if (isDigit(c) || c == "-") {
			var result = parseNumberToken(s, i, n)
			recur(s, result.nextIdx, n, tokens :+ Token { type: "number", value: result.value })
		} else {
			error("json: unexpected character '" + c + "' at position " + i)
		}
	}
}

var error = fn(@str msg) {
	throw Error { type: "JsonError", msg: msg }
}

var isWhitespace = fn(@str c) {
	c == " " || c == "\n" || c == "\r" || c == "\t"
}

var isDigit = fn(@str c) {
	c >= "0" && c <= "9"
}

var parseStringToken = fn(@str s, @num i, @num n, @str acc) {
	if (i >= n) {
		error("json: unterminated string")
	} else {
		var c = s[i]

		if (c == "\"") {
			ParseResult { value: acc, nextIdx: i + 1 }
		} else if (c == "\\") {
			if (i + 1 >= n) {
				error("json: unterminated escape sequence")
			} else {
				var nextChar = s[i + 1]
				var unescaped = match nextChar {
					"\"" => "\""
					"\\" => "\\"
					"/" => "/"
					"b" => "\b"
					"f" => "\f"
					"n" => "\n"
					"r" => "\r"
					"t" => "\t"
					"u" => {
						var unicodeResult = parseUnicodeEscape(s, i + 2, n)
						return recur(s, unicodeResult.nextIdx, n, acc + unicodeResult.value)
					}
					_ => error("json: invalid escape sequence \\" + nextChar)
				}
				recur(s, i + 2, n, acc + unescaped)
			}
		} else if (isControlChar(c)) {
			error("json: unescaped control character in string")
		} else {
			recur(s, i + 1, n, acc + c)
		}
	}
}

var parseUnicodeEscape = fn(@str s, @num i, @num n) {
	if (i + 4 > n) {
		error("json: invalid unicode escape, expected 4 hex digits")
	}

	var hi = parseHexToNumber(s, i, i + 4, 0)
	var next = i + 4

	if (isHighSurrogate(hi)) {
		if (next + 6 > n || s[next] != "\\" || s[next + 1] != "u") {
			error("json: invalid unicode escape, lone high surrogate")
		}
		var lo = parseHexToNumber(s, next + 2, next + 6, 0)
		if (!isLowSurrogate(lo)) {
			error("json: invalid unicode escape, expected low surrogate after high surrogate")
		}
		var codePoint = 65536 + ((hi - 55296) * 1024) + (lo - 56320)
		ParseResult { value: fromCodePoint(codePoint), nextIdx: next + 6 }
	} else if (isLowSurrogate(hi)) {
		error("json: invalid unicode escape, lone low surrogate")
	} else {
		ParseResult { value: fromCodePoint(hi), nextIdx: next }
	}
}

var parseHexToNumber = fn(@str s, @num i, @num end, @num acc) {
	if (i >= end) {
		acc
	} else {
		var c = s[i]
		if (!isHexDigit(c)) {
			error("json: invalid unicode escape, expected hex digit but got '" + c + "'")
		}
		recur(s, i + 1, end, acc * 16 + hexDigitToNumber(c))
	}
}

var isHexDigit = fn(@str c) {
	("0123456789ABCDEF" /> indexOf(c /> toUpper())) >= 0
}

var hexDigitToNumber = fn(@str c) {
	"0123456789ABCDEF" /> indexOf(c /> toUpper())
}

var isHighSurrogate = fn(@num n) {
	n >= 55296 && n <= 56319
}

var isLowSurrogate = fn(@num n) {
	n >= 56320 && n <= 57343
}

var isControlChar = fn(@str c) {
	c < " "
}

var parseNumberToken = fn(@str s, @num i, @num n) {
	var j = i

	// Handle negative sign
	if (j < n && s[j] == "-") {
		j = j + 1
	}

	// Parse integer part
	if (j >= n || !isDigit(s[j])) {
		error("json: invalid number at position " + i)
	} else {
		if (s[j] == "0") {
			j = j + 1
			if (j < n && isDigit(s[j])) {
				error("json: invalid number, leading zeros are not allowed at position " + i)
			}
		} else {
			j = skipDigits(s, j, n)
		}
		// Parse decimal part if present
		if (j < n && s[j] == ".") {
			j = j + 1
			if (j >= n || !isDigit(s[j])) {
				error("json: invalid number, expected digit after decimal point")
			} else {
				j = skipDigits(s, j, n)
			}
		}

		// Parse exponent if present
		if (j < n && (s[j] == "e" || s[j] == "E")) {
			j = j + 1
			if (j < n && (s[j] == "+" || s[j] == "-")) {
				j = j + 1
			}
			if (j >= n || !isDigit(s[j])) {
				error("json: invalid number, expected digit in exponent")
			} else {
				j = skipDigits(s, j, n)
			}
		}

		var numStr = s[i:j]
		ParseResult { value: toNumber(numStr), nextIdx: j }
	}
}

var skipDigits = fn(@str s, @num i, @num n) {
	if (i >= n || !isDigit(s[i])) {
		i
	} else {
		recur(s, i + 1, n)
	}
}

// ===========================
// Parser
// ===========================

var parseValue = fn(@list tokens, @num idx) {
	if (idx >= len(tokens)) {
		error("json: unexpected end of input")
	} else {
		var token = tokens[idx]
		var tokenType = token.type

		match tokenType {
			"string" => return ParseResult { value: decodeStringValue(token.value), nextIdx: idx + 1 }
			"number" => return ParseResult { value: token.value, nextIdx: idx + 1 }
			"true" => return ParseResult { value: true, nextIdx: idx + 1 }
			"false" => return ParseResult { value: false, nextIdx: idx + 1 }
			"null" => return ParseResult { value: nil, nextIdx: idx + 1 }
			"lbracket" => parseArray(tokens, idx + 1, [], false)
			"lbrace" => parseObject(tokens, idx + 1, {}, false)
			_ => error("json: unexpected token " + tokenType + " at position " + idx)
		}
	}
}

var parseArray = fn(@list tokens, @num idx, @list acc, @bool afterComma) {
	if (idx >= len(tokens)) {
		error("json: unexpected end of array")
	} else {
		var token = tokens[idx]

		if (token.type == "rbracket") {
			if (afterComma) {
				error("json: trailing comma not allowed in array")
			} else {
				ParseResult { value: acc, nextIdx: idx + 1 }
			}
		} else {
			var result = parseValue(tokens, idx)
			var newAcc = acc :+ result.value
			var nextIdx = result.nextIdx

			if (nextIdx >= len(tokens)) {
				error("json: unexpected end of array")
			} else {
				var nextToken = tokens[nextIdx]

				if (nextToken.type == "comma") {
					recur(tokens, nextIdx + 1, newAcc, true)
				} else if (nextToken.type == "rbracket") {
					ParseResult { value: newAcc, nextIdx: nextIdx + 1 }
				} else {
					error("json: expected comma or ] in array")
				}
			}
		}
	}
}


var parseObject = fn(@list tokens, @num idx, @map acc, @bool afterComma) {
	if (idx >= len(tokens)) {
		error("json: unexpected end of object")
	} else {
		var token = tokens[idx]

		if (token.type == "rbrace") {
			if (afterComma) {
				error("json: trailing comma not allowed in object")
			} else {
				ParseResult { value: acc, nextIdx: idx + 1 }
			}
		} else if (token.type == "string") {
			var key = token.value
			var nextIdx = idx + 1

			if (nextIdx >= len(tokens) || tokens[nextIdx].type != "colon") {
				error("json: expected colon after object key")
			} else {
				var result = parseValue(tokens, nextIdx + 1)
				var newAcc = acc /> put(key, result.value)
				var afterValueIdx = result.nextIdx

				if (afterValueIdx >= len(tokens)) {
					error("json: unexpected end of object")
				} else {
					var nextToken = tokens[afterValueIdx]

					if (nextToken.type == "comma") {
						recur(tokens, afterValueIdx + 1, newAcc, true)
					} else if (nextToken.type == "rbrace") {
						ParseResult { value: newAcc, nextIdx: afterValueIdx + 1 }
					} else {
						error("json: expected comma or } in object")
					}
				}
			}
		} else {
			error("json: expected string key or } in object")
		}
	}
}
