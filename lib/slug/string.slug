/**
 * slug.string — string manipulation utilities
 *
 * Trimming, splitting, joining, searching, replacing, case conversion,
 * padding, case formatting, and random string generation.
 *
 * All functions treat strings as sequences of Unicode code points where
 * relevant (e.g. `indexOf` is Unicode-aware).
 */

val {*} = import(
	"slug.std",
	"slug.math",
)

/**
 * removes leading and trailing whitespace from a string.
 *
 * Returns `nil` for `nil` input.
 */
@testWith(
	[nil],       nil,
	[""],        "",
	[" slug "],  "slug",
)
@export
@returns('@str')
foreign trim = fn(str:str)

/**
 * removes all leading and trailing occurrences of `prefix` from `s`.
 *
 * Repeatedly strips the prefix/suffix until neither end matches.
 * Note: `prefix` is stripped from both ends, not just the left.
 */
@testWith(
	['  a  ', ' '],   'a',
	['xxaxxx', 'x'],  'a',
	['xxa', 'x'],     'a',
	['axxx', 'x'],    'a',
	['abxxx', 'xx'],  'abx',
)
@export
@returns('@str')
val trim = fn(s:str, prefix:str) {
	match s {
		nil => nil
		_ if s[0:len(prefix)] == prefix           => recur(s[len(prefix):], prefix)
		_ if s[-len(prefix):len(s)] == prefix     => recur(s[0:-len(prefix)], prefix)
		_ => s
	}
}

/**
 * returns the byte index of the first occurrence of `seq` in `str` at or after `index`.
 *
 * Returns `-1` if not found. Unicode-aware.
 */
@testWith(
	["hello slug", "lu"],       7,
	["hello slug", "l"],        2,
	["hello slug", "l", 2 + 1], 3,
	["hello slug", "l", 4],     7,
	["éé|éé", "|"],             2,
)
@export
@returns('@num')
foreign indexOf = fn(str:str, seq:str, index:num = 0)

/**
 * returns the index of the last occurrence of `seq` in `str`.
 *
 * Returns `-1` if not found.
 */
@testWith(
	["hello slug", "l"], 7,
	["hello slug", "h"], 0,
	["hello slug", "g"], 9,
)
@export
@returns('@num')
val lastIndexOf = fn(str:str, seq:str, index:num = 0, prev = -1) {
	val i = indexOf(str, seq, index)
	if (i == -1) { prev } else { recur(str, seq, i + 1, i) }
}

/**
 * converts a string to uppercase.
 */
@testWith(
	[nil],    nil,
	[""],     "",
	["slug"], "SLUG",
)
@export
@returns('@str')
foreign toUpper = fn(str:str)

/**
 * converts a string to lowercase.
 */
@testWith(
	[nil],    nil,
	[""],     "",
	["SLUG"], "slug",
)
@export
@returns('@str')
foreign toLower = fn(str:str)

/**
 * returns the string corresponding to a Unicode code point.
 */
@testWith(
	[65],     "A",
	[129315], "🤣",
)
@export
@returns('@str')
foreign fromCodePoint = fn(codePoint:num)

/**
 * returns true if `seq` appears anywhere in `str`.
 */
@testWith(
	["hello slug", "slug"],  true,
	["hello slug", "snail"], false,
)
@export
@returns('@bool')
val contains = fn(str:str, seq:str) {
	str /> indexOf(seq) >= 0
}

/**
 * returns true if any on the `seq` strings appear in `str`.
 */
@testWith(
	["hello slug", "slug"],  true,
	["hello slug", "snail", "fish"], false,
)
@export
@returns('@bool')
val containsAny = fn(str:str, ...seq) {
	fn(i:num) {
		match contains(str, seq[i]) {
			false if i <= 0 => false
			false           => recur( i - 1 )
			_               => true
		}
	}(len(seq) - 1)
}

/**
 * returns true if `str` begins with `start`.
 */
@testWith(
	["hello slug", "slug"],  false,
	["hello slug", "hello"], true,
)
@export
@returns('@bool')
val startsWith = fn(str:str, start:str) {
	str[0:len(start)] == start
}

/**
 * returns true if `str` ends with `end`.
 */
@testWith(
	["hello slug", "slug"],  true,
	["hello slug", "hello"], false,
)
@export
@returns('@bool')
val endsWith = fn(str:str, end:str) {
	str[len(str) - len(end):] == end
}

/**
 * returns true if `str` is non-empty and entirely uppercase.
 */
@testWith(
	[nil],   false,
	[""],    false,
	["slug"], false,
	["SLUG"], true,
)
@export
@returns('@bool')
val isUpper = fn(str:str) {
	str != nil && len(str) > 0 && str == str /> toUpper()
}

/**
 * returns true if `str` is non-empty and entirely lowercase.
 */
@testWith(
	[nil],   false,
	[""],    false,
	["slug"], true,
	["SLUG"], false,
)
@export
@returns('@bool')
val isLower = fn(str:str) {
	str != nil && len(str) > 0 && str == str /> toLower()
}

/**
 * splits `str` on `delimiter`, returning a list of substrings.
 *
 * `max` limits the number of splits performed; `-1` means unlimited.
 * The remaining unsplit portion is always included as the last element.
 *
 * `count` and `strs` are internal accumulators — do not pass them directly.
 */
@testWith(
	["slug/test", "/"],    ["slug", "test"],
	["éé|éé", "|"],       ["éé", "éé"],
	["a|b|c", "|", 2],    ["a", "b|c"],
)
@export
@returns('@list')
val split = fn(str:str, delimiter:str, max:num = -1, count:num = 1, strs:list = []) {
	match str /> indexOf(delimiter) {
		n if n >= 0 && (max < 0 || count < max) => {
			val i = n + delimiter /> len()
			recur(str[i:], delimiter, max, count + 1, strs :+ str[0:n])
		}
		_ => strs :+ str
	}
}

/**
 * joins a list of strings with `delimiter` between each element.
 *
 * Returns an empty string for an empty list.
 */
@testWith(
	[[], "."],          "",
	[["slug"], "."],    "slug",
	[["slug","test"], "."], "slug.test",
)
@export
@returns('@str')
val join = fn(strs:list, delimiter:str = "", str:str = nil) match {
	[[], ...] if str == nil => ""
	[[], ...]               => str
	[[h, ...t], ...] if str == nil => recur(t, delimiter, h)
	[[h, ...t], ...]               => recur(t, delimiter, str + delimiter + h)
}

/**
 * replaces all occurrences of `replace` in `str` with `with`.
 *
 * Returns `nil` for `nil` input.
 */
@testWith(
	[nil, "/", "."],           nil,
	["slug/test", "/", "."],   "slug.test",
	["slug", "/", "."],        "slug",
	["E &amp; S", "&amp;", "&"], "E & S",
)
@export
@returns('@str')
val replaceAll = fn(str:str, replace:str, with:str) match {
	[nil, ...] => nil
	[...]      => str /> split(replace) /> join(with)
}

/**
 * pads `str` on the right with `with` until it reaches `length`.
 *
 * Returns `str` unchanged if already at or above `length`.
 */
@export
@returns('@str')
val padRight = fn(str:str, with:str, length:num) {
	if (length <= len(str)) { str } else { recur(str + with, with, length) }
}

/**
 * pads `str` on the left with `with` until it reaches `length`.
 *
 * Returns `str` unchanged if already at or above `length`.
 */
@export
@returns('@str')
val padLeft = fn(str:str, with:str, length:num) {
	if (length <= len(str)) { str } else { recur(with + str, with, length) }
}

/**
 * generates a random string of `length` characters drawn from `chars`.
 *
 * @effects('random')
 */
@export
@effects('random')
@returns('@str')
val randomString = fn(length:num, chars:str, acc:str = "") match {
	[0, ...] => acc
	_        => recur(length - 1, chars, acc + chars[rndRange(0, len(chars))])
}

/**
 * generates a random lowercase hex string of `length` characters.
 *
 * @effects('random')
 */
@export
@effects('random')
@returns('@str')
val randomHexString = fn(length:num) {
	randomString(length, "0123456789abcdef")
}

/**
 * converts a string to `snake_case` by replacing `sep` with `_`.
 *
 * Pass `screaming: true` for `SCREAMING_SNAKE_CASE`.
 */
@testWith(
	['LAST NAME', ' ', true], 'LAST_NAME',
	['last name', ' ', true], 'LAST_NAME',
	['LAST NAME'],            'LAST_NAME',
	['last name'],            'last_name',
	['l'],                    'l',
	['l n'],                  'l_n',
	['l   n'],                'l___n',
)
@export
@returns('@str')
val snakeCase = fn(s:str, sep:str = ' ', screaming = false) {
	s
	/> fn(s) { if (screaming) { toUpper(s) } else { s } }
	/> split(sep)
	/> join("_")
}

/**
 * converts a string to `kebab-case` by replacing `sep` with `-`.
 */
@testWith(
	['LAST NAME'], 'LAST-NAME',
	['last name'], 'last-name',
	['l'],         'l',
	['l n'],       'l-n',
	['l   n'],     'l---n',
)
@export
@returns('@str')
val kebabCase = fn(s:str, sep:str = ' ') {
	s /> split(sep) /> join("-")
}

/**
 * converts a string to `PascalCase`, capitalising the first letter of each word.
 */
@testWith(
	['LAST NAME'], 'LastName',
	['last name'], 'LastName',
	['l'],         'L',
	['l n'],       'LN',
	['l   n'],     'LN',
)
@export
@returns('@str')
val pascalCase = fn(s:str, sep:str = ' ') {
	s
	/> toLower
	/> split(sep)
	/> reduce("", fn(a, b) match {
		_ if len(b) > 0 => a + toUpper(b[0]) + b[1:]
		_               => a
	})
}

/**
 * converts a string to `camelCase`, capitalising each word except the first.
 */
@testWith(
	['LAST NAME'], 'lastName',
	['last name'], 'lastName',
	['l'],         'l',
	['l n'],       'lN',
	['l   n'],     'lN',
)
@export
@returns('@str')
val camelCase = fn(s:str, sep:str = ' ') {
	s
	/> toLower
	/> split(sep)
	/> reduce("", fn(a, b) match {
		["", ...]       => b
		_ if len(b) > 0 => a + toUpper(b[0]) + b[1:]
		_               => a
	})
}
