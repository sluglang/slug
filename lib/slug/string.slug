var {*} = import (
    "slug.std",
    "slug.math",
)

@testWith(
	[nil], nil,
	[""], "",
	[" slug "], "slug",
)
@export
@returns('@str')
foreign trim = fn(@str str)


@testWith(
	['  a  ', ' '], 'a',
	['xxaxxx', 'x'], 'a',
	['xxa', 'x'], 'a',
	['axxx', 'x'], 'a',
	['abxxx', 'xx'], 'abx',
)
@export
@returns('@str')
var trim = fn(@str s, @str prefix) {
	match s {
		nil => nil
		_ if s[0:len(prefix)] == prefix => recur(s[len(prefix):], prefix)
		_ if s[-len(prefix): len(s)] == prefix => recur(s[0:-len(prefix)], prefix)
		_ => s
	}
}


@testWith(
	["hello slug", "lu"], 7,
	["hello slug", "l"], 2,
	["hello slug", "l", 2 + 1], 3,
	["hello slug", "l", 4], 7,
	["éé|éé", "|"], 2,
)
@export
@returns('@num')
foreign indexOf = fn(@str str, @str seq, @num index = 0)

@testWith(
	["hello slug", "l"], 7,
	["hello slug", "h"], 0,
	["hello slug", "g"], 9,
)
@export
@returns('@num')
var lastIndexOf = fn(@str str, @str seq, @num index = 0, prev = -1) {
	var i = indexOf(str, seq, index)
	if ( i == -1) {
		prev
	} else {
		recur(str, seq, i + 1, i)
	}
}

@testWith(
	[nil], nil,
	[""], "",
	["slug"], "SLUG",
)
@export
@returns('@str')
foreign toUpper = fn(@str str)

@testWith(
	[nil], nil,
	[""], "",
	["SLUG"], "slug",
)
@export
@returns('@str')
foreign toLower = fn(@str str)

@testWith(
	[65], "A",
	[129315], "🤣",
)
@export
@returns('@str')
foreign fromCodePoint = fn(@num codePoint)

@testWith(
	["hello slug", "slug"], true,
	["hello slug", "snail"], false,
)
@export
@returns('@bool')
var contains = fn(@str str, @str seq) {
	str /> indexOf(seq) >= 0
}

@testWith(
	["hello slug", "slug"], false,
	["hello slug", "hello"], true,
)
@export
@returns('@bool')
var startsWith = fn(@str str, @str start) {
	str[0:len(start)] == start
}

@testWith(
	["hello slug", "slug"], true,
	["hello slug", "hello"], false,
)
@export
@returns('@bool')
var endsWith = fn(@str str, @str end) {
	str[len(str) - len(end):] == end
}

@testWith(
	[nil], false,
	[""], false,
	["slug"], false,
	["SLUG"], true,
)
@export
@returns('@bool')
var isUpper = fn(@str str) {
	if (str != nil && len(str) > 0) {
		str == str /> toUpper()
	} else {
		false
	}
}

@testWith(
	[nil], false,
	[""], false,
	["slug"], true,
	["SLUG"], false,
)
@export
@returns('@bool')
var isLower = fn(@str str) {
	if (str != nil && len(str) > 0) {
		str == str /> toLower()
	} else {
		false
	}
}

// split splits a string into a list of substrings based on a delimiter
// Parameters:
//   str: The input string to split
//   delimiter: The delimiter string to split on
//   max: Maximum number of splits to perform (-1 for unlimited)
//   count: Internal counter for number of splits performed
//   strs: Internal accumulator for storing split strings
// Returns:
//   Array of substrings split by the delimiter
@testWith(
	["slug/test", "/"], ["slug", "test"],
	["éé|éé", "|"], ["éé", "éé"],
	["a|b|c", "|", 2], ["a", "b|c"],
)
@export
@returns('@list')
var split = fn(@str str, @str delimiter, @num max = -1, @num count = 1, @list strs = []) {
	match str /> indexOf(delimiter) {
		n if n >= 0 && (max < 0 || count < max) => {
			val i = n + delimiter /> len()
			recur(str[i:], delimiter, max, count + 1, strs :+ str[0:n])
		}
		_ => strs :+ str
	}
}

@testWith(
	[[], "."], "",
	[["slug"], "."], "slug",
	[["slug", "test"], "."], "slug.test",
)
@export
@returns('@str')
var join = fn(@list strs, @str delimiter = "", @str str = nil) match {
	[[], ...] if str == nil => ""
	[[], ...] => str
	[[h, ...t], ...] if str == nil => recur(t, delimiter, h)
	[[h, ...t], ...] => recur(t, delimiter, str + delimiter + h)
}

@testWith(
	[nil, "/", "."], nil,
	["slug/test", "/", "."], "slug.test",
	["slug", "/", "."], "slug",
	["E &amp; S", "&amp;", "&"], "E & S",
)
@export
@returns('@str')
var replaceAll = fn(@str str, @str replace, @str with) match {
	[nil, ...] => nil
	[...] => str /> split(replace) /> join(with)
}

@export
@returns('@str')
var padRight = fn(@str str, @str with, @num length) {
	if (length <= len(str)) {
		str
	} else {
		recur(str + with, with, length)
	}
}

@export
@returns('@str')
var padLeft = fn(@str str, @str with, @num length) {
	if (length <= len(str)) {
		str
	} else {
		recur(with + str, with, length)
	}
}

@export
@returns('@str')
var randomString = fn(@num length, @str chars, @str acc = "") match {
	[0, ...] => acc
	_ => recur(length - 1, chars, acc + chars[rndRange(0, len(chars))])
}

@export
@returns('@str')
var randomHexString = fn(@num length) {
	val hexDigits= "0123456789abcdef"
	randomString(length, hexDigits)
}

@testWith(
	['LAST NAME', ' ', true], 'LAST_NAME',
	['last name', ' ', true], 'LAST_NAME',
	['LAST NAME'], 'LAST_NAME',
	['last name'], 'last_name',
	['l'], 'l',
	['l n'], 'l_n',
	['l   n'], 'l___n',
)
@export
@returns('@str')
var snakeCase = fn(@str s, @str sep = ' ', screaming = false) {
	s
	/> fn(s) { if(screaming) { toUpper(s) } else { s }}
	/> split(sep)
	/> join("_")
}

@testWith(
	['LAST NAME'], 'LAST-NAME',
	['last name'], 'last-name',
	['l'], 'l',
	['l n'], 'l-n',
	['l   n'], 'l---n',
)
@export
@returns('@str')
var kebabCase = fn(@str s, @str sep = ' ') {
	s
	/> split(sep)
	/> join("-")
}

@testWith(
	['LAST NAME'], 'LastName',
	['last name'], 'LastName',
	['l'], 'L',
	['l n'], 'LN',
	['l   n'], 'LN',
)
@export
@returns('@str')
var pascalCase = fn(@str s, @str sep = ' ') {
	s
	/> toLower
	/> split(sep)
	/> reduce("", fn(a, b) match {
			_ if len(b) > 0 => a + toUpper(b[0]) + b[1:]
			_               => a
		}
	)
}

@testWith(
	['LAST NAME'], 'lastName',
	['last name'], 'lastName',
	['l'], 'l',
	['l n'], 'lN',
	['l   n'], 'lN',
)
@export
@returns('@str')
var camelCase = fn(@str s, @str sep = ' ') {
	s
	/> toLower
	/> split(sep)
	/> reduce("", fn(a, b) match {
			["", ...]       => b
			_ if len(b) > 0 => a + toUpper(b[0]) + b[1:]
			_               => a
		}
	)
}
