/**
 * slug.path - path utilities
 *
 * Small helpers for path composition and normalization.
 */

/**
 * Joins path elements using the platform-specific separator.
 */
@export
@returns('str')
foreign join = fn(...parts)

/**
 * Returns a normalized absolute path.
 */
@export
@returns('str')
foreign abs = fn(path:str)

/**
 * Returns the current process working directory.
 */
@export
@returns('str')
foreign cwd = fn()

/**
 * Returns the entry module directory.
 */
@export
@returns('str')
foreign projectRoot = fn()

/**
 * Returns the library root of the current module namespace.
 */
@export
@returns('str')
foreign libRoot = fn()

/**
 * Returns the directory of the current module file.
 */
@export
@returns('str')
foreign moduleDir = fn()

/**
 * If path starts with '__project__/', '__library__/' or '__module__/' returns path new path with substitution,
 * useful for config.
 */
@export
@returns('str')
val localize = fn(path:str) match {
	nil => path
	_ if path[0:12] == '__project__/' => join(projectRoot(), path[12:])
	_ if path[0:12] == '__library__/' => join(libRoot(), path[12:])
	_ if path[0:11] == '__module__/' => join(moduleDir(), path[11:])
	_ => path
}
