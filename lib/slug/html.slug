/**
 * slug.html — basic HTML utilities
 *
 * Lightweight helpers for working with HTML fragments. Not a full HTML
 * parser — intended for simple extraction and unescaping tasks on
 * well-formed markup.
 */

val {*} = import(
	"slug.string"
)

/**
 * decodes common HTML entities in a string.
 *
 * Handles `&amp;`, `&lt;`, `&gt;`, `&quot;`, and `&#39;`.
 * Does not handle numeric entities beyond `&#39;` or named entities
 * beyond the five listed above.
 */
@testWith(
	["E &amp; S"], "E & S"
)
@export
val htmlUnescape = fn(str):str {
	str /> replaceAll("&amp;", "&")
		/> replaceAll("&lt;", "<")
		/> replaceAll("&gt;", ">")
		/> replaceAll("&quot;", "\"")
		/> replaceAll("&#39;", "'")
}

/**
 * extracts the inner content of the first matching tag in an HTML string.
 *
 * Handles nested tags of the same type correctly — the inner content is
 * everything between the outermost opening and closing tag. Returns an
 * empty string if the tag is not found or `start` is negative.
 *
 * The `start` parameter can be used to search from a specific character
 * offset, enabling successive extractions from the same document.
 *
 * ```slug
 * extractInnerText("<div><p>hello</p></div>", "p")
 * // => "hello"
 *
 * extractInnerText("<a href='h'><a>hi</a></a>", "a")
 * // => "<a>hi</a>"
 * ```
 */
@testWith(
	["<a>hi</a>", "a", -1], "",
	["<a>hi</a>", "div"], "",
	["<a>hi</a>", "a"], "hi",
	["<a href='h'><a>hi</a></a>", "a"], "<a>hi</a>",
	["<a><a href='h'>hi</a></a>", "a"], "<a href='h'>hi</a>"
)
@export
val extractInnerText = fn(html, tag, start = 0):str {
	if (start < 0) {
		""
	} else {
		val startTag = "<" + tag
		val endTag = "</{{tag}}>"

		val openIdx = html /> indexOf(startTag, start)
		if (openIdx < 0) {
			""
		} else {
			val openIdx = html /> indexOf(">", openIdx)
			val endIdx = html /> indexOf(endTag, openIdx + 1)
			if (endIdx < 0) {
				""
			} else {
				findEndTag(html, startTag, endTag, openIdx, openIdx)
			}
		}
	}
}

val findEndTag = fn(html, startTag, endTag, startPos, i, depth = 1) {
	if (i < len(html) && depth > 0) {
		val nextOpen  = html /> indexOf(startTag, i)
		val nextClose = html /> indexOf(endTag, i)
		if (nextClose == -1) {
			""
		} else if (nextOpen != -1 && nextOpen < nextClose) {
			val nextEnd = html /> indexOf(">", nextOpen) + 1
			recur(html, startTag, endTag, startPos, nextEnd, depth + 1)
		} else {
			val nextEnd = nextClose + len(endTag)
			recur(html, startTag, endTag, startPos, nextEnd, depth - 1)
		}
	} else {
		html[startPos + 1: i - len(endTag)]
	}
}
