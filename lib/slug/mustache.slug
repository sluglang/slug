/**
 * slug.mustache — Mustache template renderer
 *
 * A native Slug implementation of the Mustache spec v1.4.3, including
 * the core suites and template inheritance.
 *
 * ## Basic usage
 *
 * ```slug
 * val { render, parse } = import("slug.mustache")
 *
 * render("Hello, {{name}}!", { name: "World" })
 * // => "Hello, World!"
 *
 * render("{{#items}}{{.}} {{/items}}", { items: ["a", "b", "c"] })
 * // => "a b c "
 * ```
 *
 * ## Tag types
 *
 * | Tag              | Meaning                                      |
 * |------------------|----------------------------------------------|
 * | `{{name}}`       | HTML-escaped variable                        |
 * | `{{{name}}}`     | Unescaped variable                           |
 * | `{{&name}}`      | Unescaped variable (alternate syntax)        |
 * | `{{#section}}`   | Section — renders if truthy/non-empty        |
 * | `{{^section}}`   | Inverted section — renders if falsey/empty   |
 * | `{{/section}}`   | Closes a section                             |
 * | `{{>partial}}`   | Partial — renders another template by name   |
 * | `{{<parent}}`    | Template inheritance — extend a parent       |
 * | `{{$block}}`     | Block — defines or overrides a named region  |
 * | `{{! comment }}` | Comment — ignored                            |
 * | `{{=<% %>=}}`    | Set delimiters                               |
 *
 * ## Partials
 *
 * Pass a map of `name -> template_string` as the `partials` argument.
 * Partials inherit the current context and are resolved at render time.
 *
 * ## Template inheritance
 *
 * Use `{{<parent}}...{{/parent}}` to extend a parent template.
 * Override named blocks with `{{$blockName}}...{{/blockName}}`.
 *
 * ## Performance
 *
 * For templates rendered multiple times, parse once and pass the AST
 * to `render` or `renderCached` to avoid repeated parsing.
 * `renderCached` additionally caches parsed partials across calls.
 */

val {*} = import(
	"slug.std",
	"slug.string",
)

val DEFAULT_OTAG = '{{'
val DEFAULT_CTAG = '}}'

// Node shapes:
//  TextNode { text:"..." }
//  VarNode { name:"a.b", escape:true/false }
//  SectionNode { name:"items", inverted:false, children:[...], raw:"...", otag:"{{", ctag:"}}" }
//  PartialNode { name:"p", indent:"   " }
//  ParentNode { name:"p", indent:"   ", children:[...] }
//  BlockNode { name:"b", children:[...], raw:"...", standalone:true/false, indentLen:0, indentStr:"" }

val TextNode = struct {
	text:str,
}

val VarNode = struct {
	name:str,
	escape:bool,
}

val SectionNode = struct {
	name:str,
	inverted:bool,
	children:list,
	raw:str,
	otag:str,
	ctag:str,
}

val PartialNode = struct {
	name:str,
	indent:str,
}

val SectionFrame = struct {
	name:str,
	kind:str,
	inverted:bool,
	nodes:list,
	contentStart,
	otag:str,
	ctag:str,
	standalone:bool,
	indent:str,
}

val ParentNode = struct {
	name:str,
	indent:str,
	children:list,
}

val BlockNode = struct {
	name:str,
	children:list,
	raw:str,
	standalone:bool,
	indentLen:num,
	indentStr:str,
	trailingNl:bool,
}

val isWs = fn(s:str) {
	if (s == nil || len(s) == 0) {
		true 
	} else {
		var i = 0
		fn() {
			if (i >= len(s)) {
				true 
			} else {
				var c = s[i]
				if (c == " " || c == "\t" || c == "\r") {
					i = i + 1
					recur()
				} else {
					false
				}
			}
		}()
	}
}

val isWsOrTags = fn(s:str, otag:str, ctag:str) {
	if (s == nil || len(s) == 0) {
		true
	} else {
		var i = 0
		fn() {
			if (i >= len(s)) {
				true
			} else {
				var c = s[i]
				if (c == " " || c == "\t" || c == "\r") {
					i = i + 1
					recur()
				} else if (s[i:i + len(otag)] == otag) {
					var end = s /> indexOf(ctag, i + len(otag))
					if (end < 0) {
						false
					} else {
						i = end + len(ctag)
						recur()
					}
				} else {
					false
				}
			}
		}()
	}
}

val lineStart = fn(s:str, idx:num) {
	var k = if(idx <= 0) {-1} else {(s[0:idx] /> lastIndexOf("\n"))}
	if(k < 0) {0} else {(k + 1)}
}

val lineEnd = fn(s:str, idx:num) {
	var k = s /> indexOf("\n", idx)
	if(k < 0) {len(s)} else {k}
}

val htmlEscape = fn(s:str) {
	if (s == nil) { 
		"" 
	} else {
		s
			/> replaceAll("&", "&amp;")
			/> replaceAll("<", "&lt;")
			/> replaceAll(">", "&gt;")
			/> replaceAll("\"", "&quot;")
			/> replaceAll("'", "&#39;")
	}
}

val isFalsey = fn(v) {
	match v /> type() {
		^NIL_TYPE => true
		^BOOLEAN_TYPE => v == false
		^LIST_TYPE => len(v) == 0
		_ => false
	}
}

val lookupIn = fn(ctx, parts, idx = 0) {
	if (idx >= len(parts)) {
		ctx
	} else {
		var key = parts[idx]
		if (key == ".") {
			recur(ctx, parts, idx + 1)
		} else if (type(ctx) == MAP_TYPE) {
			var value = mapLookup(ctx, key)
			recur(value, parts, idx + 1)
		} else {
			nil
		}
	}
}

val lookup = fn(stack:list, name:str, i = nil) {
	if (i == nil) { i = len(stack) - 1 }
	if (i < 0) { 
		nil 
	} else {
		var ctx = stack[i]
		if (name == ".") {
			ctx
		} else {
			var parts = name /> split(".")
			var first = parts[0]
			var value = if(type(ctx) == MAP_TYPE) {mapLookup(ctx, first)} else {nil}
			if (value != nil) {
				lookupIn(ctx, parts)
			} else if (i > 0) {
				recur(stack, name, i - 1)
			} else {
				nil
			}
		}
	}
}

val indentPartial = fn(partial:str, indent:str) {
	if (indent == "" || partial == nil || partial == "") {
		partial /> ifNil("")
	} else {
		var out = ""
		var i = 0
		fn() {
			if (i >= len(partial)) { 
				out 
			} else {
				var c = partial[i]
				out = out + c
				if (c == "\n" && i < len(partial) - 1) {
					out = out + indent
				}
				i = i + 1
				recur()
			}
		}()
	}
}

val indentLines = fn(text:str, indent:str) {
	if (indent == "" || text == nil || text == "") {
		text /> ifNil("")
	} else {
		var out = indent
		var i = 0
		fn() {
			if (i >= len(text)) { 
				out 
			} else {
				var c = text[i]
				out = out + c
				if (c == "\n" && i < len(text) - 1) {
					out = out + indent
				}
				i = i + 1
				recur()
			}
		}()
	}
}

val leadingWsLen = fn(line:str) {
	var i = 0
	fn() {
		if (i >= len(line)) {
			i
		} else {
			var c = line[i]
			if (c == " " || c == "\t") {
				i = i + 1
				recur()
			} else {
				i
			}
		}
	}()
}

val blockIndentInfo = fn(raw:str) {
	if (raw == nil || raw == "") {
		{len:0, prefix:""}
	} else {
		var lines = raw /> split("\n")
		var minLen = nil
		var minPrefix = ""
		var i = 0
		fn() {
			if (i >= len(lines)) {
				{len: minLen /> ifNil(0), prefix: minPrefix}
			} else {
				var line = lines[i]
				if (line == nil || isWs(line)) {
					i = i + 1
					recur()
				} else {
					var l = leadingWsLen(line)
					if (minLen == nil || l < minLen) {
						minLen = l
						minPrefix = line[0:l]
					}
					i = i + 1
					recur()
				}
			}
		}()
	}
}

val stripIndent = fn(text:str, count:num) {
	if (count <= 0 || text == nil || text == "") {
		text /> ifNil("")
	} else {
		var out = ""
		var i = 0
		var atLineStart = true
		var removed = 0
		fn() {
			if (i >= len(text)) {
				out
			} else {
				var c = text[i]
				if (atLineStart && (c == " " || c == "\t") && removed < count) {
					removed = removed + 1
					i = i + 1
					recur()
				} else {
					out = out + c
					if (c == "\n") {
						atLineStart = true
						removed = 0
					} else {
						atLineStart = false
					}
					i = i + 1
					recur()
				}
			}
		}()
	}
}

val resolvePartial = fn(partials, name:str) {
	if (partials == nil) {
		nil
	} else if (type(partials) == MAP_TYPE) {
		mapLookup(partials, name)
	} else if (type(partials) == FUNCTION_TYPE) {
		partials(name)
	} else {
		throw Error { type: "MustacheError", msg: "partials must be a map or a loader function" }
	}
}

val mapLookup = fn(m:map, key:str) {
	var value = m[key]
	if (value != nil) {
		value
	} else {
		m[sym(key)]
	}
}

/**
 * parses a Mustache template string into an AST.
 *
 * The returned AST can be passed directly to `render` or `renderCached`
 * to avoid re-parsing on repeated renders. The AST shape is an
 * implementation detail — do not rely on its structure directly.
 */
@export val parse = fn(template:str) {
	var otag = DEFAULT_OTAG
	var ctag = DEFAULT_CTAG

	var root = SectionFrame { name:"__root__", kind:"root", inverted:false, nodes:[], contentStart:nil, otag:otag, ctag:ctag, standalone:false, indent:"" }
	var stack = [root]

	var pushNode = fn(stack, node) {
		var top = stack[len(stack) - 1]
		var updated = top copy { nodes: top.nodes :+ node }
		stack /> update(len(stack) - 1, updated)
	}

	var openFrame = fn(stack, kind, name, inverted, contentStart, ot, ct, standalone, indent) {
		stack :+ SectionFrame { name:name, kind:kind, inverted:inverted, nodes:[], contentStart:contentStart, otag:ot, ctag:ct, standalone:standalone, indent:indent }
	}

	var closeFrame = fn(stack, name, rawInner) {
		if (len(stack) <= 1) {
			throw Error { type: "MustacheError", msg: 'Mustache close tag without open: {{' + name + '}}' }
		}
		var frame = stack[len(stack) - 1]
		if (frame.name != name) {
			throw Error { type: "MustacheError", msg: 'Mustache section mismatch: expected {{' + frame.name + '}} got {{' + name + '}}' }
		}
		var parent = stack[0:len(stack) - 1]
		var node = match frame.kind {
			"section" => SectionNode { name:frame.name, inverted:frame.inverted, children:frame.nodes, raw:rawInner, otag:frame.otag, ctag:frame.ctag }
			"parent" => ParentNode { name:frame.name, indent:frame.indent, children:frame.nodes }
			"block" => {
				var info = if(frame.standalone) {blockIndentInfo(rawInner)} else { {len:0, prefix:""} }
				var indentStr = if (info.prefix == "" && frame.indent != "") { frame.indent } else { info.prefix }
				BlockNode {
					name:frame.name,
					children:frame.nodes,
					raw:rawInner,
					standalone:frame.standalone,
					indentLen:info.len,
					indentStr:indentStr,
					trailingNl:false,
				}
			}
			_ => throw Error { type: "MustacheError", msg: "Unknown mustache frame kind: " + frame.kind }
		}
		parent /> then(fn(ps) { pushNode(ps, node) })
	}

	var eligibleStandalone = fn(sig) {
		sig == "!" || sig == ">" || sig == "#" || sig == "^" || sig == "/" || sig == "=" || sig == "<" || sig == "$"
	}

	var i = 0
	var n = len(template)

	fn() {
		if (i >= n) { nil 
		} else {
			var open = template /> indexOf(otag, i)
			if (open < 0) {
				stack = stack /> then(fn(st) { pushNode(st, TextNode { text:template[i:] }) })
				i = n
				recur()
			} else {
				// triple mustache is current otag + "{" and "}" + current ctag
				var tripleOpen = otag + "{"
				var tripleClose = "}" + ctag
				var isTriple = template[open:open + len(tripleOpen)] == tripleOpen
				var tagOpenLen = if(isTriple) {len(tripleOpen)} else {len(otag)}
				var closeDelim = if(isTriple) {tripleClose} else {ctag}

				var end = template /> indexOf(closeDelim, open + tagOpenLen)
				if (end < 0) { throw Error { type: "MustacheError", msg: "Unclosed mustache tag" } }

				var tagEnd = end + len(closeDelim)
				var tagRaw = template[open + tagOpenLen:end]
				var tag = tagRaw /> trim()
				var sig = if(len(tag) > 0) {tag[0]} else {""}

				var ls = lineStart(template, open)
				var le = lineEnd(template, tagEnd)
				var before = template[ls:open]
				var after = template[tagEnd:le]
				var standalone = (len(tag) > 0) && eligibleStandalone(sig) && isWs(before) && isWs(after)
				if (!standalone && (sig == "$" || sig == "/")) {
					standalone = isWsOrTags(before, otag, ctag) && isWs(after)
				}
				var inlineCloseName = ""
				var inlineCloseHasNl = false
				if ((sig == "<" || sig == "$") && len(tag) > 1 && isWsOrTags(before, otag, ctag)) {
					var name = tag[1:] /> trim()
					var closeTag = otag + "/" + name + ctag
					var afterTrim = after /> trim()
					if (afterTrim == closeTag) {
						inlineCloseName = name
						inlineCloseHasNl = (le < len(template) && template[le:le + 1] == "\n")
					}
				}

				// If this tag is standalone, its line ending is ignored (but not required).
				// This affects where "section content" begins for the purposes of capturing raw
				// section text (used by the spec for lambdas in other implementations).
				var afterStandalone = if(standalone) {
						if(le < len(template) && template[le:le + 1] == "\n") {(le + 1)} else {le}
					} else {
						tagEnd
					}

				// emit text preceding tag; for standalone tags, drop indentation-only prefix on that line
				var textEnd = if(standalone || inlineCloseName != "") {ls} else {open}
				if (textEnd > i) {
					stack = stack /> then(fn(st) { pushNode(st, TextNode { text:template[i:textEnd] }) })
				}

				if (len(tag) > 0) {
					if (inlineCloseName != "") {
						if (sig == "<") {
							stack = stack /> then(fn(st) { pushNode(st, ParentNode { name:inlineCloseName, indent:before, children:[] }) })
						} else {
							stack = stack /> then(fn(st) { pushNode(st, BlockNode {
								name:inlineCloseName,
								children:[],
								raw:"",
								standalone:true,
								indentLen:0,
								indentStr:before,
								trailingNl:inlineCloseHasNl,
							}) })
						}
					} else if (isTriple) {
						stack = stack /> then(fn(st) { pushNode(st, VarNode { name:tag, escape:false }) })
					} else {
						match sig {
							"!" => { }
							"#" => {
								var name = tag[1:] /> trim()
								stack = openFrame(stack, "section", name, false, afterStandalone, otag, ctag, standalone, "")
							}
							"^" => {
								var name = tag[1:] /> trim()
								stack = openFrame(stack, "section", name, true, afterStandalone, otag, ctag, standalone, "")
							}
							"<" => {
								var name = tag[1:] /> trim()
								var indent = if(standalone) {before} else {""}
								stack = openFrame(stack, "parent", name, false, afterStandalone, otag, ctag, standalone, indent)
							}
							"$" => {
								var name = tag[1:] /> trim()
								var indent = if(standalone) {before} else {""}
								stack = openFrame(stack, "block", name, false, afterStandalone, otag, ctag, standalone, indent)
							}
							"/" => {
								var name = tag[1:] /> trim()
								var frame = stack[len(stack) - 1]
								var raw = ""
								if (frame.contentStart != nil && frame.contentStart <= open) {
									raw = template[frame.contentStart:open]
								}
								stack = closeFrame(stack, name, raw)
							}
							"&" => {
								var name = tag[1:] /> trim()
								stack = stack /> then(fn(st) { pushNode(st, VarNode { name:name, escape:false }) })
							}
							">" => {
								var name = tag[1:] /> trim()
								var indent = if(standalone) {before} else {""}
								stack = stack /> then(fn(st) { pushNode(st, PartialNode { name:name, indent:indent }) })
							}
							"=" => {
								// {{=<% %>=}} : must begin and end with '='
								if (tag[len(tag) - 1] != "=") {
									throw Error { type: "MustacheError", msg: "Invalid set delimiter tag" }
								}
								var inner = tag[1:len(tag) - 1] /> trim()
								var parts = inner /> split(" ") /> filter(fn(p) { p != "" })
								if (len(parts) != 2) {
									throw Error { type: "MustacheError", msg: "Invalid set delimiter tag" }
								}
								otag = parts[0]
								ctag = parts[1]
							}
							_ => {
								stack = stack /> then(fn(st) { pushNode(st, VarNode { name:tag, escape:true }) })
							}
						}
					}
				}

				// advance i; for standalone tags, remove trailing whitespace and optional newline
				if (standalone || inlineCloseName != "") {
					if (le < len(template) && template[le:le + 1] == "\n") {
						i = le + 1
					} else {
						i = le
					}
				} else {
					i = tagEnd
				}

				recur()
			}
		}
	}()

	if (len(stack) != 1) {
		var top = stack[len(stack) - 1]
		throw Error { type: "MustacheError", msg: 'Unclosed mustache section: {{#' + top.name + '}}' }
	}

	stack[0].nodes
}

val getPartialAst = fn(partials, cache, name) {
	var src = resolvePartial(partials, name)
	if (src == nil) {
		{ast:nil, cache:cache, src:nil}
	} else {
		var e = cache[name]
		if (e != nil && e.src == src) {
			{ast:e.ast, cache:cache, src:src}
		} else {
			var ast = parse(src)
			var cache2 = cache /> put(name, {src:src, ast:ast})
			{ast:ast, cache:cache2, src:src}
		}
	}
}

val collectBlocks = fn(nodes, acc = {}) match {
	[[], ...] => acc
	[[node, ...rest], ...] => {
		match node {
			BlockNode { name } => {
				var acc2 = acc /> put(name, node)
				recur(rest, acc2)
			}
			_ => recur(rest, acc)
		}
	}
}

val mergeBlocks = fn(inner, outer) {
	if (inner == nil) {
		outer /> ifNil({})
	} else if (outer == nil) {
		inner
	} else {
		outer /> keys() /> reduce(inner, fn(acc, k) {
			acc /> put(k, outer[k])
		})
	}
}

val renderNodesCached = fn(nodes, ctxStack, partials, cache, blocks, acc = "", indent = "") match {
	[[], ...] => { {html:acc, cache:cache} }
	[[node, ...rest], ...] => {
		match node {
			TextNode { text } => {
				var text = indentPartial(text, indent)
				recur(rest, ctxStack, partials, cache, blocks, acc + text)
			}

			VarNode { name, escape } => {
				var v = lookup(ctxStack, name)
				var s = if(v == nil) {""} else {(v /> toString())}
				var out = if(escape) {htmlEscape(s)} else {s}
				var indented = indentPartial(out, indent)
				recur(rest, ctxStack, partials, cache, blocks, acc + indented)
			}

			PartialNode { name, indent } => {
				var r = getPartialAst(partials, cache, name)
				if (r.ast == nil) {
					recur(rest, ctxStack, partials, r.cache, blocks, acc)
				} else {
					var localIndent = indent /> ifNil("")
					var ast = if(localIndent == "") {r.ast} else {parse(indentLines(r.src, localIndent))}
					var rendered = renderNodesCached(ast, ctxStack, partials, r.cache, blocks, "", "")
					recur(rest, ctxStack, partials, rendered.cache, blocks, acc + rendered.html)
				}
			}

			ParentNode { name, indent, children } => {
				var r = getPartialAst(partials, cache, name)
				if (r.ast == nil) {
					recur(rest, ctxStack, partials, r.cache, blocks, acc)
				} else {
					var overrideBlocks = collectBlocks(children)
					var mergedBlocks = mergeBlocks(overrideBlocks, blocks)
					var localIndent = indent /> ifNil("")
					var ast = if(localIndent == "") {r.ast} else {parse(indentLines(r.src, localIndent))}
					var rendered = renderNodesCached(ast, ctxStack, partials, r.cache, mergedBlocks, "", "")
					recur(rest, ctxStack, partials, rendered.cache, blocks, acc + rendered.html)
				}
			}

			BlockNode { name, children, indentLen, indentStr, standalone, trailingNl } => {
				var override = if(blocks == nil) {nil} else {blocks[name]}
				if (override == nil) {
					var inner = renderNodesCached(children, ctxStack, partials, cache, blocks, "")
					var out = inner.html
					if (trailingNl && out != "" && out[len(out) - 1] != "\n") {
						out = out + "\n"
					}
					recur(rest, ctxStack, partials, inner.cache, blocks, acc + out)
				} else {
					var strippedBlocks = if(blocks == nil) {nil} else {blocks /> remove(name)}
					var inner = renderNodesCached(override.children, ctxStack, partials, cache, strippedBlocks, "")
					var stripped = stripIndent(inner.html, override.indentLen)
					var indented = if(indentStr == "" || stripped == "") {stripped} else {indentLines(stripped, indentStr)}
					var out = indented
					if (trailingNl && out != "" && out[len(out) - 1] != "\n") {
						out = out + "\n"
					}
					recur(rest, ctxStack, partials, inner.cache, blocks, acc + out)
				}
			}

			SectionNode { name, inverted, children } => {
				var v = lookup(ctxStack, name)
				if (inverted) {
					if (isFalsey(v)) {
						var inner = renderNodesCached(children, ctxStack, partials, cache, blocks, "")
						recur(rest, ctxStack, partials, inner.cache, blocks, acc + inner.html)
					} else {
						recur(rest, ctxStack, partials, cache, blocks, acc)
					}
				} else {
					if (isFalsey(v)) {
						recur(rest, ctxStack, partials, cache, blocks, acc)
					} else if (type(v) == LIST_TYPE) {
						var each = fn(items, acc2, cache2) match {
							[[], ...] => { {html:acc2, cache:cache2} }
							[[h, ...t], ...] => {
								var inner = renderNodesCached(children, ctxStack :+ h, partials, cache2, blocks, "")
								each(t, acc2 + inner.html, inner.cache)
							}
						}
						var r2 = each(v, "", cache)
						recur(rest, ctxStack, partials, r2.cache, blocks, acc + r2.html)
					} else if (type(v) == MAP_TYPE) {
						var inner = renderNodesCached(children, ctxStack :+ v, partials, cache, blocks, "")
						recur(rest, ctxStack, partials, inner.cache, blocks, acc + inner.html)
					} else {
						var inner = renderNodesCached(children, ctxStack :+ v, partials, cache, blocks, "")
						recur(rest, ctxStack, partials, inner.cache, blocks, acc + inner.html)
					}
				}
			}

			_ => throw Error { type: "MustacheError", msg: "Unknown mustache node type: " + type(node) }
		}
	}
}

/**
 * renders a Mustache template with a partial cache for reuse across calls.
 *
 * Returns a map `{ html: @str, cache: @map }`. Pass the returned `cache`
 * back on subsequent calls to avoid re-parsing partials.
 *
 * `templateOrAst` may be a template string or a pre-parsed AST from `parse`.
 * `partials` may be a map of `name -> template_string` or a `fn(name) -> str`.
 */
@export
@returns('@str')
@throws('@struct(Error{type:MustacheError})')
val renderCached = fn(templateOrAst, data, partials = nil, cache = {}) {
	var ast = if(type(templateOrAst) == STRING_TYPE) {parse(templateOrAst)} else {templateOrAst}
	renderNodesCached(ast, [data], partials, cache, {}, "")
}

/**
 * renders a Mustache template and returns the resulting HTML string.
 *
 * `templateOrAst` may be a template string or a pre-parsed AST from `parse`.
 * `partials` may be a map of `name -> template_string` or a `fn(name) -> str`.
 * For repeated renders of the same template with partials, prefer
 * `renderCached` to avoid re-parsing partials on each call.
 */
@export
@returns('@str')
@throws('@struct(Error{type:MustacheError})')
val render = fn(templateOrAst, data, partials = nil) {
	renderCached(templateOrAst, data, partials, {}).html
}
