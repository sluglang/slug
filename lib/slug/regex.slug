@testWith(
    ["test", "\d+"], false,
    ["aaabbb", "b+"], true,
    ["123", "\d+"], true
)
@export
@returns('@bool')
foreign matches = fn(@str str, @str pattern)


@export
@returns('[@list, @list]')
foreign indexOf = fn(@str str, @str pattern, @num index = 0); // return nil or list [left, right]


@testWith(
    ["1|2|3", "\|"], ["1", "2", "3"]
)
@export
@returns('@list')
foreign split = fn(@str str, @str pattern)


@testWith(
    ["1|2|3", "\d+"], ["1", "2", "3"],
    ["(foo)", "[a-z]+"], ["foo"]
)
@export
@returns('@list')
foreign findAll = fn(@str str, @str pattern)


@testWith(
	["<a href=\"foo\">bar</a>", "<a href=\"(.*?)\">(.*?)</a>"], [["<a href=\"foo\">bar</a>", "foo", "bar"]]
)
@export
@returns('@list')
foreign findAllGroups = fn(@str str, @str pattern)


@testWith(
    ["1|2|3", "\d+", "x"], "x|x|x"
)
@export
@returns('@str')
foreign replaceAll = fn(@str str, @str pattern, @str repl)
