/**
 * slug.log — structured logging
 *
 * Provides levelled, coloured, optionally file-backed logging for Slug
 * programs. Supports both module-level convenience functions and named
 * per-source loggers for multi-module applications.
 *
 * ## Log levels
 *
 * Levels are ordered: `trace` < `debug` < `info` < `warn` < `error` < `none`.
 * A message is emitted only when its level is >= the configured log level.
 * Setting the level to `none` suppresses all output.
 *
 * ## Configuration
 *
 * | cfg key              | Default  | Description                                    |
 * |----------------------|----------|------------------------------------------------|
 * | `level`              | `"info"` | Global minimum log level                       |
 * | `level__<src>`       |          | Per-source override (dots replaced with `_`)   |
 * | `log-file`           | `nil`    | Write to this file path instead of stderr      |
 * | `colour`             | `true`   | Write to stderr with ANSI color codes          |
 *
 * ## Quick start
 *
 * ```slug
 * val log = import("slug.log")
 *
 * log.info("server started on port {}", 8080)
 * log.warn("retrying after {} ms", 500)
 * ```
 *
 * ## Named loggers
 *
 * ```slug
 * val log = import("slug.log").logger("slug.io.http")
 *
 * log.debug("GET {} {}", path, status)
 *
 * // chainable — passes the value through unchanged
 * val result = fetchData()
 *   /> log.cInfo("fetched {} records")
 *   /> process
 * ```
 *
 * ## Chainable variants
 *
 * The `c*` functions (`cTrace`, `cDebug`, `cInfo`, `cWarn`, `cError`) log a
 * message and return their first argument unchanged. This lets you insert
 * logging into a pipeline without breaking the data flow:
 *
 * ```slug
 * items
 *   /> filter(fn(x) { x.active })
 *   /> log.cDebug("active items: {}")
 *   /> map(transform)
 * ```
 *
 * ## File output
 *
 * When `log-file` is set, log entries are appended to that file with no
 * colour codes. When writing to stderr, ANSI colour codes are applied per
 * level.
 *
 * @effects('io')
 */

val {*} = import(
    "slug.std",
    "slug.time",
    "slug.list",
    "slug.string",
    "slug.term.colour",
    "slug.io.fs",
    "slug.path",
)
val err = import('slug.io.stderr')

// --- level constants ---

/**
 * minimum log level — emits everything
 */
@export val Trace = 0

/**
 * debug-level messages; verbose operational detail
 */
@export val Debug = 1

/**
 * informational messages; normal operational events
 */
@export val Info  = 2

/**
 * warnings; unexpected but recoverable situations
 */
@export val Warn  = 3

/**
 * errors; failures that require attention
 */
@export val Error = 4

/**
 * suppress all output
 */
@export val None  = 5

val DefaultLogLevel = 'info'
val Levels   = ["trace", "debug", "info", "warn", "error", "none"]
val Colours  = [BrightColour.Black, Colour.Cyan, Colour.Green, Colour.Yellow, Colour.Red]
val ResetColour = reset

// --- global configuration ---

/**
 * resolved numeric log level from cfg("level", "info")
 */
val LogLevel = indexOf(Levels, cfg('level', DefaultLogLevel) /> toLower)

/**
 * resolved file path from cfg("log-file"), or nil for stderr
 */
val LogPath    = cfg('log-file', nil) /> localize
val LogColour  = cfg('colour', true)

// --- internal helpers ---

// Writes content to the configured destination.
// Stdout gets println; file path gets appendFile.
val emit = fn(content, path) {
    match path {
		nil => err.println(content)
		_   => appendFile(content + "\n", path)
	}
}

// Formats and emits a log message if level >= logLvl.
//
// `logLvl` — the minimum level configured for this logger
// `level`  — the level of this specific message
// `msg`    — fmt-style format string
// `args`   — positional arguments for fmt
val logMsg = fn(logLvl:num, level:num, msg:str, args:list) {
	match level >= logLvl && level < None {
        false => nil
        _     => {
            val tag = match LogPath == nil && LogColour {
                true  => fmt("{}{:<5s}{}", Colours[level], Levels[level], ResetColour)
                false => fmt("{:<5s}", Levels[level])
			}
            val timestamp = fmtClock(clock(), "2006-01-02 15:04:05.000")
            emit(fmt("{} [ {} ] {}", timestamp, tag, fmt(msg, ...args)), LogPath)
		}
	}
}

// ============================================================
// logger — named per-source logger
// ============================================================

/**
 * creates a named logger for a specific source module.
 *
 * The source name is prepended to every log message, making it easy
 * to filter output by module in multi-component applications.
 *
 * The log level can be overridden per-source via cfg:
 * dots in the source name are replaced with underscores.
 * e.g. `logger("slug.io.http")` reads `cfg("level__slug_io_http")`.
 *
 * Returns a map of logging functions: `trace`, `debug`, `info`, `warn`,
 * `error` and their chainable counterparts `cTrace`…`cError`.
 *
 * ```slug
 * val log = import("slug.log").logger("myapp.worker")
 * log.info("started {} workers", count)
 * val result = compute() /> log.cWarn("slow result: {}")
 * ```
 */
@export
@returns('map')
val logger = fn(src:str) {
	val source = src + ": "
    val lvl    = indexOf(
        Levels,
        cfg('level__' + replaceAll(src, '.', '_'), cfg('level', DefaultLogLevel) /> toLower)
    )
	{
        trace:  fn(message:str, ...args) { logMsg(lvl, Trace, source + message, args) },
        debug:  fn(message:str, ...args) { logMsg(lvl, Debug, source + message, args) },
        info:   fn(message:str, ...args) { logMsg(lvl, Info,  source + message, args) },
        warn:   fn(message:str, ...args) { logMsg(lvl, Warn,  source + message, args) },
        error:  fn(message:str, ...args) { logMsg(lvl, Error, source + message, args) },

        // chainable variants — log and return first argument unchanged
		cTrace: fn(arg, message:str, ...args) { logMsg(lvl, Trace, source + message, arg +: args); arg },
		cDebug: fn(arg, message:str, ...args) { logMsg(lvl, Debug, source + message, arg +: args); arg },
        cInfo:  fn(arg, message:str, ...args) { logMsg(lvl, Info,  source + message, arg +: args); arg },
        cWarn:  fn(arg, message:str, ...args) { logMsg(lvl, Warn,  source + message, arg +: args); arg },
		cError: fn(arg, message:str, ...args) { logMsg(lvl, Error, source + message, arg +: args); arg },
	}
}

// ============================================================
// module-level convenience functions
// ============================================================

/**
 * logs a trace-level message using the global log level.
 *
 * `message` is a `fmt`-style format string; `args` are its arguments.
 * Emits nothing if the configured level is above `trace`.
 *
 * @effects('io')
 */
@export
@returns('str|nil')
val trace = fn(message:str, ...args) { logMsg(LogLevel, Trace, message, args) }

/**
 * logs a debug-level message using the global log level.
 *
 * @effects('io')
 */
@export
@returns('str|nil')
val debug = fn(message:str, ...args) { logMsg(LogLevel, Debug, message, args) }

/**
 * logs an info-level message using the global log level.
 *
 * @effects('io')
 */
@export
@returns('str|nil')
val info = fn(message:str, ...args) { logMsg(LogLevel, Info, message, args) }

/**
 * logs a warn-level message using the global log level.
 *
 * @effects('io')
 */
@export
@returns('str|nil')
val warn = fn(message:str, ...args) { logMsg(LogLevel, Warn, message, args) }

/**
 * logs an error-level message using the global log level.
 *
 * @effects('io')
 */
@export
@returns('str|nil')
val error = fn(message:str, ...args) { logMsg(LogLevel, Error, message, args) }

/**
 * logs at the `none` level.
 *
 * Since `none` is above all other levels, this message is only emitted
 * when the configured level is also `none` — effectively never. Useful
 * as a placeholder or for temporarily silencing a log call.
 *
 * @effects('io')
 */
@export
@returns('nil')
val none = fn(message:str, ...args) { logMsg(LogLevel, None, message, args) }

// ============================================================
// module-level chainable variants
// ============================================================

/**
 * logs a trace-level message and returns the first argument unchanged.
 *
 * Designed for use in call chains — the value flows through unmodified:
 *
 * ```slug
 * val result = fetchItems()
 *   /> cTrace("fetched: {}")
 *   /> process
 * ```
 *
 * @effects('io')
 */
@export val cTrace = fn(arg, message:str, ...args) { logMsg(LogLevel, Trace, message, arg +: args); arg }

/**
 * logs a debug-level message and returns the first argument unchanged.
 *
 * @effects('io')
 */
@export val cDebug = fn(arg, message:str, ...args) { logMsg(LogLevel, Debug, message, arg +: args); arg }

/**
 * logs an info-level message and returns the first argument unchanged.
 *
 * @effects('io')
 */
@export val cInfo = fn(arg, message:str, ...args) { logMsg(LogLevel, Info,  message, arg +: args); arg }

/**
 * logs a warn-level message and returns the first argument unchanged.
 *
 * @effects('io')
 */
@export val cWarn = fn(arg, message:str, ...args) { logMsg(LogLevel, Warn,  message, arg +: args); arg }

/**
 * logs an error-level message and returns the first argument unchanged.
 *
 * @effects('io')
 */
@export val cError = fn(arg, message:str, ...args) { logMsg(LogLevel, Error, message, arg +: args); arg }
