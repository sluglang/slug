/**
 * slug.test — assertion and test utilities
 *
 * All assertion functions throw `AssertionError` on failure and return
 * the tested value on success, allowing assertions to be chained or
 * used inline in expressions.
 *
 * ## Quick start
 *
 * ```slug
 * val { assertEqual, assertThrows, runSafe } = import("slug.test")
 *
 * assertEqual(1 + 1, 2)
 * assertEqual("hello" /> toUpper(), "HELLO")
 * assertThrows(fn() { throw Error{ type: "Oops", msg: "!" } }, "Oops")
 * ```
 *
 * ## Short aliases
 *
 * All assertion functions have short aliases for concise test code:
 *
 * | Full name                | Alias   |
 * |--------------------------|---------|
 * | `assertEqual`            | `eq`    |
 * | `assertLessThan`         | `lt`    |
 * | `assertLessThanOrEqual`  | `lteq`  |
 * | `assertGreaterThan`      | `gt`    |
 * | `assertGreaterThanOrEqual` | `gteq` |
 * | `assertThrows`           | `throws`|
 * | `assertTrue`             | `ok`    |
 * | `assertFalse`            | `not`   |
 *
 * ## Error safety
 *
 * Use `runSafe` to execute a function without propagating errors —
 * useful for testing error paths or running multiple assertions where
 * a single failure should not abort the rest.
 */

val {*} = import(
	"slug.std",
)

/**
 * executes `f()` and returns a result map without propagating errors.
 *
 * Returns `{"ok": value}` on normal return, or
 * `{"error": thrownValue, "trace": stacktrace(thrownValue)}` on throw.
 *
 * Useful for testing that functions throw expected errors, or for running
 * test suites where a single failure should not abort subsequent tests.
 */
@export
val runSafe = fn(f:fn):map {
	defer onerror(err) {
		{ error: err, trace: stacktrace(err) }
	}
	val v = f()
	{ ok: v }
}

/**
 * returns true if `v` is an AssertionError thrown by this module.
 */
@export
val isAssertError = fn(v):bool {
	v /> type() == Error && v.type == "AssertionError"
}

/**
 * asserts that calling `f` throws a value equal to `expected`.
 *
 * Throws `AssertionError` if `f` does not throw, or if the thrown
 * value is not equal to `expected`.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assertThrows = fn(f:fn, expected, msg:str = nil):bool {
	val r = runSafe(f)
	if (r.error == expected) {
		true
	} else {
		val msg2 = match msg {
			nil if r.error => "Caught error '{{r.error}}' is not equal to '{{expected}}'"
			nil            => "No error was thrown"
			_              => msg
		}
		throw Error { type: "AssertionError", msg: msg2 }
	}
}

/**
 * asserts that calling `f` throws a value of type `expected`.
 *
 * Throws `AssertionError` if `f` does not throw, or if the thrown
 * value's type does not match `expected`.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assertErrorType = fn(f:fn, expected, msg:str = nil):bool {
	val r = runSafe(f)
	if (r.error /> type() == expected) {
		true
	} else {
		val msg2 = match msg {
			nil if r.error => "Caught error of type '{{r.error /> type()}}' is not equal to '{{expected}}'"
			nil            => "No error was thrown"
			_              => msg
		}
		throw Error { type: "AssertionError", msg: msg2 }
	}
}

/**
 * asserts that `a` is `true`.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assert = fn(a, msg = nil):bool {
	if (a /> type() == BOOLEAN_TYPE && a) {
		a
	} else {
		val msg2 = match msg { nil => "{{a}} ({{a /> type()}}) is not true" _ => msg }
		throw Error { type: "AssertionError", msg: msg2 }
	}
}

@export @throws('@struct(Error{type:AssertionError})')
val assertTrue = fn(a, msg = nil):bool {
	assert(a, msg)
}

/**
 * asserts that `a` is falsey.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assertFalse = fn(a, msg = nil):bool {
	assert(!a, msg)
}

/**
 * asserts that `value` equals `expected` using deep equality.
 *
 * Uses `equals` for lists and maps, `structEquals` for structs, and
 * `==` for all other types. Returns `value` on success.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assertEqual = fn(value, expected, msg = nil):any {
	val same = match type(value) {
		^LIST_TYPE   => equals(value, expected)
		^MAP_TYPE    => equals(value, expected)
		^STRUCT_TYPE => structEquals(value, expected)
		_ if isStructInstance(value) => structEquals(value, expected)
		_ => value == expected
	}
	if (same) {
		value
	} else {
		val msg2 = match msg { nil => "'{{value}}' is not equal to '{{expected}}'" _ => msg }
		throw Error { type: "AssertionError", msg: msg2 }
	}
}

/**
 * asserts that `value` does not equal `expected`. Returns `value` on success.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assertNotEqual = fn(value, expected, msg = nil):any {
	val same = match type(value) {
		^LIST_TYPE   => equals(value, expected)
		^MAP_TYPE    => equals(value, expected)
		^STRUCT_TYPE => structEquals(value, expected)
		_ if isStructInstance(value) => structEquals(value, expected)
		_ => value == expected
	}
	if (!same) {
		value
	} else {
		val msg2 = match msg { nil => "Expected '{{value}}' to NOT equal '{{expected}}'" _ => msg }
		throw Error { type: "AssertionError", msg: msg2 }
	}
}

/**
 * asserts that `value < expected`. Returns `value` on success.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assertLessThan = fn(value, expected, msg = nil):any {
	if (value < expected) { value } else {
		val msg2 = match msg { nil => "Expected '{{value}}' is not less than '{{expected}}'" _ => msg }
		throw Error { type: "AssertionError", msg: msg2 }
	}
}

/**
 * asserts that `value <= expected`. Returns `value` on success.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assertLessThanOrEqual = fn(value, expected, msg = nil):any {
	if (value <= expected) { value } else {
		val msg2 = match msg { nil => "Expected '{{value}}' is not less than or equal to '{{expected}}'" _ => msg }
		throw Error { type: "AssertionError", msg: msg2 }
	}
}

/**
 * asserts that `value > expected`. Returns `value` on success.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assertGreaterThan = fn(value, expected, msg = nil):any {
	if (value > expected) { value } else {
		val msg2 = match msg { nil => "Expected '{{value}}' is not greater than '{{expected}}'" _ => msg }
		throw Error { type: "AssertionError", msg: msg2 }
	}
}

/**
 * asserts that `value >= expected`. Returns `value` on success.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assertGreaterThanOrEqual = fn(value, expected, msg = nil):any {
	if (value >= expected) { value } else {
		val msg2 = match msg { nil => "Expected '{{value}}' is not greater than or equal to '{{expected}}'" _ => msg }
		throw Error { type: "AssertionError", msg: msg2 }
	}
}

/**
 * asserts that `value` is `nil`. Returns `value` on success.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assertNil = fn(value, msg = nil):any {
	if (value == nil) { value } else {
		val msg2 = match msg { nil => "Expected nil but got '{{value}}'" _ => msg }
		throw Error { type: "AssertionError", msg: msg2 }
	}
}

/**
 * asserts that `value` is not `nil`. Returns `value` on success.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val assertNotNil = fn(value, msg = nil):any {
	if (value != nil) { value } else {
		val msg2 = match msg { nil => "Expected non-nil" _ => msg }
		throw Error { type: "AssertionError", msg: msg2 }
	}
}

/**
 * unconditionally throws an `AssertionError` with an optional message.
 *
 * Useful as a catch-all in match arms or branches that should never be reached.
 */
@export
@throws('@struct(Error{type:AssertionError})')
val fail = fn(msg = nil) {
	val msg2 = match msg { nil => "Test failed!" _ => msg }
	throw Error { type: "AssertionError", msg: msg2 }
}

// Short aliases
@export val eq    = assertEqual
@export val lt    = assertLessThan
@export val lteq  = assertLessThanOrEqual
@export val gt    = assertGreaterThan
@export val gteq  = assertGreaterThanOrEqual
@export val throws = assertThrows
@export val ok    = assertTrue
@export val not   = assertFalse
