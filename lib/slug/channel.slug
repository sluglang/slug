var {*} = import(
	"slug.std",
)

@export
@returns('@chan')
foreign chan = fn(@num capacity = 0)

@export
@returns('nil')
foreign close = fn(@chan channel)

@export
var send = fn(@chan channel, payload) {
	select {
		send channel, payload /> fn(_) { channel }
	}
}

@export
var trySend = fn(@chan channel, payload) {
	select {
		send channel, payload /> fn(_) { channel }
		_
	}
}

@export
@throws('@struct(Error{type:TimeoutError})')
var recv = fn(@chan channel, @num timeout = 0) {
	select {
		recv channel
		after timeout /> fn(_) { throw Error{ type: "TimeoutError", data: {ms: timeout, channel: channel} } }
	}
}

@export
var tryRecv = fn(@chan channel) {
	select {
		recv channel
		_
	}
}

@export
@throws('@struct(Error{type:TimeoutError})')
var await = fn(@task handle, @num timeout = 0) {
	select {
		await handle
		after timeout /> fn(_) { throw Error{ type: "TimeoutError", data: {ms: timeout, handle: handle} } }
	}
}
