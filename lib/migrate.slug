/**
 * Slug Migrate — database schema migration tool
 *
 * Applies, rolls back, and reports on versioned SQL migration scripts.
 *
 * Usage:
 * ```bash
 * slug migrate [options] [up|down|status]
 * ```
 *
 * Commands:
 * - `up`       apply all pending migrations (default)
 * - `down`     roll back the most recent migration(s)
 * - `status`   show applied / pending / ineligible migrations
 *
 * Options:
 * - `-h, --help`      show this screen
 * - `-v, --version`   show version
 * - `--db`            database connection string (required)
 * - `--driver`        database driver: sqlite3 | mysql | postgres (default: sqlite3)
 * - `--env`           environment tag(s) to include; may be passed multiple times
 * - `--base`          migrations directory (default: db/migrations)
 * - `--step`          number of migrations to roll back with `down` (default: 1)
 */

val {*} = import(
  'slug.std',
  'slug.string',
  'slug.list',
  'slug.io.db',
)
val migrate    = import('slug.db.migration')
val { argsWith } = import('slug.cli')

// --- CLI spec ---

val spec = {
  name:    'migrate',
  version: '1.0.0',
  summary: '''
Slug database migration tool — apply, roll back, and inspect schema migrations

Commands
 up       apply all pending migrations (default)
 down     roll back the most recent migration(s)
 status   show applied / pending / ineligible migrations
''',
  alias: { d: 'driver' },
  required: ['db'],
  strict: false,
  defaults: {
    driver: 'sqlite3',
    base:   'db/migrations',
    step:   1,
  },
  types: {
    db:     'str',
    driver: 'str',
    env:    'str',
    base:   'str',
    step:   'num',
  },
  desc: {
    db:     'database connection string',
    driver: 'database driver: sqlite3 | mysql | postgres',
    env:    'environment tag(s) to include; may be passed multiple times',
    base:   'migrations directory',
    step:   'number of migrations to roll back with `down`',
  },
  positional: { min: 0, max: 1, name: 'command' },
}

// --- entrypoint ---

@main val main = fn(args = argm()) {
  val result = args /> argsWith(spec)

  match result {
    { action: :help }    => { println(result.text); import('slug.sys').exit(0) }
    { action: :version } => { println(result.text); import('slug.sys').exit(0) }
    { action: :error }   => {
      result.errors /> map(fn(e) { println(e.msg) })
      import('slug.sys').exit(1)
    }
    { ok: true, options, positional } => {
      val connectionString = options.db
      val driver           = match options.driver {
        ^MYSQL_DRIVER => MYSQL_DRIVER
        ^PGSQL_DRIVER => PGSQL_DRIVER
        _             => SQLITE_DRIVER
      }
      val base = options.base

      // --env may arrive as a single string or a list if passed multiple times
      val env = match options.env {
        nil       => []
        lst@[...] => lst
        v         => [v]
      }

      val step = options.step /> ifNil(1)

      val conn = connect(connectionString, driver)
      defer { close(conn) }

      val command = match positional {
        []         => 'up'
        [cmd, ...] => cmd
      }

      match command {
        'up'     => migrate.up(conn, env, base)
        'down'   => migrate.down(conn, step, base)
        'status' => migrate.status(conn, env, base)
        _ => {
          println(fmt('unknown command: {}', command))
          println(result.text)
          import('slug.sys').exit(1)
        }
      }
    }
  }
}
