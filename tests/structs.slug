var {*} = import(
    "slug.test"
)

val User = struct {
    name,
    @num age,
    active = true,
}

var u = User {
    name: "Slug",
    age: 42,
}

u.name /> assertEqual("Slug")
u.age /> assertEqual(42)
u.active /> assertEqual(true)

u = u copy { age: 43 }

u.age /> assertEqual(43)
u.active /> assertEqual(true)

var matched = false
match u {
    User { age: 43, name } => {
        matched = true
        name /> assertEqual("Slug")
    }
}

matched /> assertTrue()

var f1 = fn(v) { 'untyped' }
var f1 = fn(@struct v) { 'struct' }

f1(u) /> assertEqual('struct')

var f2 = fn(@struct v) { 'struct' }
var f2 = fn(@struct(User) v) { 'user' }

f2(u) /> assertEqual('user')
