var {*} = import(
    "slug.std",
    "slug.test",
)


var add = fn(b:num) {
    b + 255
}

var add = fn(b:bool) {
    !b
}

var add = fn(b:str) {
    b + " slug"
}

var add = fn(b:list) {
    b :+ 255
}

var add = fn(b:map) {
    put(b, "k", 255)
}

var add = fn(b:bytes) {
    b :+ 255
}

var add = fn(b:fn) {
    b() + 255
}


"hello" /> add /> assertEqual("hello slug")

false /> add /> assertEqual(true)

1 /> add /> assertEqual(256)

[] /> add /> assertEqual([255])

{} /> add /> len /> assertEqual(1)

0x"63ff00" /> add /> assertEqual(0x"63ff00ff")

fn() { 12 } /> add /> assertEqual(267)

