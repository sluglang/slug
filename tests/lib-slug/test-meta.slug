var {*} = import(
    "slug.meta",
    "slug.std",
    "slug.test",
)

/**
 * describe should surface docs from bindings.
 */
val docValue = 7

@custom val tagged = 1

var taggedInfo = describe(tagged)
taggedInfo[:type] /> assertEqual(:num)
taggedInfo[:docs] /> assertEqual("")
taggedInfo[:tags] /> assertEqual({"@custom": []})
taggedInfo[:details] /> assertEqual({})

describe(docValue)[:docs] /> assertEqual("describe should surface docs from bindings.")

var f = fn(name:str, count:num = 1) { count }
var fInfo = describe(f)
fInfo[:type] /> assertEqual(:fn)
fInfo[:details][:foreign] /> assertEqual(false)
fInfo[:details][:arityMin] /> assertEqual(1)
fInfo[:details][:arityMax] /> assertEqual(2)
fInfo[:tags] /> assertEqual({})

var params = fInfo[:details][:params]
params[0][:name] /> assertEqual("name")
params[0][:tags] /> assertEqual({"@str": []})
params[0][:hasDefault] /> assertEqual(false)
params[0][:vargs] /> assertEqual(false)
params[1][:name] /> assertEqual("count")
params[1][:tags] /> assertEqual({"@num": []})
params[1][:hasDefault] /> assertEqual(true)
params[1][:default] /> assertEqual("1")
params[1][:vargs] /> assertEqual(false)

val User = struct {
    name,
    @num age = 0,
}

var u = User {
    name: "Slug",
    age: 3,
}

var sInfo = describe(u)
sInfo[:type] /> assertEqual(:struct)
sInfo[:details][:structType] /> assertEqual(:User)
sInfo[:details][:fieldCount] /> assertEqual(2)

var fields = sInfo[:details][:fields]
fields[0][:name] /> assertEqual("name")
fields[0][:tags] /> assertEqual({})
fields[0][:hasDefault] /> assertEqual(false)
fields[1][:name] /> assertEqual("age")
fields[1][:tags] /> assertEqual({"@num": []})
fields[1][:hasDefault] /> assertEqual(true)
fields[1][:default] /> assertEqual("0")

var schemaInfo = describe(User)
schemaInfo[:type] /> assertEqual(:struct)
schemaInfo[:details][:structType] /> assertEqual(:User)
schemaInfo[:details][:fieldCount] /> assertEqual(2)

var schemaFields = schemaInfo[:details][:fields]
schemaFields[0][:name] /> assertEqual("name")
schemaFields[0][:tags] /> assertEqual({})
schemaFields[0][:hasDefault] /> assertEqual(false)
schemaFields[1][:name] /> assertEqual("age")
schemaFields[1][:tags] /> assertEqual({"@num": []})
schemaFields[1][:hasDefault] /> assertEqual(true)
schemaFields[1][:default] /> assertEqual("0")

var x = fn(a:num, ...args) {
	len(args)
}

var x = fn(a:str, ...args) {
	len(args)
}

var xInfo = describe(x)
xInfo.type /> assertEqual(:grp)
xInfo.details.groups /> len /> assertEqual(2)
