var {*} = import(
    "slug.string",
    "slug.std",
    "slug.test",
)

@test
var test_match_whole_value_binding = fn() {

	var tstVal = {k: "test"}
    var r = match tstVal {
        v @ {k: "test"} => v
        _               => "other"
    }

	r.k /> assertEqual("test")
}

@test
var test_match_case_returns_map_without_space_between_braces = fn() {
	val addTotals = fn(i) {
		match true {
			_ => {{c: i, d: i}}
		}
	}

	val r = addTotals(7)
	r.c /> assertEqual(7)
	r.d /> assertEqual(7)
}
